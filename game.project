[bootstrap]
main_collection = /main/main.collectionc
render = /render/custom.renderc

[script]
shared_state = 1

[display]
width = 1920
height = 1080
high_dpi = 1

[android]
input_method = HiddenInputField

[html5]
scale_mode = stretch
wasm_streaming = 1
show_fullscreen_button = 0
show_made_with_defold = 0

[project]
title = Galaxy
dependencies#0 = https://github.com/defold/extension-poki-sdk/archive/refs/heads/main.zip
dependencies#1 = https://github.com/defold/extension-websocket/archive/4.2.4.zip
dependencies#2 = https://github.com/heroiclabs/nakama-defold/archive/master.zip

[nakama]
host = 127.0.0.1
port = 7350
use_ssl = 0
server_key = defaultkey
