-- The screen shown while the game signs in. There's no login here: accounts
-- live on the website (fig.limited), which only lets logged-in, verified
-- players reach the game. This screen asks the website for a play token and
-- signs in to the chosen game server with it (main/network.lua M.start()),
-- then loads the saved progress (main/profile.lua): a player with a faction
-- on this server goes straight to the outpost; a new one picks a faction
-- first (main/faction_select).
--
-- If that fails, it says why and offers one button: "Log in" / "Choose a
-- server" (open the website) or "Retry".

local network = require("main.network")
local profile = require("main.profile")
local version = require("main.version")

local function set_status(self, text)
	gui.set_text(self.status_node, text or "")
end

-- Shows `label` on the button, which runs `action` when clicked; no label
-- hides it.
local function set_button(self, label, action)
	gui.set_enabled(self.button, label ~= nil)
	gui.set_enabled(self.button_label, label ~= nil)
	gui.set_text(self.button_label, label or "")
	self.button_action = action
end

local start

-- Leaves this screen for the game (outpost) or, for a new player, the
-- faction choice.
local function enter_game(self)
	set_status(self, "Loading your progress...")
	profile.load(function(ok, has_faction, err)
		if not ok then
			set_status(self, err or "Couldn't load your progress.")
			set_button(self, "Retry", start)
			return
		end
		self.active = false
		msg.post("#gui", "disable")
		if has_faction then
			network.connect()
			msg.post("outpost#gui", "show_outpost")
		else
			msg.post("faction_select#gui", "show_faction_select")
		end
	end)
end

-- The server runs a different release (mid-deploy, or this browser cached
-- an old copy of the game): the rules may not match, so ask for a reload
-- rather than risk changes being refused.
local function check_version(self)
	network.server_version(function(info, err)
		if not info then
			set_status(self, err or "Couldn't reach the server.")
			set_button(self, "Retry", start)
		elseif info.version ~= version.VERSION then
			set_status(self, "Galaxy has been updated - please reload the page.\n(game v" .. version.VERSION
				.. ", server v" .. tostring(info.version) .. ")")
			set_button(self, nil)
		else
			enter_game(self)
		end
	end)
end

start = function(self)
	set_button(self, nil)
	set_status(self, "Connecting...")
	network.start(function(ok, failure)
		if ok then
			check_version(self)
			return
		end
		set_status(self, failure.message)
		if failure.kind == "login" then
			set_button(self, "Log in", function() network.open_account(failure.url) end)
		elseif failure.kind == "choose" then
			set_button(self, "Choose a server", function() network.open_account(failure.url) end)
		else
			set_button(self, "Retry", start)
		end
	end)
end

function init(self)
	self.active = true
	msg.post(".", "acquire_input_focus")
	self.status_node = gui.get_node("status")
	self.button = gui.get_node("primary")
	self.button_label = gui.get_node("primary_label")
	gui.set_text(gui.get_node("heading"), "")
	gui.set_text(gui.get_node("info"), "")
	gui.set_text(gui.get_node("version"), "v" .. version.VERSION)
	start(self)
end

function on_input(self, action_id, action)
	if not self.active then
		return false
	end
	if action_id == hash("touch") and action.pressed and self.button_action
		and gui.is_enabled(self.button) and gui.pick_node(self.button, action.x, action.y) then
		self.button_action(self)
	end
	return action_id ~= nil -- keep other keys (flight controls) from leaking through
end
