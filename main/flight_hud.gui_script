-- Minimal flight HUD (plan.md §4's "Build flight mode" TODO) - the
-- current-speed readout, the docking prompt/countdown, a radar, and a
-- TARGET: text readout (no shields/on-screen reticle/nameplates yet). Same
-- "starts
-- disabled, hidden until told to show" pattern as main/faction_select.gui_script
-- and main/outpost.gui_script, except the thing enabling/hiding it is a
-- plain game object (main/player_ship.script's start_flight()/
-- complete_dock()) rather than another gui_script - flight has no
-- gui_script of its own to own this hand-off.
--
-- main/player_ship.script posts, every frame:
--  - "set_speed" - the ship's current speed (m/sec, see that script's
--    header comment on why it's not a real physics speed yet)
--  - "dock_prompt" - a text string ("Press [K] to dock" / "Docking in
--    N..." / nil to hide) while docking is possible or underway
--  - "jump_preset" - a text string ("PRESET: <system> [J]" / nil to hide)
--    once main/flight_map.gui's sector map arms a jump destination -
--    persists after the map closes, same as the source project's own
--    hud.gui_script "jump_preset_changed" indicator
--  - "target" - a text string ("TARGET: <faction>  <N>m" / "... (out of
--    range)" / "...  [FOLLOWING]" / nil to hide) for whatever TAB/X/C/Y
--    currently has locked (per direct instruction: "search superships for
--    all references to target. Implement what you find") - same
--    hide-when-nil convention as dock_prompt/jump_preset below
--  - "system_changed" - a text string ("SYSTEM: <name>") whenever the
--    player's current system changes (initial launch, or an FTL jump
--    landing - see player_ship.script's start_flight()/arrive_at_system()) -
--    same source-project hud.gui_script "system_changed" indicator, just
--    always left showing (no hide case - there's always a current system
--    while flying)
--  - "contacts" - { own_pos, range, contacts } for the radar below (per
--    direct instruction: "each ship has its own visible range... a radar
--    indicating all ships within visible range") - `range` is that
--    ship's own visual_range_m (NOT the longer sensor_range_m/"Dradis
--    Range"), `contacts` a list of { pos = vmath.vector3 } for every
--    other ship within it (always empty right now - no other ships exist
--    anywhere in this project yet, see that script's own comment on this
--    same block)
--  - "currency" - { tope, water, iron, hydrogen } (per direct instruction:
--    "show the amount of currency for each resource that the player has")
--    - same main/session.lua getters and "Name: N" text format
--    main/outpost.gui_script's own refresh_currency() already uses, just
--    read fresh every frame here instead of only on explicit changes -
--    nothing in flight can spend/earn any of these yet either (same "no
--    real mechanic wired up" status that script's own comment on Water/
--    Iron/Hydrogen already flags), so today these values just sit static
--    for the whole flight.
--  - "slot_states" - { states = { [slot_id] = { state = "live"/"cooldown"/"off", frac = 0..1 } } }
--    for every fitted slot, every frame - drives the bottom-left ship
--    diagram's per-slot live/cooldown markers (build_ship_diagram/
--    apply_slot_states below).
-- this gui_script just formats/shows/positions whatever it's given -
-- radar projection technique (flat world-fixed X/Z, doesn't rotate with
-- the ship's own heading) ported from the other local reference
-- project's own main/dradis.gui_script (§0 - mechanics, not creative
-- expression), simplified down to a flat 2-D dot (no height cue/pseudo-3D
-- dimming - there's nothing populating it yet to verify that against).

local RADAR_CENTER = vmath.vector3(1760, 150, 0)
local RADAR_RADIUS = 110 -- px, half of radar_panel's own 220x220 size in main/flight_hud.gui
local DOT_POOL_SIZE = 16
local DOT_SIZE = vmath.vector3(6, 6, 0)
local DOT_COLOR = vmath.vector4(0.9, 0.25, 0.25, 1.0)

local PROGRESS_SHOWN_S = 5

local PROGRESS_REASONS = {
	asteroid_analysed = "asteroids analysed",
	outpost_damage = "outpost damage",
	outpost_destroyed = "outpost destroyed",
	arrive_jump = "new system discovered",
	system_arrival = "new system discovered",
}

local function with_commas(n)
	local formatted = tostring(math.floor(n)):reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (formatted:gsub("^,", ""))
end

-- "+240 XP  (asteroids analysed)", plus a promotion line and a line per
-- completed assignment; nil if there's nothing to show.
local function progress_text(p)
	local lines = {}
	local assignment_xp = 0
	for _, c in pairs(p.completed or {}) do
		assignment_xp = assignment_xp + (c.xp or 0)
	end
	local earned = (p.xp_gained or 0) - assignment_xp
	if earned > 0 then
		table.insert(lines, "+" .. with_commas(earned) .. " XP  (" .. (PROGRESS_REASONS[p.reason] or "progress") .. ")")
	end
	for _, c in pairs(p.completed or {}) do
		table.insert(lines, "ASSIGNMENT COMPLETE: " .. tostring(c.name) .. "  +" .. with_commas(c.xp or 0) .. " XP  +"
			.. with_commas(c.tope or 0) .. " Tope")
	end
	if p.level and p.level_before and p.level > p.level_before then
		table.insert(lines, "PROMOTED: " .. tostring(p.rank) .. "  (level " .. p.level .. ")")
	end
	return #lines > 0 and table.concat(lines, "\n") or nil
end

-- Target marker colours by relation to the player (BSGO: red enemies,
-- blue friendlies) and the targeted object's panel in the same colour.
local RELATION_COLORS = {
	enemy = vmath.vector4(1.0, 0.32, 0.26, 1.0),
	friendly = vmath.vector4(0.35, 0.72, 1.0, 1.0),
	neutral = vmath.vector4(0.85, 0.85, 0.82, 1.0),
}
local BRACKET_THICKNESS = 3
local BRACKET_PADDING = 8 -- px between the object and its bracket

-- The bracket: an L at each corner (two thin boxes), built once.
local function create_marker(self)
	self.bracket = {}
	for i = 1, 8 do
		local node = gui.new_box_node(vmath.vector3(), vmath.vector3(1, 1, 0))
		gui.set_pivot(node, gui.PIVOT_CENTER)
		gui.set_enabled(node, false)
		self.bracket[i] = node
	end
	self.marker_arrow = gui.new_text_node(vmath.vector3(), "")
	gui.set_font(self.marker_arrow, "default_font")
	gui.set_pivot(self.marker_arrow, gui.PIVOT_CENTER)
	gui.set_scale(self.marker_arrow, vmath.vector3(2.2, 2.2, 1))
	gui.set_enabled(self.marker_arrow, false)
end

local function update_marker(self, m)
	local color = RELATION_COLORS[m.relation] or RELATION_COLORS.neutral
	local show_bracket = m.visible and m.on_screen
	for _, node in ipairs(self.bracket) do
		gui.set_enabled(node, show_bracket)
	end
	gui.set_enabled(self.marker_arrow, m.visible and not m.on_screen or false)
	if show_bracket then
		local half = m.size + BRACKET_PADDING
		local arm = math.max(8, half * 0.45)
		local i = 0
		for _, sx in ipairs({ -1, 1 }) do
			for _, sy in ipairs({ -1, 1 }) do
				i = i + 1
				local h, v = self.bracket[i], self.bracket[i + 4]
				gui.set_position(h, vmath.vector3(m.x + sx * (half - arm / 2), m.y + sy * half, 0))
				gui.set_size(h, vmath.vector3(arm, BRACKET_THICKNESS, 0))
				gui.set_position(v, vmath.vector3(m.x + sx * half, m.y + sy * (half - arm / 2), 0))
				gui.set_size(v, vmath.vector3(BRACKET_THICKNESS, arm, 0))
				gui.set_color(h, color)
				gui.set_color(v, color)
			end
		end
	elseif m.visible then
		local arrow
		if math.abs(m.dx) > math.abs(m.dy) then
			arrow = m.dx > 0 and ">" or "<"
		else
			arrow = m.dy > 0 and "^" or "v"
		end
		gui.set_text(self.marker_arrow, arrow)
		gui.set_position(self.marker_arrow, vmath.vector3(m.x, m.y, 0))
		gui.set_color(self.marker_arrow, color)
	end
end

-- Bottom-left ship diagram (per direct instruction: "the top down
-- view of the ship that is shown on the fittings page needs to be
-- rendered at the bottom of the screen when the ship is flying with an
-- indicator to which components are live and or cool down mode. this
-- diagram also needs to show the key to press for that slot") - a scaled
-- copy of main/outpost.gui_script's fitting view: the same top-down
-- silhouette (main/images/topdown/) with one octagon marker per
-- main/data/ships.lua slot_position, the fitted module's icon
-- (main/images/icons.atlas) on it, and that slot's own key ("Shift+1" /
-- "Key 3", session.slot_hotkey) under it. Where the fitting page colors
-- markers filled/empty, this one shows STATE - green = live, amber =
-- cooldown (with a thin bar under the marker draining as a weapon
-- reloads), grey = off/standby/empty - driven by player_ship.script's
-- every-frame "slot_states" message below.
local session = require("main.session")
local ships = require("main.data.ships")

-- slot_positions' {x, y} are screen-pixel offsets in the fitting page's
-- own 440x640 ship_visual space (centre origin, +y = bow); DIAGRAM_SCALE
-- shrinks that whole space onto diagram_panel (main/flight_hud.gui), so
-- the marker/label layout stays proportional to the fitting page. That
-- panel sits in the bottom-left corner of the screen (moved there from
-- the bottom-centre spot it started on), close to the bottom edge but
-- clear of it. Grew from 0.62 when the slot markers doubled in size - the
-- panel and the slot spacing had to grow with them, but stayed small
-- enough to fit under the currency readouts.
local DIAGRAM_CENTER = vmath.vector3(210, 335, 0)
local DIAGRAM_SCALE = 0.8
local SLOT_TYPE_BY_PREFIX = { W = "weapon", C = "computer", E = "engine", H = "hull" }
local SLOT_EMPTY_ICON = { weapon = "Octagon W", computer = "Octagon C", engine = "Octagon E", hull = "Octagon H" }
local ICON_TEXTURE = "icons"
-- Twice the size they started at (per direct instruction: the slot
-- indicators were too small to read in flight). 60px is as large as they
-- can go without colliding: the tightest slot spacing is 90 units = 72px
-- at DIAGRAM_SCALE above, leaving the same 12px gap between markers that
-- the fitting page's own 74px-on-90px markers have.
local MARKER_SIZE = vmath.vector3(60, 60, 0)
-- The module icon is drawn smaller than its marker box, unlike the fitting
-- page's face-covering icons: the marker's STATE colour has to stay
-- visible as a ring around it.
local ICON_SIZE = vmath.vector3(MARKER_SIZE.x * 0.82, MARKER_SIZE.y * 0.82, 0)
-- The key label sits snug under the marker - the slot row below is only
-- 12px away at the tightest spots.
local KEY_LABEL_OFFSET_Y = -34
local KEY_LABEL_SCALE = vmath.vector3(0.65, 0.65, 1)
local HOTKEY_LABEL_COLOR = vmath.vector4(1.0, 0.85, 0.35, 1.0)
-- The reload/scan progress bar is drawn INSIDE the marker, across the
-- bottom of the icon (there's no spare room below the marker now that the
-- key label is snug against it).
local COOLDOWN_BAR_OFFSET_Y = -21
local COOLDOWN_BAR_THICKNESS = 7
local COOLDOWN_BAR_COLOR = vmath.vector4(0.95, 0.72, 0.2, 1.0)
-- Marker box colour = the slot's STATE (see the header comment above):
-- live (switched-on weapon ready to fire / passive module / active
-- module mid-effect), cooldown (weapon reloading), off (switched off,
-- standby, or empty slot), locked (advanced-only slot on a non-advanced
-- ship - same greyed-not-hidden rule as the fitting page).
local STATE_COLORS = {
	live = vmath.vector4(0.3, 0.85, 0.45, 0.85),
	cooldown = vmath.vector4(0.95, 0.72, 0.2, 0.85),
	off = vmath.vector4(0.35, 0.38, 0.42, 0.65),
	locked = vmath.vector4(0.18, 0.19, 0.2, 0.45),
}
local ICON_STATE_COLORS = {
	live = vmath.vector4(1, 1, 1, 1),
	cooldown = vmath.vector4(1, 0.9, 0.7, 1),
	off = vmath.vector4(0.5, 0.5, 0.5, 0.5),
	locked = vmath.vector4(0.5, 0.5, 0.5, 0.5),
}

-- Copy of main/outpost.gui_script's octagon marker node (8-vertex pie
-- rotated 22.5 degrees so flat edges - not vertices - sit on the four
-- sides). The API names below are correct as-is: the fill-angle setter
-- is gui.set_fill_angle and the bounds enum is gui.PIEBOUNDS_ELLIPSE
-- (a guessed gui.set_pie_fill_angle throws at runtime).
local function new_octagon_node(pos, size)
	local node = gui.new_pie_node(pos, size)
	gui.set_perimeter_vertices(node, 8)
	gui.set_outer_bounds(node, gui.PIEBOUNDS_ELLIPSE)
	gui.set_fill_angle(node, 360)
	gui.set_inner_radius(node, 0)
	gui.set_rotation(node, vmath.vector3(0, 0, 22.5))
	return node
end

-- Same top-down silhouette loader as outpost.gui_script's
-- show_ship_silhouette (tools/render_topdown_silhouettes.py output,
-- bundled via game.project's custom_resources) - but into a runtime box
-- node at the diagram's scaled size, since this scene has no authored
-- ship_visual node of its own.
local function show_ship_silhouette(self, ship)
	local skin = ship and ship.faction_skins and ship.faction_skins[session.get_faction()]
	local name = skin and skin.model and skin.model:match("([^/]+)%.model$")
	if not name or name == self.silhouette_name then
		return
	end
	local png = sys.load_resource("/main/images/topdown/" .. name .. ".png")
	local img = png and image.load(png, { premultiply_alpha = true })
	if not img then
		print("[flight_hud] no top-down silhouette for " .. name)
		return
	end
	local texture_id = "diagram_silhouette_" .. name
	if not gui.new_texture(texture_id, img.width, img.height, img.type, img.buffer, false) then
		return
	end
	if self.diagram_silhouette then
		gui.delete_node(self.diagram_silhouette)
	end
	self.diagram_silhouette = gui.new_box_node(DIAGRAM_CENTER,
		vmath.vector3(img.width * DIAGRAM_SCALE, img.height * DIAGRAM_SCALE, 0))
	gui.set_pivot(self.diagram_silhouette, gui.PIVOT_CENTER)
	-- MANUAL (not AUTO, which would snap the node back to the texture's
	-- own 440x640 pixels) so it stays at the scaled size above.
	gui.set_size_mode(self.diagram_silhouette, gui.SIZE_MODE_MANUAL)
	gui.set_texture(self.diagram_silhouette, texture_id)
	if self.silhouette_name then
		gui.delete_texture("diagram_silhouette_" .. self.silhouette_name)
	end
	self.silhouette_name = name
end

-- Applies player_ship.script's "slot_states" payload to the markers built
-- by build_ship_diagram below: state -> marker/icon colour, and the
-- cooldown bar's width is the reload's remaining fraction. Defined
-- before build_ship_diagram because it calls this once at the end.
local function apply_slot_states(self, states)
	for slot_id, marker in pairs(self.diagram_markers or {}) do
		local s = states and states[slot_id]
		local state = s and s.state or "off"
		if marker.locked then
			state = "locked"
		end
		gui.set_color(marker.box, STATE_COLORS[state] or STATE_COLORS.off)
		gui.set_color(marker.icon, ICON_STATE_COLORS[state] or ICON_STATE_COLORS.off)
		local frac = s and s.frac or 0
		if state == "cooldown" and frac > 0 then
			gui.set_enabled(marker.cooldown_bar, true)
			gui.set_size(marker.cooldown_bar,
				vmath.vector3(ICON_SIZE.x * math.min(1, frac), COOLDOWN_BAR_THICKNESS, 0))
		else
			gui.set_enabled(marker.cooldown_bar, false)
		end
	end
end

-- (Re)builds the diagram for whatever the player is flying now - called
-- on every "show_flight_hud" (the loadout can change between flights in
-- the outpost's Fitting tab), no-op-ing the silhouette when the ship
-- didn't change. Marker layout is the fitting page's build_markers
-- reduced to what matters in flight: box + icon + key label + the
-- cooldown bar, with no hover/drag/level-badge machinery.
local function build_ship_diagram(self)
	for _, marker in pairs(self.diagram_markers or {}) do
		gui.delete_node(marker.box)
		gui.delete_node(marker.icon)
		gui.delete_node(marker.key_label)
		gui.delete_node(marker.cooldown_bar)
	end
	self.diagram_markers = {}
	local ship_id = session.get_ship_id()
	local ship = ship_id and ships.SHIPS[ship_id]
	if not ship then
		return
	end
	show_ship_silhouette(self, ship)
	-- Locked = past the ship's effective component count for that slot's
	-- type (advanced hulls unlock ship.advanced's extra slots), same rule
	-- as outpost.gui_script's build_markers.
	local counts = (session.is_ship_advanced(ship_id) and ship.advanced) or ship.components or {}
	for slot_id, offset in pairs(ship.slot_positions or {}) do
		local prefix, number = slot_id:match("^(%a)(%d+)$")
		local slot_total = prefix and counts[prefix]
		local locked = slot_total ~= nil and tonumber(number) > slot_total
		local slot_type = prefix and SLOT_TYPE_BY_PREFIX[prefix]
		local module = session.module_in_slot(slot_id)
		local pos = vmath.vector3(
			DIAGRAM_CENTER.x + offset.x * DIAGRAM_SCALE,
			DIAGRAM_CENTER.y + offset.y * DIAGRAM_SCALE, 0)

		local box = new_octagon_node(pos, MARKER_SIZE)
		gui.set_pivot(box, gui.PIVOT_CENTER)

		-- ICON_SIZE, smaller than the marker box (see its own comment).
		local icon = gui.new_box_node(pos, ICON_SIZE)
		gui.set_pivot(icon, gui.PIVOT_CENTER)
		gui.set_texture(icon, ICON_TEXTURE)
		-- forced MANUAL so the high-res "Octagon *" icons render at exactly
		-- MARKER_SIZE (AUTO inflates the node to the image's own pixels),
		-- same as outpost.gui_script's marker icons.
		gui.set_size_mode(icon, gui.SIZE_MODE_MANUAL)
		local icon_id = (module and module.icon) or (slot_type and SLOT_EMPTY_ICON[slot_type])
		if icon_id then
			gui.play_flipbook(icon, icon_id)
		end

		local cooldown_bar = gui.new_box_node(
			vmath.vector3(pos.x, pos.y + COOLDOWN_BAR_OFFSET_Y, 0),
			vmath.vector3(ICON_SIZE.x, COOLDOWN_BAR_THICKNESS, 0))
		gui.set_pivot(cooldown_bar, gui.PIVOT_CENTER)
		gui.set_color(cooldown_bar, COOLDOWN_BAR_COLOR)
		gui.set_enabled(cooldown_bar, false)

		-- The key that uses this slot in flight, same wording as the
		-- fitting page's markers: "Shift+n" for weapons, "n" for active
		-- modules; blank for passive/empty/locked slots.
		local key = module and session.slot_hotkey(ship_id, slot_id)
		local key_text = ""
		if key and slot_type == "weapon" then
			key_text = "Shift+" .. key
		elseif key and module.behavior == "active" then
			key_text = "Key " .. key
		end
		local key_label = gui.new_text_node(
			vmath.vector3(pos.x, pos.y + KEY_LABEL_OFFSET_Y, 0), key_text)
		gui.set_pivot(key_label, gui.PIVOT_CENTER)
		gui.set_font(key_label, "default_font")
		gui.set_color(key_label, HOTKEY_LABEL_COLOR)
		gui.set_scale(key_label, KEY_LABEL_SCALE)

		self.diagram_markers[slot_id] = {
			box = box, icon = icon, key_label = key_label, cooldown_bar = cooldown_bar,
			locked = locked,
		}
	end
	apply_slot_states(self) -- everything starts grey; player_ship refreshes it every frame
end

function init(self)
	self.speed_node = gui.get_node("speed_value")
	self.dock_prompt_node = gui.get_node("dock_prompt")
	self.target_text_node = gui.get_node("target_text")
	self.jump_preset_node = gui.get_node("jump_preset")
	self.system_name_node = gui.get_node("system_name")
	self.scan_status_node = gui.get_node("scan_status")
	gui.set_enabled(self.scan_status_node, false)
	create_marker(self)
	self.hotkeys_node = gui.get_node("hotkeys")
	gui.set_enabled(self.hotkeys_node, false)
	self.progress_node = gui.get_node("progress_toast")
	gui.set_enabled(self.progress_node, false)
	self.progress_generation = 0
	self.tope_node = gui.get_node("tope_value")
	self.water_node = gui.get_node("water_value")
	self.iron_node = gui.get_node("iron_value")
	self.hydrogen_node = gui.get_node("hydrogen_value")
	self.radar_range_node = gui.get_node("radar_range")
	self.radar_range_m = nil

	-- Pool created once, just repositioned/shown-or-hidden per "contacts"
	-- message (same pooling reasoning as the reference project's own
	-- dot_pool - avoids create/destroy churn every frame).
	self.dot_pool = {}
	for _ = 1, DOT_POOL_SIZE do
		local node = gui.new_box_node(RADAR_CENTER, DOT_SIZE)
		gui.set_pivot(node, gui.PIVOT_CENTER)
		gui.set_color(node, DOT_COLOR)
		gui.set_enabled(node, false)
		table.insert(self.dot_pool, node)
	end

	msg.post("#gui", "disable")
end

-- Projects a contact's world-space X/Z offset from the player onto the
-- flat radar - world-fixed (not rotating with the ship's own heading,
-- same convention the reference project's own project() uses). Contacts
-- are only ever sent within `range` in the first place (player_ship.script
-- filters that), so the edge-clamp below is just a safety margin against
-- float error, not a real "friendly past range" case like the reference
-- has (no faction-based always-shown exception here).
local function project(dx, dz, range)
	local px, py = dx * (RADAR_RADIUS / range), -dz * (RADAR_RADIUS / range)
	local len = math.sqrt(px * px + py * py)
	if len > RADAR_RADIUS then
		px, py = px / len * RADAR_RADIUS, py / len * RADAR_RADIUS
	end
	return px, py
end

local function refresh_radar(self, message)
	local range = message.range or 1
	if range ~= self.radar_range_m then
		self.radar_range_m = range
		gui.set_text(self.radar_range_node, string.format("%.0f m", range))
	end
	local own_pos = message.own_pos
	local contacts = message.contacts or {}
	for i, node in ipairs(self.dot_pool) do
		local c = contacts[i]
		if not c then
			gui.set_enabled(node, false)
		else
			local px, py = project(c.pos.x - own_pos.x, c.pos.z - own_pos.z, range)
			gui.set_position(node, vmath.vector3(RADAR_CENTER.x + px, RADAR_CENTER.y + py, 0))
			gui.set_enabled(node, true)
		end
	end
end

-- Shows `text` in the progress/reward toast for a few seconds (XP,
-- promotions, completed assignments, mined resources). A newer message
-- replaces an older one rather than the older message's timer hiding it.
local function show_toast(self, text)
	if not text then
		return
	end
	self.progress_generation = self.progress_generation + 1
	local generation = self.progress_generation
	gui.set_text(self.progress_node, text)
	gui.set_enabled(self.progress_node, true)
	timer.delay(PROGRESS_SHOWN_S, false, function()
		if generation == self.progress_generation then
			gui.set_enabled(self.progress_node, false)
		end
	end)
end

function on_message(self, message_id, message)
	if message_id == hash("show_flight_hud") then
		msg.post("#gui", "enable")
		build_ship_diagram(self)
	elseif message_id == hash("hide_flight_hud") then
		msg.post("#gui", "disable")
	elseif message_id == hash("set_speed") then
		gui.set_text(self.speed_node, string.format("%.0f m/s", message.speed))
	elseif message_id == hash("dock_prompt") then
		gui.set_enabled(self.dock_prompt_node, message.text ~= nil)
		if message.text then
			gui.set_text(self.dock_prompt_node, message.text)
		end
	elseif message_id == hash("hotkeys") then
		-- weapon (Shift+n) and active module (n) keys, from player_ship.script
		gui.set_enabled(self.hotkeys_node, message.text ~= nil and message.text ~= "")
		gui.set_text(self.hotkeys_node, message.text or "")
	elseif message_id == hash("progress") then
		-- XP / promotion / assignment rewards from the server
		-- (main/network.lua report_progress), shown for a few seconds.
		show_toast(self, progress_text(message))
	elseif message_id == hash("resource") then
		-- A resource mined from an asteroid, credited to the player whose
		-- final shot depleted it (main/network.lua report_resource).
		show_toast(self, "+" .. with_commas(message.amount or 0) .. " " .. tostring(message.resource):upper() .. "  (mined)")
	elseif message_id == hash("scan_status") then
		-- Asteroid Analyser progress/result (main/asteroid_hub.script), nil hides
		gui.set_enabled(self.scan_status_node, message.text ~= nil)
		if message.text then
			gui.set_text(self.scan_status_node, message.text)
		end
	elseif message_id == hash("jump_preset") then
		-- Persistent readout of main/player_ship.script's own
		-- self.jump_preset_system (set by main/flight_map.gui_script
		-- selecting a reachable system) - stays visible after the map
		-- closes, same as the source project's own hud.gui_script
		-- "jump_preset_changed" indicator.
		gui.set_enabled(self.jump_preset_node, message.text ~= nil)
		if message.text then
			gui.set_text(self.jump_preset_node, message.text)
		end
	elseif message_id == hash("target") then
		-- main/player_ship.script's TAB/X/C/T/Y targeting (per direct
		-- instruction: "search superships for all references to target.
		-- Implement what you find") - same hide-when-nil convention
		-- dock_prompt/jump_preset above already use.
		gui.set_enabled(self.target_text_node, message.text ~= nil)
		if message.text then
			gui.set_text(self.target_text_node, message.text)
			gui.set_color(self.target_text_node, RELATION_COLORS[message.relation] or RELATION_COLORS.neutral)
		end
	elseif message_id == hash("target_marker") then
		-- player_ship.script, every frame: bracket around the target, or an
		-- arrow at the screen edge towards it
		update_marker(self, message)
	elseif message_id == hash("system_changed") then
		gui.set_text(self.system_name_node, message.text)
	elseif message_id == hash("currency") then
		gui.set_text(self.tope_node, "Tope: " .. message.tope)
		gui.set_text(self.water_node, "Water: " .. message.water)
		gui.set_text(self.iron_node, "Iron: " .. message.iron)
		gui.set_text(self.hydrogen_node, "Hydrogen: " .. message.hydrogen)
	elseif message_id == hash("contacts") then
		refresh_radar(self, message)
	elseif message_id == hash("slot_states") then
		-- player_ship.script, every frame: live/cooldown/off per fitted
		-- slot for the ship diagram.
		apply_slot_states(self, message.states)
	end
end
