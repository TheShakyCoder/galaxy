-- Minimal flight HUD (plan.md §4's "Build flight mode" TODO) - the
-- current-speed readout, the ship's own Power/Hull readouts, the docking
-- prompt/countdown, a circular radar scope, and a TARGET: text readout (no
-- shields/on-screen reticle/nameplates yet). Same
-- "starts
-- disabled, hidden until told to show" pattern as main/faction_select.gui_script
-- and main/outpost.gui_script, except the thing enabling/hiding it is a
-- plain game object (main/player_ship.script's start_flight()/
-- complete_dock()) rather than another gui_script - flight has no
-- gui_script of its own to own this hand-off.
--
-- main/player_ship.script posts, every frame:
--  - "set_speed" - the ship's current speed (m/sec, see that script's
--    header comment on why it's not a real physics speed yet)
--  - "dock_prompt" - a text string ("Press [K] to dock" / "Docking in
--    N..." / nil to hide) while docking is possible or underway
--  - "jump_preset" - a text string ("PRESET: <system> [J]" / nil to hide)
--    once main/flight_map.gui's sector map arms a jump destination -
--    persists after the map closes, same as the source project's own
--    hud.gui_script "jump_preset_changed" indicator
--  - "target" - a text string ("TARGET: <faction>  <N>m" / "... (out of
--    range)" / "...  [FOLLOWING]" / nil to hide) for whatever TAB/X/C/Y
--    currently has locked (per direct instruction: "search superships for
--    all references to target. Implement what you find") - same
--    hide-when-nil convention as dock_prompt/jump_preset below
--  - "system_changed" - a text string ("SYSTEM: <name>") whenever the
--    player's current system changes (initial launch, or an FTL jump
--    landing - see player_ship.script's start_flight()/arrive_at_system()) -
--    same source-project hud.gui_script "system_changed" indicator, just
--    always left showing (no hide case - there's always a current system
--    while flying)
--  - "contacts" - { own_pos, heading, range, target_id, contacts, asteroids,
--    outposts } for the radar below (per direct instruction: "each ship has its
--    own visible range... a radar indicating all ships within visible range",
--    and "on the radar show asteroids as semi transparent points") - `range` is
--    that ship's own sensor_range_m (the longer of the two range stats in
--    main/data/ships.lua; per direct instruction "the radar should extend to
--    the ships sensor range", it used to be the shorter visual_range_m),
--    `contacts` a list of { pos, id } for every other ship within it (always
--    empty right now - no other ships exist anywhere in this project yet, see
--    that script's own comment on this same block) and `asteroids` the same
--    for every spawned rock of the system that is in range
--    (main/asteroid_registry.lua), plotted as the dim semi-transparent pool
--    rather than as contacts, and `outposts` one entry per standing outpost of
--    the system in range ({ pos, relation, id }) for the outpost pool (per
--    direct instruction: "add outposts"). Each blip's `id` is the same one the
--    targeting code knows it by (a ship's user_id, "asteroid:<index>" or
--    "outpost:<faction>"), and `target_id` is the currently selected target's
--    own id (or nil), so whichever blip matches draws highlighted (per direct
--    instruction: "if the selected target is shown in the radar, highlight it
--    in the radar"). `heading` is the hull's own bow direction
--    flattened onto the world X/Z plane (unit length), which is what the scope
--    is aimed by - see refresh_radar
--  - "currency" - { tope, water, iron, hydrogen } (per direct instruction:
--    "show the amount of currency for each resource that the player has")
--    - same main/session.lua getters and "Name: N" text format
--    main/outpost.gui_script's own refresh_currency() already uses, just
--    read fresh every frame here instead of only on explicit changes -
--    nothing in flight can spend/earn any of these yet either (same "no
--    real mechanic wired up" status that script's own comment on Water/
--    Iron/Hydrogen already flags), so today these values just sit static
--    for the whole flight.
--  - "ship_status" - { power, power_max, hull, hull_max, x, y, z } for the
--    Power and Hull readouts (per direct instruction: "while in flight show the
--    ship power and hull points") and the X/Y/Z coordinate line under the scope
--    ("show x/y/z coordinates below radar") - the active ship's own stats
--    (session.ship_stat, so an advanced tier's overrides count) and its own
--    world position. Nothing drains or damages either stat yet (no combat), so
--    both simply read full today.
--  - "slot_states" - { states = { [slot_id] = { state = "live"/"cooldown"/"off", frac = 0..1 } } }
--    for every fitted slot, every frame - drives the bottom-left ship
--    diagram's per-slot live/cooldown markers (build_ship_diagram/
--    apply_slot_states below).
-- this gui_script just formats/shows/positions whatever it's given -
--
-- While flying, the ship diagram's slot markers are also interactive (per
-- direct instruction: "a weapon or component can be activated or
-- deactivated by clicking the component icon in the gui" and "hovering
-- over the icon will show the keystroke to activate it with the keyboard
-- (modify keys should be indicated with an icon before the key)"): clicking
-- a marker posts "slot_click" to main/player_ship.script, which toggles the
-- weapon / runs the active module exactly as that slot's key does; hovering
-- shows a tooltip with the fitted module's name and its key, with the Shift
-- modifier drawn as the icons.atlas "key_shift" icon before the number
-- rather than spelled out as "Shift+". Input focus is taken while the HUD
-- is shown and returned when it hides (on_message below), so a click only
-- reaches these markers during flight - and only clicks that land on a
-- marker are consumed, leaving every other click for player_ship.script's
-- own click-to-target.
--
-- radar maths (flat X/Z dots, no height cue or pseudo-3D dimming) is ported
-- from the other local reference project's own main/dradis.gui_script (§0 -
-- mechanics, not creative expression), simplified down to a flat 2-D dot.
-- Unlike that one, the scope is drawn SHIP-RELATIVE rather than world-fixed
-- (per direct instruction: "items on the radar need to be shown relative to
-- the direction of the ship and not relative to the grid coordinates"): the
-- ship's own heading is always UP on the scope and whatever is off its
-- starboard side draws to the right, so the display turns with the hull
-- instead of with the world grid. What it is drawn onto is a circular
-- warship-style scope with a rotating sweep (see the RADAR_* constants).

local RADAR_CENTER = vmath.vector3(1760, 150, 0)
local RADAR_RADIUS = 110 -- px, half of radar_panel's own 220x220 size in main/flight_hud.gui
local DOT_POOL_SIZE = 16
local DOT_SIZE = vmath.vector3(6, 6, 0)
local DOT_COLOR = vmath.vector4(0.9, 0.25, 0.25, 1.0)

-- Asteroid blips on the same scope (per direct instruction: "on the radar show
-- asteroids as semi transparent points") - a second, smaller pool drawn in a
-- dim semi-transparent slate, so a rock reads as scenery rather than as a
-- contact. Same pooling as the ship contacts above, and deliberately created
-- BEFORE that pool so contacts always draw on top of rocks. Sized for what can
-- actually be in range at once: the radar now spans the active ship's own
-- sensor_range_m (main/data/ships.lua) - 2,000-4,000 m - which reaches right
-- across a whole system's field (main/data/asteroids.lua: 50 rocks in a
-- default 600 m ball, 100 across a home system's own 5,000 m one), so the pool
-- is sized for the largest field a system can spawn - if more are somehow in
-- range, the extras simply don't plot (a node-budget choice, not a rule).
local ASTEROID_POOL_SIZE = 100
local ASTEROID_DOT_SIZE = vmath.vector3(5, 5, 0)
local ASTEROID_DOT_COLOR = vmath.vector4(0.62, 0.66, 0.72, 0.4)

-- Outposts (per direct instruction: "add outposts"): a third pool, drawn ON TOP
-- of the rocks but under ship contacts, in the same friendly/enemy colours the
-- target brackets already use (RELATION_COLORS below) so a friendly outpost
-- reads like a friendly ship. Two factions can have one outpost each in a
-- system, so the pool only needs headroom, not a crowd.
local OUTPOST_POOL_SIZE = 4
local OUTPOST_DOT_SIZE = vmath.vector3(7, 7, 0)

-- The selected target's own blip (per direct instruction: "if the selected
-- target is shown in the radar, highlight it in the radar"): the "contacts"
-- message carries every blip's own id and the target's, so whichever one
-- matches is drawn larger and in a bright amber instead of its pool's own
-- colour (see refresh_radar). Deliberately not relation-coloured like the
-- target brackets - the brackets already say friend or foe, and on the scope
-- the point is simply "this is the one you have selected".
local RADAR_TARGET_COLOR = vmath.vector4(1.0, 0.92, 0.35, 1.0)
local RADAR_TARGET_SCALE = 1.8

-- The player's own position readout under the scope (per direct instruction:
-- "show x/y/z coordinates below radar") - smaller than the other readouts so a
-- six-figure coordinate still fits the width.
local POSITION_TEXT_SCALE = vmath.vector3(0.6, 0.6, 1)

-- Heading marker (per direct instruction): the ship itself, at the centre of
-- the scope. A 3-vertex pie is an equilateral triangle with one vertex at 0
-- degrees (3 o'clock - see new_octagon_node's own note in
-- main/outpost.gui_script), so rotating it a quarter turn stands that vertex up
-- - which is the hull's heading, the scope being ship-relative (refresh_radar).
local RADAR_HEADING_RADIUS = 11
local RADAR_HEADING_COLOR = vmath.vector4(0.85, 1.0, 0.9, 0.95)
local RADAR_HEADING_ROTATION = 90

-- Circular scope (per direct instruction: the radar should read as a warship's
-- circular radar screen rather than a square panel with dots on it): a filled
-- disc, a bright outer ring, two range rings and cross-hairs - all built once
-- in init() as native TYPE_PIE/BOX nodes (no image asset, same technique
-- main/outpost.gui_script's octagon markers use) - plus a sweep wedge and a
-- bright leading-edge line that rotate together every frame in update(). A pie
-- node's `size` is its bounding box, so radius R means size 2R (RADAR_RADIUS
-- above is already that half-size).
local RADAR_SCOPE_RADIUS = 104 -- px: just inside the outer ring, which sits on RADAR_RADIUS
local RADAR_RING_WIDTH = 6
local RADAR_SCOPE_VERTS = 64 -- smooth circle, not a faceted polygon
local RADAR_SCOPE_COLOR = vmath.vector4(0.03, 0.15, 0.08, 0.8) -- the scope face
local RADAR_RING_COLOR = vmath.vector4(0.3, 0.95, 0.5, 0.9) -- outer ring + sweep line
local RADAR_GRID_COLOR = vmath.vector4(0.25, 0.65, 0.4, 0.5) -- range rings + cross-hairs
local RADAR_SWEEP_COLOR = vmath.vector4(0.35, 1.0, 0.55, 0.18) -- the fading trail behind the line
local RADAR_SWEEP_ARC_DEG = 60
local RADAR_SWEEP_PERIOD_S = 3 -- one full revolution
local RADAR_SWEEP_DEG_PER_SEC = 360 / RADAR_SWEEP_PERIOD_S

local PROGRESS_SHOWN_S = 5

local PROGRESS_REASONS = {
	asteroid_analysed = "asteroids analysed",
	outpost_damage = "outpost damage",
	outpost_destroyed = "outpost destroyed",
	arrive_jump = "new system discovered",
	system_arrival = "new system discovered",
}

local function with_commas(n)
	local formatted = tostring(math.floor(n)):reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (formatted:gsub("^,", ""))
end

-- "+240 XP  (asteroids analysed)", plus a promotion line and a line per
-- completed assignment; nil if there's nothing to show.
local function progress_text(p)
	local lines = {}
	local assignment_xp = 0
	for _, c in pairs(p.completed or {}) do
		assignment_xp = assignment_xp + (c.xp or 0)
	end
	local earned = (p.xp_gained or 0) - assignment_xp
	if earned > 0 then
		table.insert(lines, "+" .. with_commas(earned) .. " XP  (" .. (PROGRESS_REASONS[p.reason] or "progress") .. ")")
	end
	for _, c in pairs(p.completed or {}) do
		table.insert(lines, "ASSIGNMENT COMPLETE: " .. tostring(c.name) .. "  +" .. with_commas(c.xp or 0) .. " XP  +"
			.. with_commas(c.tope or 0) .. " Tope")
	end
	if p.level and p.level_before and p.level > p.level_before then
		table.insert(lines, "PROMOTED: " .. tostring(p.rank) .. "  (level " .. p.level .. ")")
	end
	return #lines > 0 and table.concat(lines, "\n") or nil
end

-- Target marker colours by relation to the player (BSGO: red enemies,
-- blue friendlies) and the targeted object's panel in the same colour.
local RELATION_COLORS = {
	enemy = vmath.vector4(1.0, 0.32, 0.26, 1.0),
	friendly = vmath.vector4(0.35, 0.72, 1.0, 1.0),
	neutral = vmath.vector4(0.85, 0.85, 0.82, 1.0),
}
local BRACKET_THICKNESS = 3
local BRACKET_PADDING = 8 -- px between the object and its bracket

-- The bracket: an L at each corner (two thin boxes), built once.
local function create_marker(self)
	self.bracket = {}
	for i = 1, 8 do
		local node = gui.new_box_node(vmath.vector3(), vmath.vector3(1, 1, 0))
		gui.set_pivot(node, gui.PIVOT_CENTER)
		gui.set_enabled(node, false)
		self.bracket[i] = node
	end
	self.marker_arrow = gui.new_text_node(vmath.vector3(), "")
	gui.set_font(self.marker_arrow, "default_font")
	gui.set_pivot(self.marker_arrow, gui.PIVOT_CENTER)
	gui.set_scale(self.marker_arrow, vmath.vector3(2.2, 2.2, 1))
	gui.set_enabled(self.marker_arrow, false)
end

local function update_marker(self, m)
	local color = RELATION_COLORS[m.relation] or RELATION_COLORS.neutral
	local show_bracket = m.visible and m.on_screen
	for _, node in ipairs(self.bracket) do
		gui.set_enabled(node, show_bracket)
	end
	gui.set_enabled(self.marker_arrow, m.visible and not m.on_screen or false)
	if show_bracket then
		local half = m.size + BRACKET_PADDING
		local arm = math.max(8, half * 0.45)
		local i = 0
		for _, sx in ipairs({ -1, 1 }) do
			for _, sy in ipairs({ -1, 1 }) do
				i = i + 1
				local h, v = self.bracket[i], self.bracket[i + 4]
				gui.set_position(h, vmath.vector3(m.x + sx * (half - arm / 2), m.y + sy * half, 0))
				gui.set_size(h, vmath.vector3(arm, BRACKET_THICKNESS, 0))
				gui.set_position(v, vmath.vector3(m.x + sx * half, m.y + sy * (half - arm / 2), 0))
				gui.set_size(v, vmath.vector3(BRACKET_THICKNESS, arm, 0))
				gui.set_color(h, color)
				gui.set_color(v, color)
			end
		end
	elseif m.visible then
		local arrow
		if math.abs(m.dx) > math.abs(m.dy) then
			arrow = m.dx > 0 and ">" or "<"
		else
			arrow = m.dy > 0 and "^" or "v"
		end
		gui.set_text(self.marker_arrow, arrow)
		gui.set_position(self.marker_arrow, vmath.vector3(m.x, m.y, 0))
		gui.set_color(self.marker_arrow, color)
	end
end

-- Bottom-left ship diagram (per direct instruction: "the top down
-- view of the ship that is shown on the fittings page needs to be
-- rendered at the bottom of the screen when the ship is flying with an
-- indicator to which components are live and or cool down mode. this
-- diagram also needs to show the key to press for that slot") - a scaled
-- copy of main/outpost.gui_script's fitting view: the same top-down
-- silhouette (main/images/topdown/) with one octagon marker per
-- main/data/ships.lua slot_position, the fitted module's icon
-- (main/images/icons.atlas) on it, and that slot's own key ("Shift+1" /
-- "Key 3", session.slot_hotkey) under it. Where the fitting page colors
-- markers filled/empty, this one shows STATE - green = live, amber =
-- cooldown (with a thin bar under the marker draining as a weapon
-- reloads), grey = off/standby/empty - driven by player_ship.script's
-- every-frame "slot_states" message below.
local session = require("main.session")
local ships = require("main.data.ships")
local catalog = require("main.data.modules.catalog")
-- The release version (main/version.lua) shown in the corner readout below -
-- same single source of truth the login screen and the Nakama server use.
local version = require("main.version")

-- slot_positions' {x, y} are screen-pixel offsets in the fitting page's
-- own 440x640 ship_visual space (centre origin, +y = bow); DIAGRAM_SCALE
-- shrinks that whole space onto the diagram, so the marker/label layout
-- stays proportional to the fitting page. The diagram sits in the
-- bottom-left corner of the screen (moved there from the bottom-centre spot
-- it started on), close to the bottom edge but clear of it.
--
-- Per direct instruction, the ENTIRE diagram - the panel background in
-- main/flight_hud.gui, the silhouette, the marker boxes, the key labels and
-- the hover tooltip - is drawn at DIAGRAM_UI_SCALE (66%) of its authored
-- size. The base numbers below are the full-size (100%) geometry and every
-- one of them is passed through ui(), so the widget scales as a single unit.
-- Scaling the markers by the same factor is what keeps them from colliding:
-- shrinking only the diagram would pull the 60px markers closer together
-- while they stayed full size.
--
-- The panel's BOTTOM-LEFT corner is held fixed (rather than its centre), so
-- the smaller diagram stays tucked into the screen corner instead of
-- floating inward toward the middle. The authored diagram_panel node in
-- main/flight_hud.gui carries the same scaled position/size.
local DIAGRAM_UI_SCALE = 0.66
-- Full-size (100%) panel geometry, matching the authored diagram_panel
-- (390x640 centred at 210,335). Kept as plain numbers so DIAGRAM_CENTER
-- below can be DERIVED from them, rather than hard-coded to scaled values.
local DIAGRAM_BASE_SIZE = vmath.vector3(390, 640, 0)
local DIAGRAM_BASE_BOTTOM_LEFT = vmath.vector3(210 - 390 * 0.5, 335 - 640 * 0.5, 0)
-- Scales one full-size pixel value to the diagram's drawn size.
local function ui(v)
	return v * DIAGRAM_UI_SCALE
end
-- The drawn panel's centre: its bottom-left corner held at the base corner,
-- plus half the SCALED size.
local DIAGRAM_CENTER = DIAGRAM_BASE_BOTTOM_LEFT + vmath.vector3(DIAGRAM_BASE_SIZE.x, DIAGRAM_BASE_SIZE.y, 0) * (0.5 * DIAGRAM_UI_SCALE)
local DIAGRAM_SCALE = 0.8 * DIAGRAM_UI_SCALE
local SLOT_TYPE_BY_PREFIX = { W = "weapon", C = "computer", E = "engine", H = "hull" }
local SLOT_EMPTY_ICON = { weapon = "Octagon W", computer = "Octagon C", engine = "Octagon E", hull = "Octagon H" }
local ICON_TEXTURE = "icons"
-- Twice the size they started at (per direct instruction: the slot
-- indicators were too small to read in flight), now scaled back to the
-- diagram's 66% with everything else. 60px is as large as they can go
-- without colliding at full size: the tightest slot spacing is 90 units =
-- 72px at DIAGRAM_SCALE, leaving the same 12px gap between markers that the
-- fitting page's own 74px-on-90px markers have.
local MARKER_SIZE = vmath.vector3(ui(60), ui(60), 0)
-- The module icon is drawn smaller than its marker box, unlike the fitting
-- page's face-covering icons: the marker's STATE colour has to stay
-- visible as a ring around it.
local ICON_SIZE = vmath.vector3(MARKER_SIZE.x * 0.82, MARKER_SIZE.y * 0.82, 0)
-- The key label sits snug under the marker - the slot row below is only
-- 12px away at the tightest spots.
local KEY_LABEL_OFFSET_Y = ui(-34)
local KEY_LABEL_SCALE = vmath.vector3(ui(0.65), ui(0.65), 1)
local HOTKEY_LABEL_COLOR = vmath.vector4(1.0, 0.85, 0.35, 1.0)
-- The Shift modifier is drawn as this icon before the key number (per direct
-- instruction: "modify keys should be indicated with an icon before the
-- key") rather than spelled out as "Shift+" - icons.atlas's "key_shift",
-- generated by tools/build_module_icons.py.
local SHIFT_ICON_ID = "key_shift"
local SHIFT_ICON_SIZE = vmath.vector3(ui(22), ui(22), 0)
-- Hover tooltip (per direct instruction: "hovering over the icon will show
-- the keystroke to activate it with the keyboard") - a small panel above
-- the hovered marker with the fitted module's name and its key, the Shift
-- modifier shown with the icon above. One shared set of nodes, repositioned
-- and re-filled per hover (update_tooltip below).
local TOOLTIP_BG_SIZE = vmath.vector3(ui(260), ui(56), 0)
local TOOLTIP_BG_COLOR = vmath.vector4(0.05, 0.06, 0.1, 0.92)
local TOOLTIP_OFFSET_Y = ui(60)
local TOOLTIP_NAME_COLOR = vmath.vector4(1.0, 1.0, 1.0, 1.0)
local TOOLTIP_NAME_SCALE = vmath.vector3(ui(0.6), ui(0.6), 1)
local TOOLTIP_SHIFT_SIZE = vmath.vector3(ui(24), ui(24), 0)
-- The reload/scan progress bar is drawn INSIDE the marker, across the
-- bottom of the icon (there's no spare room below the marker now that the
-- key label is snug against it).
local COOLDOWN_BAR_OFFSET_Y = ui(-21)
local COOLDOWN_BAR_THICKNESS = ui(7)
local COOLDOWN_BAR_COLOR = vmath.vector4(0.95, 0.72, 0.2, 1.0)
-- Marker box colour = the slot's STATE (see the header comment above):
-- live (switched-on weapon ready to fire / passive module / active
-- module mid-effect), cooldown (weapon reloading), off (switched off,
-- standby, or empty slot), locked (advanced-only slot on a non-advanced
-- ship - same greyed-not-hidden rule as the fitting page).
local STATE_COLORS = {
	live = vmath.vector4(0.3, 0.85, 0.45, 0.85),
	cooldown = vmath.vector4(0.95, 0.72, 0.2, 0.85),
	off = vmath.vector4(0.35, 0.38, 0.42, 0.65),
	locked = vmath.vector4(0.18, 0.19, 0.2, 0.45),
}
local ICON_STATE_COLORS = {
	live = vmath.vector4(1, 1, 1, 1),
	cooldown = vmath.vector4(1, 0.9, 0.7, 1),
	off = vmath.vector4(0.5, 0.5, 0.5, 0.5),
	locked = vmath.vector4(0.5, 0.5, 0.5, 0.5),
}

-- Copy of main/outpost.gui_script's octagon marker node (8-vertex pie
-- rotated 22.5 degrees so flat edges - not vertices - sit on the four
-- sides). The API names below are correct as-is: the fill-angle setter
-- is gui.set_fill_angle and the bounds enum is gui.PIEBOUNDS_ELLIPSE
-- (a guessed gui.set_pie_fill_angle throws at runtime).
local function new_octagon_node(pos, size)
	local node = gui.new_pie_node(pos, size)
	gui.set_perimeter_vertices(node, 8)
	gui.set_outer_bounds(node, gui.PIEBOUNDS_ELLIPSE)
	gui.set_fill_angle(node, 360)
	gui.set_inner_radius(node, 0)
	gui.set_rotation(node, vmath.vector3(0, 0, 22.5))
	return node
end

-- Same top-down silhouette loader as outpost.gui_script's
-- show_ship_silhouette (tools/render_topdown_silhouettes.py output,
-- bundled via game.project's custom_resources) - but into a runtime box
-- node at the diagram's scaled size, since this scene has no authored
-- ship_visual node of its own.
local function show_ship_silhouette(self, ship)
	local skin = ship and ship.faction_skins and ship.faction_skins[session.get_faction()]
	local name = skin and skin.model and skin.model:match("([^/]+)%.model$")
	if not name or name == self.silhouette_name then
		return
	end
	local png = sys.load_resource("/main/images/topdown/" .. name .. ".png")
	local img = png and image.load(png, { premultiply_alpha = true })
	if not img then
		print("[flight_hud] no top-down silhouette for " .. name)
		return
	end
	local texture_id = "diagram_silhouette_" .. name
	if not gui.new_texture(texture_id, img.width, img.height, img.type, img.buffer, false) then
		return
	end
	if self.diagram_silhouette then
		gui.delete_node(self.diagram_silhouette)
	end
	self.diagram_silhouette = gui.new_box_node(DIAGRAM_CENTER,
		vmath.vector3(img.width * DIAGRAM_SCALE, img.height * DIAGRAM_SCALE, 0))
	gui.set_pivot(self.diagram_silhouette, gui.PIVOT_CENTER)
	-- MANUAL (not AUTO, which would snap the node back to the texture's
	-- own 440x640 pixels) so it stays at the scaled size above.
	gui.set_size_mode(self.diagram_silhouette, gui.SIZE_MODE_MANUAL)
	gui.set_texture(self.diagram_silhouette, texture_id)
	if self.silhouette_name then
		gui.delete_texture("diagram_silhouette_" .. self.silhouette_name)
	end
	self.silhouette_name = name
end

-- Applies player_ship.script's "slot_states" payload to the markers built
-- by build_ship_diagram below: state -> marker/icon colour, and the
-- cooldown bar's width is the reload's remaining fraction. Defined
-- before build_ship_diagram because it calls this once at the end.
local function apply_slot_states(self, states)
	for slot_id, marker in pairs(self.diagram_markers or {}) do
		local s = states and states[slot_id]
		local state = s and s.state or "off"
		if marker.locked then
			state = "locked"
		end
		gui.set_color(marker.box, STATE_COLORS[state] or STATE_COLORS.off)
		gui.set_color(marker.icon, ICON_STATE_COLORS[state] or ICON_STATE_COLORS.off)
		local frac = s and s.frac or 0
		if state == "cooldown" and frac > 0 then
			gui.set_enabled(marker.cooldown_bar, true)
			gui.set_size(marker.cooldown_bar,
				vmath.vector3(ICON_SIZE.x * math.min(1, frac), COOLDOWN_BAR_THICKNESS, 0))
		else
			gui.set_enabled(marker.cooldown_bar, false)
		end
	end
end

-- (Re)builds the diagram for whatever the player is flying now - called
-- on every "show_flight_hud" (the loadout can change between flights in
-- the outpost's Fitting tab), no-op-ing the silhouette when the ship
-- didn't change. Marker layout is the fitting page's build_markers
-- reduced to what matters in flight: box + icon + key label + the
-- cooldown bar - no drag/level-badge machinery, but the markers ARE
-- interactive here: hovering one shows its keystroke tooltip and clicking
-- one toggles the slot (see on_input at the bottom of this file).
local function build_ship_diagram(self)
	for _, marker in pairs(self.diagram_markers or {}) do
		gui.delete_node(marker.box)
		gui.delete_node(marker.icon)
		gui.delete_node(marker.key_label)
		gui.delete_node(marker.key_icon)
		gui.delete_node(marker.cooldown_bar)
	end
	self.diagram_markers = {}
	local ship_id = session.get_ship_id()
	local ship = ship_id and ships.SHIPS[ship_id]
	if not ship then
		return
	end
	show_ship_silhouette(self, ship)
	-- Locked = an advanced-only slot (slot_positions' own `tier` field,
	-- main/data/ships.lua §2.1.3) while the ship hasn't been advanced yet,
	-- same rule as outpost.gui_script's build_markers.
	for slot_id, offset in pairs(ship.slot_positions or {}) do
		local prefix = slot_id:match("^(%a)(%d+)$")
		local locked = offset.tier == "advanced" and not session.is_ship_advanced(ship_id)
		local slot_type = prefix and SLOT_TYPE_BY_PREFIX[prefix]
		local module = session.module_in_slot(slot_id)
		local pos = vmath.vector3(
			DIAGRAM_CENTER.x + offset.x * DIAGRAM_SCALE,
			DIAGRAM_CENTER.y + offset.y * DIAGRAM_SCALE, 0)

		local box = new_octagon_node(pos, MARKER_SIZE)
		gui.set_pivot(box, gui.PIVOT_CENTER)

		-- ICON_SIZE, smaller than the marker box (see its own comment).
		local icon = gui.new_box_node(pos, ICON_SIZE)
		gui.set_pivot(icon, gui.PIVOT_CENTER)
		gui.set_texture(icon, ICON_TEXTURE)
		-- forced MANUAL so the high-res "Octagon *" icons render at exactly
		-- MARKER_SIZE (AUTO inflates the node to the image's own pixels),
		-- same as outpost.gui_script's marker icons.
		gui.set_size_mode(icon, gui.SIZE_MODE_MANUAL)
		local icon_id = (module and module.icon) or (slot_type and SLOT_EMPTY_ICON[slot_type])
		if icon_id then
			gui.play_flipbook(icon, icon_id)
		end

		local cooldown_bar = gui.new_box_node(
			vmath.vector3(pos.x, pos.y + COOLDOWN_BAR_OFFSET_Y, 0),
			vmath.vector3(ICON_SIZE.x, COOLDOWN_BAR_THICKNESS, 0))
		gui.set_pivot(cooldown_bar, gui.PIVOT_CENTER)
		gui.set_color(cooldown_bar, COOLDOWN_BAR_COLOR)
		gui.set_enabled(cooldown_bar, false)

		-- The key that uses this slot in flight (session.slot_hotkey): the
		-- slot number for a weapon or an active module, with a Shift ICON
		-- drawn before a weapon's number (per direct instruction: "modify
		-- keys should be indicated with an icon before the key") instead of
		-- the old spelled-out "Shift+n"/"Key n" text; blank for
		-- passive/empty/locked slots.
		local key = module and session.slot_hotkey(ship_id, slot_id)
		local is_weapon = slot_type == "weapon"
		local is_active = module and module.behavior == "active"
		local show_key = key and (is_weapon or is_active)
		local show_shift = show_key and is_weapon
		local key_text = show_key and tostring(key) or ""
		-- The number sits right of centre when a Shift icon shares the space,
		-- so the icon+number pair as a whole stays centred under the marker.
		local key_x = pos.x + (show_shift and ui(15) or 0)
		local key_label = gui.new_text_node(
			vmath.vector3(key_x, pos.y + KEY_LABEL_OFFSET_Y, 0), key_text)
		gui.set_pivot(key_label, gui.PIVOT_CENTER)
		gui.set_font(key_label, "default_font")
		gui.set_color(key_label, HOTKEY_LABEL_COLOR)
		gui.set_scale(key_label, KEY_LABEL_SCALE)

		local key_icon = gui.new_box_node(
			vmath.vector3(pos.x - ui(7), pos.y + KEY_LABEL_OFFSET_Y, 0), SHIFT_ICON_SIZE)
		gui.set_pivot(key_icon, gui.PIVOT_CENTER)
		gui.set_texture(key_icon, ICON_TEXTURE)
		-- MANUAL: the 128x128 texture must render at SHIFT_ICON_SIZE, same
		-- reason as the module icons above.
		gui.set_size_mode(key_icon, gui.SIZE_MODE_MANUAL)
		if show_shift then
			gui.play_flipbook(key_icon, SHIFT_ICON_ID)
			gui.set_color(key_icon, HOTKEY_LABEL_COLOR)
		else
			gui.set_enabled(key_icon, false)
		end

		self.diagram_markers[slot_id] = {
			box = box, icon = icon, key_label = key_label, key_icon = key_icon,
			cooldown_bar = cooldown_bar,
			locked = locked,
			-- Clickable/hoverable only when something usable is fitted.
			usable = module ~= nil and not locked,
		}
	end
	apply_slot_states(self) -- everything starts grey; player_ship refreshes it every frame
end

-- One circular pie node for the scope: a full disc when `inner` is 0, a ring
-- when it isn't (Defold measures both radii in px). Same creation order as
-- main/outpost.gui_script's new_octagon_node - perimeter vertices and ellipse
-- bounds first, then the fill angle. Declared above init(), which is what
-- calls it.
local function new_scope_pie(radius, inner, fill_angle, color)
	local node = gui.new_pie_node(RADAR_CENTER, vmath.vector3(radius * 2, radius * 2, 0))
	gui.set_perimeter_vertices(node, RADAR_SCOPE_VERTS)
	gui.set_outer_bounds(node, gui.PIEBOUNDS_ELLIPSE)
	gui.set_fill_angle(node, fill_angle)
	gui.set_inner_radius(node, inner)
	gui.set_color(node, color)
	return node
end

-- Aims the sweep wedge and its leading-edge line at the current sweep angle.
-- Called once from init() (so the very first drawn frame is already oriented)
-- and every frame from update(). A pie's fill starts at its own local 0
-- degrees, so rotating the wedge one arc length behind the line keeps the line
-- exactly on the wedge's leading edge.
local function apply_sweep(self)
	gui.set_rotation(self.radar_sweep_node, vmath.vector3(0, 0, self.sweep_deg - RADAR_SWEEP_ARC_DEG))
	gui.set_rotation(self.radar_sweep_line, vmath.vector3(0, 0, self.sweep_deg))
end

function init(self)
	self.speed_node = gui.get_node("speed_value")
	self.dock_prompt_node = gui.get_node("dock_prompt")
	self.target_text_node = gui.get_node("target_text")
	self.jump_preset_node = gui.get_node("jump_preset")
	self.system_name_node = gui.get_node("system_name")
	self.scan_status_node = gui.get_node("scan_status")
	gui.set_enabled(self.scan_status_node, false)
	create_marker(self)
	self.hotkeys_node = gui.get_node("hotkeys")
	gui.set_enabled(self.hotkeys_node, false)
	self.progress_node = gui.get_node("progress_toast")
	gui.set_enabled(self.progress_node, false)
	self.progress_generation = 0
	self.tope_node = gui.get_node("tope_value")
	self.water_node = gui.get_node("water_value")
	self.iron_node = gui.get_node("iron_value")
	self.hydrogen_node = gui.get_node("hydrogen_value")
	self.radar_range_node = gui.get_node("radar_range")
	self.radar_range_m = nil
	-- Power / Hull / position readouts (see the "ship_status" handler in
	-- on_message).
	self.power_value_node = gui.get_node("power_value")
	self.hull_value_node = gui.get_node("hull_value")
	self.position_node = gui.get_node("position_value")
	gui.set_scale(self.position_node, POSITION_TEXT_SCALE)
	self.power_text = nil -- last text written, so an unchanged value costs nothing
	self.hull_text = nil
	self.position_text = nil
	self.build_version_node = gui.get_node("build_version")
	gui.set_text(self.build_version_node, "v" .. version.VERSION)

	-- Static scope furniture - see the RADAR_* constants above. Created before
	-- the blip pools below, so every blip draws on top of the scope.
	new_scope_pie(RADAR_SCOPE_RADIUS, 0, 360, RADAR_SCOPE_COLOR)
	new_scope_pie(RADAR_RADIUS, RADAR_RADIUS - RADAR_RING_WIDTH, 360, RADAR_RING_COLOR)
	new_scope_pie(RADAR_SCOPE_RADIUS / 3, RADAR_SCOPE_RADIUS / 3 - 2, 360, RADAR_GRID_COLOR)
	new_scope_pie(RADAR_SCOPE_RADIUS * 2 / 3, RADAR_SCOPE_RADIUS * 2 / 3 - 2, 360, RADAR_GRID_COLOR)
	local cross_h = gui.new_box_node(RADAR_CENTER, vmath.vector3(RADAR_SCOPE_RADIUS * 2 - 12, 2, 0))
	gui.set_pivot(cross_h, gui.PIVOT_CENTER)
	gui.set_color(cross_h, RADAR_GRID_COLOR)
	local cross_v = gui.new_box_node(RADAR_CENTER, vmath.vector3(2, RADAR_SCOPE_RADIUS * 2 - 12, 0))
	gui.set_pivot(cross_v, gui.PIVOT_CENTER)
	gui.set_color(cross_v, RADAR_GRID_COLOR)
	-- The sweep: a translucent wedge trailing a bright leading-edge line. Both
	-- rotate in update(); the wedge sits one arc length behind the line, so the
	-- line is always its leading edge.
	self.radar_sweep_node = new_scope_pie(RADAR_SCOPE_RADIUS, 0, RADAR_SWEEP_ARC_DEG, RADAR_SWEEP_COLOR)
	self.radar_sweep_line = gui.new_box_node(RADAR_CENTER, vmath.vector3(RADAR_SCOPE_RADIUS - 6, 2, 0))
	gui.set_pivot(self.radar_sweep_line, gui.PIVOT_W)
	gui.set_color(self.radar_sweep_line, RADAR_RING_COLOR)
	self.sweep_deg = 0
	apply_sweep(self)

	-- Pool created once, just repositioned/shown-or-hidden per "contacts"
	-- message (same pooling reasoning as the reference project's own
	-- dot_pool - avoids create/destroy churn every frame).
	-- Asteroid blips: same pooling, created first so ship contacts draw over
	-- them (see the ASTEROID_* constants).
	self.asteroid_pool = {}
	for _ = 1, ASTEROID_POOL_SIZE do
		local node = gui.new_box_node(RADAR_CENTER, ASTEROID_DOT_SIZE)
		gui.set_pivot(node, gui.PIVOT_CENTER)
		gui.set_color(node, ASTEROID_DOT_COLOR)
		gui.set_enabled(node, false)
		table.insert(self.asteroid_pool, node)
	end

	-- Outposts between the two: over the rocks, under ship contacts (see the
	-- OUTPOST_* constants). Their colour is set per message from the same
	-- friendly/enemy palette the target brackets use.
	self.outpost_pool = {}
	for _ = 1, OUTPOST_POOL_SIZE do
		local node = gui.new_box_node(RADAR_CENTER, OUTPOST_DOT_SIZE)
		gui.set_pivot(node, gui.PIVOT_CENTER)
		gui.set_color(node, RELATION_COLORS.neutral)
		gui.set_enabled(node, false)
		table.insert(self.outpost_pool, node)
	end

	self.dot_pool = {}
	for _ = 1, DOT_POOL_SIZE do
		local node = gui.new_box_node(RADAR_CENTER, DOT_SIZE)
		gui.set_pivot(node, gui.PIVOT_CENTER)
		gui.set_color(node, DOT_COLOR)
		gui.set_enabled(node, false)
		table.insert(self.dot_pool, node)
	end

	-- Heading marker (see the RADAR_HEADING_* constants) - created last of the
	-- scope's own nodes, so the ship always sits on top of every blip.
	self.heading_node = gui.new_pie_node(RADAR_CENTER, vmath.vector3(RADAR_HEADING_RADIUS * 2, RADAR_HEADING_RADIUS * 2, 0))
	gui.set_perimeter_vertices(self.heading_node, 3)
	gui.set_outer_bounds(self.heading_node, gui.PIEBOUNDS_ELLIPSE)
	gui.set_fill_angle(self.heading_node, 360)
	gui.set_inner_radius(self.heading_node, 0)
	gui.set_rotation(self.heading_node, vmath.vector3(0, 0, RADAR_HEADING_ROTATION))
	gui.set_color(self.heading_node, RADAR_HEADING_COLOR)

	-- Hover tooltip nodes (see TOOLTIP_* above) - created once, then
	-- shown/hidden and re-filled per hover by update_tooltip.
	self.tooltip_bg = gui.new_box_node(vmath.vector3(), TOOLTIP_BG_SIZE)
	gui.set_pivot(self.tooltip_bg, gui.PIVOT_CENTER)
	gui.set_color(self.tooltip_bg, TOOLTIP_BG_COLOR)
	gui.set_enabled(self.tooltip_bg, false)
	self.tooltip_name = gui.new_text_node(vmath.vector3(), "")
	gui.set_pivot(self.tooltip_name, gui.PIVOT_CENTER)
	gui.set_font(self.tooltip_name, "default_font")
	gui.set_color(self.tooltip_name, TOOLTIP_NAME_COLOR)
	gui.set_scale(self.tooltip_name, TOOLTIP_NAME_SCALE)
	gui.set_enabled(self.tooltip_name, false)
	self.tooltip_shift = gui.new_box_node(vmath.vector3(), TOOLTIP_SHIFT_SIZE)
	gui.set_pivot(self.tooltip_shift, gui.PIVOT_CENTER)
	gui.set_texture(self.tooltip_shift, ICON_TEXTURE)
	gui.set_size_mode(self.tooltip_shift, gui.SIZE_MODE_MANUAL)
	gui.play_flipbook(self.tooltip_shift, SHIFT_ICON_ID)
	gui.set_color(self.tooltip_shift, HOTKEY_LABEL_COLOR)
	gui.set_enabled(self.tooltip_shift, false)
	self.tooltip_key = gui.new_text_node(vmath.vector3(), "")
	gui.set_pivot(self.tooltip_key, gui.PIVOT_CENTER)
	gui.set_font(self.tooltip_key, "default_font")
	gui.set_color(self.tooltip_key, HOTKEY_LABEL_COLOR)
	gui.set_scale(self.tooltip_key, KEY_LABEL_SCALE)
	gui.set_enabled(self.tooltip_key, false)
	self.hovered_slot = nil

	-- Frames left to keep re-acquiring input focus for, set on
	-- show_flight_hud and counted down in update() below - see that
	-- handler's own comment on why the acquire can't simply happen right
	-- there in the same message.
	self.focus_retry = 0

	msg.post("#gui", "disable")
end

-- Input focus is taken for the ship diagram's interactive slot markers
-- (on_input at the bottom of this file). This component starts DISABLED
-- (init above) and is only enabled by show_flight_hud - and a gui
-- component that is still disabled at the moment acquire_input_focus is
-- processed SILENTLY IGNORES it (it never joins the input stack, so
-- on_input is never called at all; that's why hovering showed no tooltip
-- AND clicking did nothing, while player_ship.script's own focus - always
-- acquired while already enabled - kept working for the keyboard keys).
-- The enable and the acquire both being posted from the same
-- show_flight_hud handler doesn't help: the enable lands first in the
-- message queue but the component is not actually listening for input
-- until a frame later. So re-post the acquire here, once update() is
-- evidently running (i.e. the enable has definitely taken effect), for a
-- few frames to be safe against ordering quirks.
function update(self, dt)
	if (self.focus_retry or 0) > 0 then
		self.focus_retry = self.focus_retry - 1
		msg.post(".", "acquire_input_focus")
	end
	-- Radar sweep: one revolution every RADAR_SWEEP_PERIOD_S seconds. The
	-- wedge's fill starts at its own local 0 degrees, so rotating it one arc
	-- length behind the leading line keeps the line on the wedge's leading
	-- edge. Only runs while flying - the whole component is disabled between
	-- flights (init posts "disable").
	self.sweep_deg = (self.sweep_deg + RADAR_SWEEP_DEG_PER_SEC * dt) % 360
	apply_sweep(self)
end

local function refresh_radar(self, message)
	local range = message.range or 1
	if range ~= self.radar_range_m then
		self.radar_range_m = range
		gui.set_text(self.radar_range_node, string.format("%.0f m", range))
	end
	local own_pos = message.own_pos
	-- The hull's own heading, flattened onto the world X/Z plane and normalized
	-- by player_ship.script: this is what "up" means on the scope, since the
	-- radar is drawn ship-relative (per direct instruction: "items on the radar
	-- need to be shown relative to the direction of the ship and not relative
	-- to the grid coordinates"). A message without one - an older sender, or a
	-- hull pointing straight up, where the X/Z part collapses - falls back to
	-- world +Z.
	local hx = message.heading and message.heading.x or 0
	local hz = message.heading and message.heading.z or 1
	local scale = RADAR_RADIUS / range

	-- A world position -> where it sits on the scope: first rotated into the
	-- ship's own frame (across = + to starboard, ahead = + toward the bow),
	-- then scaled onto the radius. Starboard is forward x up, i.e. (-hz, hx)
	-- for a heading of (hx, hz) - NOT up x forward: the chase camera looks
	-- straight down the hull's own bow (player_ship.script's camera_target_rot,
	-- where the +Z nose needs the extra YAW_180 flip because a Defold camera
	-- looks down its own local -Z), and that 180 degree yaw puts the camera's
	-- right - so the pilot's own starboard - on the hull's -X. An object at
	-- world +X is therefore off the PORT side when the bow points along +Z.
	-- (hz, -hx) used to sit here, which is the pilot's LEFT: it mirrored the
	-- whole scope left-to-right, so yawing the hull swept the blips the wrong
	-- way round (per direct instruction: "when rotating the ship L/R the radar
	-- rotates the opposite way to what it should").
	-- Contacts are only ever sent within `range` in the first place
	-- (player_ship.script filters that), so the edge clamp is just a safety
	-- margin against float error, not a real "friendly past range" case like
	-- the reference project has (no faction-based always-shown exception here).
	local function scope_position(world)
		local dx, dz = world.x - own_pos.x, world.z - own_pos.z
		local px = (dz * hx - dx * hz) * scale -- across: + starboard, drawn right of centre
		local py = (dx * hx + dz * hz) * scale -- ahead: the bow is up
		local len = math.sqrt(px * px + py * py)
		if len > RADAR_RADIUS then
			px, py = px / len * RADAR_RADIUS, py / len * RADAR_RADIUS
		end
		return px, py
	end
	-- The selected target's id, if one is set - every blip below carries its
	-- own id (the same one player_ship.script's targeting uses), so whichever
	-- one matches draws in the highlight look instead of its pool's own (see
	-- RADAR_TARGET_* above). A message with no target_id - an older sender -
	-- simply leaves every blip in its normal colour.
	local target_id = message.target_id
	local function is_target(blip)
		return target_id ~= nil and blip.id == target_id
	end
	-- Asteroids first, so a ship contact always ends up on top of a rock blip
	-- it happens to share a spot with.
	local asteroids = message.asteroids or {}
	for i, node in ipairs(self.asteroid_pool) do
		local a = asteroids[i]
		if not a then
			gui.set_enabled(node, false)
		else
			local px, py = scope_position(a.pos)
			gui.set_position(node, vmath.vector3(RADAR_CENTER.x + px, RADAR_CENTER.y + py, 0))
			-- Every blip's colour and size is reset here, not just the target's,
			-- so a node reused by a later message can never keep a stale
			-- highlight (only the selected target breaks out of its pool's look).
			if is_target(a) then
				gui.set_color(node, RADAR_TARGET_COLOR)
				gui.set_size(node, ASTEROID_DOT_SIZE * RADAR_TARGET_SCALE)
			else
				gui.set_color(node, ASTEROID_DOT_COLOR)
				gui.set_size(node, ASTEROID_DOT_SIZE)
			end
			gui.set_enabled(node, true)
		end
	end
	-- Outposts, in the friendly/enemy colours the target brackets use (a nil or
	-- unknown relation falls back to neutral).
	local outposts = message.outposts or {}
	for i, node in ipairs(self.outpost_pool) do
		local o = outposts[i]
		if not o then
			gui.set_enabled(node, false)
		else
			local px, py = scope_position(o.pos)
			gui.set_position(node, vmath.vector3(RADAR_CENTER.x + px, RADAR_CENTER.y + py, 0))
			if is_target(o) then
				gui.set_color(node, RADAR_TARGET_COLOR)
				gui.set_size(node, OUTPOST_DOT_SIZE * RADAR_TARGET_SCALE)
			else
				gui.set_color(node, RELATION_COLORS[o.relation] or RELATION_COLORS.neutral)
				gui.set_size(node, OUTPOST_DOT_SIZE)
			end
			gui.set_enabled(node, true)
		end
	end
	local contacts = message.contacts or {}
	for i, node in ipairs(self.dot_pool) do
		local c = contacts[i]
		if not c then
			gui.set_enabled(node, false)
		else
			local px, py = scope_position(c.pos)
			gui.set_position(node, vmath.vector3(RADAR_CENTER.x + px, RADAR_CENTER.y + py, 0))
			if is_target(c) then
				gui.set_color(node, RADAR_TARGET_COLOR)
				gui.set_size(node, DOT_SIZE * RADAR_TARGET_SCALE)
			else
				gui.set_color(node, DOT_COLOR)
				gui.set_size(node, DOT_SIZE)
			end
			gui.set_enabled(node, true)
		end
	end
end

-- Shows `text` in the progress/reward toast for a few seconds (XP,
-- promotions, completed assignments, mined resources). A newer message
-- replaces an older one rather than the older message's timer hiding it.
local function show_toast(self, text)
	if not text then
		return
	end
	self.progress_generation = self.progress_generation + 1
	local generation = self.progress_generation
	gui.set_text(self.progress_node, text)
	gui.set_enabled(self.progress_node, true)
	timer.delay(PROGRESS_SHOWN_S, false, function()
		if generation == self.progress_generation then
			gui.set_enabled(self.progress_node, false)
		end
	end)
end

-- The marker under screen point (x, y) that can be clicked/hovered, or
-- nil. Only fitted, unlocked slots are interactive (an empty or
-- advanced-locked marker does nothing on click).
local function marker_at(self, x, y)
	for slot_id, marker in pairs(self.diagram_markers or {}) do
		if marker.usable and gui.pick_node(marker.box, x, y) then
			return slot_id, marker
		end
	end
	return nil
end

-- Shows the tooltip for `slot_id`'s marker, or hides it when slot_id is
-- nil: the fitted module's name plus its key, the Shift modifier drawn as
-- an icon before the number (see SHIFT_ICON_ID).
local function update_tooltip(self, slot_id, marker)
	if not (slot_id and marker) then
		self.hovered_slot = nil
		gui.set_enabled(self.tooltip_bg, false)
		gui.set_enabled(self.tooltip_name, false)
		gui.set_enabled(self.tooltip_shift, false)
		gui.set_enabled(self.tooltip_key, false)
		return
	end
	self.hovered_slot = slot_id
	local pos = gui.get_position(marker.box)
	local top = pos.y + TOOLTIP_OFFSET_Y
	local key = session.slot_hotkey(session.get_ship_id(), slot_id)
	local module = session.module_in_slot(slot_id)
	local name = (module and catalog.name_for(module, session.get_faction())) or slot_id
	gui.set_position(self.tooltip_bg, vmath.vector3(pos.x, top, 0))
	gui.set_position(self.tooltip_name, vmath.vector3(pos.x, top + ui(12), 0))
	gui.set_text(self.tooltip_name, name)
	gui.set_enabled(self.tooltip_bg, true)
	gui.set_enabled(self.tooltip_name, true)
	local is_weapon = slot_id:sub(1, 1) == "W"
	gui.set_enabled(self.tooltip_key, key ~= nil)
	gui.set_enabled(self.tooltip_shift, key ~= nil and is_weapon)
	if key then
		if is_weapon then
			gui.set_position(self.tooltip_shift, vmath.vector3(pos.x - ui(9), top - ui(12), 0))
			gui.set_position(self.tooltip_key, vmath.vector3(pos.x + ui(12), top - ui(12), 0))
		else
			gui.set_position(self.tooltip_key, vmath.vector3(pos.x, top - ui(12), 0))
		end
		gui.set_text(self.tooltip_key, tostring(key))
	end
end

function on_message(self, message_id, message)
	if message_id == hash("show_flight_hud") then
		msg.post("#gui", "enable")
		-- Take input focus so this gui_script's own on_input (below) sees
		-- mouse moves/clicks on the ship diagram's slot markers. Acquired
		-- after player_ship.script's own focus, so it's on top of the focus
		-- stack and gets a click FIRST - it only consumes clicks that land
		-- on a usable marker (returning true below), so player_ship still
		-- gets every other click for its own click-to-target handling.
		-- This immediate post only takes effect once the enable above has
		-- been applied; the update() below re-posts it for the first few
		-- frames afterwards as a belt-and-braces guarantee (see its own
		-- comment).
		msg.post(".", "acquire_input_focus")
		self.focus_retry = 5
		build_ship_diagram(self)
	elseif message_id == hash("hide_flight_hud") then
		self.focus_retry = 0
		update_tooltip(self, nil, nil)
		msg.post(".", "release_input_focus")
		msg.post("#gui", "disable")
	elseif message_id == hash("set_speed") then
		gui.set_text(self.speed_node, string.format("%.0f m/s", message.speed))
	elseif message_id == hash("dock_prompt") then
		gui.set_enabled(self.dock_prompt_node, message.text ~= nil)
		if message.text then
			gui.set_text(self.dock_prompt_node, message.text)
		end
	elseif message_id == hash("hotkeys") then
		-- weapon (Shift+n) and active module (n) keys, from player_ship.script
		gui.set_enabled(self.hotkeys_node, message.text ~= nil and message.text ~= "")
		gui.set_text(self.hotkeys_node, message.text or "")
	elseif message_id == hash("progress") then
		-- XP / promotion / assignment rewards from the server
		-- (main/network.lua report_progress), shown for a few seconds.
		show_toast(self, progress_text(message))
	elseif message_id == hash("resource") then
		-- A resource mined from an asteroid, credited to the player whose
		-- final shot depleted it (main/network.lua report_resource).
		show_toast(self, "+" .. with_commas(message.amount or 0) .. " " .. tostring(message.resource):upper() .. "  (mined)")
	elseif message_id == hash("scan_status") then
		-- Asteroid Analyser progress/result (main/asteroid_hub.script), nil hides
		gui.set_enabled(self.scan_status_node, message.text ~= nil)
		if message.text then
			gui.set_text(self.scan_status_node, message.text)
		end
	elseif message_id == hash("jump_preset") then
		-- Persistent readout of main/player_ship.script's own
		-- self.jump_preset_system (set by main/flight_map.gui_script
		-- selecting a reachable system) - stays visible after the map
		-- closes, same as the source project's own hud.gui_script
		-- "jump_preset_changed" indicator.
		gui.set_enabled(self.jump_preset_node, message.text ~= nil)
		if message.text then
			gui.set_text(self.jump_preset_node, message.text)
		end
	elseif message_id == hash("target") then
		-- main/player_ship.script's TAB/X/C/T/Y targeting (per direct
		-- instruction: "search superships for all references to target.
		-- Implement what you find") - same hide-when-nil convention
		-- dock_prompt/jump_preset above already use.
		gui.set_enabled(self.target_text_node, message.text ~= nil)
		if message.text then
			gui.set_text(self.target_text_node, message.text)
			gui.set_color(self.target_text_node, RELATION_COLORS[message.relation] or RELATION_COLORS.neutral)
		end
	elseif message_id == hash("target_marker") then
		-- player_ship.script, every frame: bracket around the target, or an
		-- arrow at the screen edge towards it
		update_marker(self, message)
	elseif message_id == hash("system_changed") then
		gui.set_text(self.system_name_node, message.text)
	elseif message_id == hash("currency") then
		gui.set_text(self.tope_node, "Tope: " .. message.tope)
		gui.set_text(self.water_node, "Water: " .. message.water)
		gui.set_text(self.iron_node, "Iron: " .. message.iron)
		gui.set_text(self.hydrogen_node, "Hydrogen: " .. message.hydrogen)
	elseif message_id == hash("ship_status") then
		-- The active ship's own Power and Hull points (main/player_ship.script;
		-- per direct instruction: "while in flight show the ship power and hull
		-- points"), as current / maximum. Nothing drains or damages either one
		-- yet - no combat, plan.md §4 - so today both read full; the values are
		-- the ship's real stats (main/data/ships.lua), not invented numbers.
		-- Cached like radar_range: the text is only rewritten when it changes.
		local power = string.format("%d / %d", message.power or 0, message.power_max or 0)
		local hull = string.format("%d / %d", message.hull or 0, message.hull_max or 0)
		-- Own world position under the scope (per direct instruction: "show x/y/z
		-- coordinates below radar"), in whole metres - the same with_commas
		-- grouping the reward readouts use, which handles the minus sign. Y is
		-- the ship's own altitude, so a coordinate at the system centre is
		-- roughly 0 / 0 / 0.
		local position = string.format("X %s   Y %s   Z %s",
			with_commas(message.x or 0), with_commas(message.y or 0), with_commas(message.z or 0))
		if power ~= self.power_text then
			self.power_text = power
			gui.set_text(self.power_value_node, power)
		end
		if hull ~= self.hull_text then
			self.hull_text = hull
			gui.set_text(self.hull_value_node, hull)
		end
		if position ~= self.position_text then
			self.position_text = position
			gui.set_text(self.position_node, position)
		end
	elseif message_id == hash("contacts") then
		refresh_radar(self, message)
	elseif message_id == hash("slot_states") then
		-- player_ship.script, every frame: live/cooldown/off per fitted
		-- slot for the ship diagram.
		apply_slot_states(self, message.states)
	end
end

-- Only receives input while flying (focus is taken/returned in
-- on_message above, same split main/flight_map.gui_script uses for its own
-- overlay). Two jobs:
--  - hovering a slot marker shows the tooltip with its keystroke
--    (unbound mouse movement arrives with action_id == nil but live x/y,
--    same convention outpost.gui_script relies on);
--  - clicking a slot marker toggles that slot exactly as its key would -
--    player_ship.script owns the on/off state and the server fire order,
--    so this just posts "slot_click" and lets it act.
function on_input(self, action_id, action)
	if action_id == nil then
		local slot_id, marker = marker_at(self, action.x, action.y)
		update_tooltip(self, slot_id, marker)
		return false
	end
	if action_id == hash("touch") and action.pressed then
		local slot_id, marker = marker_at(self, action.x, action.y)
		if marker then
			msg.post("player_ship#script", "slot_click", { slot = slot_id })
			-- consumed: player_ship.script's own click-to-target must not
			-- also fire for a click that landed on a diagram slot
			return true
		end
	end
	return false
end
