script: "/main/flight_hud.gui_script"
material: "/builtins/materials/gui.material"
adjust_reference: ADJUST_REFERENCE_PARENT
max_nodes: 512
background_color {
  x: 0.0
  y: 0.0
  z: 0.0
  w: 0.0
}
fonts {
  name: "default_font"
  font: "/main/ui/flight.font"
}
textures {
  name: "icons"
  texture: "/main/images/icons.atlas"
}
textures { name: "ui_panels" texture: "/main/ui/flight/panels.atlas" }

nodes {
  type: TYPE_BOX
  id: "systems_panel"
  position { x: 163 y: 221 z: 0 w: 1 }
