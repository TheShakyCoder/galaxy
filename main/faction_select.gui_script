-- Faction-choice screen a Guest is shown after pressing "Play as Guest" on
-- the start screen (plan.md §1.1: guests re-pick every load, no
-- persistence — see main/session.lua). Only **The Accord** and **The
-- Swarm** are offered; Robots is never a selectable faction (§1).
--
-- Starts disabled (hidden) — main/start_screen.gui_script enables this
-- screen and disables itself when Guest is pressed. Picking a faction
-- here calls session.choose_faction(), which also assigns the starting
-- ship/loadout gift (session.lua), then hands off to
-- main/outpost.gui — the home-system outpost overview screen.

local session = require("main.session")

function init(self)
	self.active = false
	msg.post(".", "acquire_input_focus")
	msg.post("#gui", "disable")
	self.accord_node = gui.get_node("accord_button")
	self.swarm_node = gui.get_node("swarm_button")
	self.status_node = gui.get_node("status")
	gui.set_text(self.status_node, "")
end

function on_message(self, message_id, message, sender)
	if message_id == hash("show_faction_select") then
		self.active = true
		msg.post("#gui", "enable")
		gui.set_text(self.status_node, "")
	end
end

local function hits(node, action)
	return gui.pick_node(node, action.x, action.y)
end

local function choose(self, faction)
	session.choose_faction(faction)
	print("[faction_select] " .. faction .. " chosen -- handing off to outpost")
	self.active = false
	msg.post("#gui", "disable")
	msg.post("outpost#gui", "show_outpost")
end

function on_input(self, action_id, action)
	if not self.active or action_id ~= hash("touch") or not action.pressed then
		return false
	end
	if hits(self.accord_node, action) then
		choose(self, "accord")
		return true
	elseif hits(self.swarm_node, action) then
		choose(self, "swarm")
		return true
	end
	return false
end
