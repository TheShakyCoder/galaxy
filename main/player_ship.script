-- Minimal flight-mode slice (plan.md §4's "Build flight mode" TODO - first
-- piece only, per direct instruction): a player ship that actually moves,
-- plus a third-person chase camera that follows it with a lerp delay.
-- Deliberately NOT real flight physics - simple kinematic pitch/yaw +
-- constant forward thrust, just enough to exercise and tune the camera.
-- Turning/acceleration/speed now read from ships.lua's real per-ship stats
-- (§2.1.1, see flight_stats() below) rather than flat placeholders - the
-- DEFAULT_* constants there are only a fallback for a ship with no `data`
-- block, same "flag as not final" footing as other placeholder numbers
-- elsewhere in this project (plan.md §4).
--
-- Both this game object ("player_ship") and the camera-only sibling
-- ("flight_camera", main/flight_camera.camera) are embedded directly in
-- main/main.collection, always enabled from load (same "always-on script,
-- gated by an internal active/flying flag" pattern outpost.gui_script and
-- main/ship_preview.script's off-world preview rigs already use) - the
-- outpost's Launch button (main/outpost.gui_script) posts "start_flight"
-- here to actually begin - see complete_dock() below for the reverse trip
-- (K near the player's own outpost, docking countdown, back to the
-- outpost menu).

local ships = require("main.data.ships")
local star_systems = require("main.data.star_systems")
local session = require("main.session")

-- Two DIFFERENT "forward" concepts, deliberately kept separate - conflating
-- them into one shared FORWARD constant was a real bug, found via live
-- testing (per direct instruction: "the camera needs to be rotated 180
-- degrees and moved to the other end of the ship"):
--
-- 1. SHIP_FORWARD - this hull's own nose direction, an ASSET fact.
--    tools/build_sardine_model.py's own header comment is explicit the hull
--    is built "nose at +Z" - the opposite of the reference project's own
--    ship.script FORWARD constant (0,0,-1), which was wrongly copied
--    verbatim without checking. Used for movement only.
-- 2. CAMERA_FORWARD - Defold's own ENGINE convention that a camera looks
--    down its local -Z, unrelated to any particular ship's nose direction.
--    Used for the chase camera's position/rotation math only.
--
-- Since these two are opposite on this hull (+Z nose vs. a camera that
-- looks down -Z), the camera's rotation needs an extra 180-degree yaw
-- relative to the ship's own rotation - see camera_target_rot in update()
-- below - so that the camera's native "look down -Z" ends up pointing at
-- the ship's own +Z nose (i.e. at the ship), not away from it. Using the
-- ship's raw rotation for the camera directly (no 180 flip) is exactly what
-- caused the reported symptom: camera on the nose end looking backward at
-- the tail while the ship itself moved tail-first.
local SHIP_FORWARD = vmath.vector3(0, 0, 1)
local CAMERA_FORWARD = vmath.vector3(0, 0, -1)
local UP = vmath.vector3(0, 1, 0)
local RIGHT = vmath.vector3(1, 0, 0)
local YAW_180 = vmath.quat_axis_angle(UP, math.pi)

-- Auto-level assist (per direct instruction: "port" the reference
-- project's own bank/roll system - §0, mechanics not creative
-- expression). Measures how far the ship's CURRENT bank angle has
-- drifted from level (wings horizontal for its current heading), in
-- radians, so update()'s body-frame rotation block can apply a simple
-- proportional "spring back to zero" target once AUTO_LEVEL_DELAY has
-- passed with no pitch/yaw input. Ported from the reference's own
-- level_roll_angle() - same idea (derive a "level" right/up basis for the
-- ship's current forward, measure where its actual up vector sits within
-- that basis via atan2), but right_level's cross product ARGUMENT ORDER
-- is swapped (cross(UP, forward), not the reference's cross(forward, UP))
-- to match this hull's own +Z-forward convention (the reference's is
-- -Z) - verified this swap (and the correction sign in update() below)
-- numerically, not just re-derived by hand: cross(forward,UP) instead
-- would silently make the correction UNSTABLE (roll error growing
-- instead of shrinking) rather than throwing any error, so this was
-- checked against a small standalone Lua/Python simulation before
-- landing, not just symbolically.
local function level_roll_angle(rot)
	local forward = vmath.rotate(rot, SHIP_FORWARD)
	local right_level
	if math.abs(forward.y) < 0.999 then
		right_level = vmath.normalize(vmath.cross(UP, forward))
	else
		-- Degenerate only when forward is (near-)vertical, where "level"
		-- has no meaningful heading to measure roll against - freezes on
		-- the ship's own current right vector that one frame rather than
		-- producing a NaN from a zero-length cross product.
		right_level = vmath.rotate(rot, RIGHT)
	end
	local up_level = vmath.cross(forward, right_level)
	local up_world = vmath.rotate(rot, UP)
	return math.atan2(vmath.dot(up_world, right_level), vmath.dot(up_world, up_level))
end

-- Auto-level only kicks in this long after the player's last pitch/yaw
-- input (there's no manual roll key - see update()'s own comment) - give
-- an active maneuver room to bank into a turn without the assist fighting
-- it mid-turn, only easing the ship back level once they've actually let
-- go. AUTO_LEVEL_SPEED is the proportional "spring" strength (how much
-- target angular velocity per radian of roll error) - both flat
-- placeholder constants (matching the reference project's own
-- AUTO_LEVEL_DELAY/auto_level_speed go.property defaults, 3.0/2.0) since
-- main/data/ships.lua has no per-ship fields for either yet.
local AUTO_LEVEL_DELAY = 3.0
local AUTO_LEVEL_SPEED = 2.0

-- Which ship this slice flies - main/session.lua's own session.get_ship_id()
-- (whatever the player last selected at the outpost), falling back to the
-- same starting ship session.lua itself defaults to (M.STARTING_SHIP_ID,
-- not exported, so mirrored here as a literal) for the case flight somehow
-- starts before a ship is ever selected. Determines BOTH the stat block
-- (flight_stats()/camera_distance_height() below) AND which of
-- main/main.collection's 24 pre-embedded "model_<ship_id>_<faction>"
-- components (one per ships.lua chassis x faction skin - see
-- model_component_id()/start_flight()'s own enable/disable loop below) is
-- shown - previously always the Patrol Interceptor/Sardine model
-- regardless of what was actually purchased/selected, a real bug (per
-- direct instruction: "no matter what ship I purchase and select... I only
-- see the Sardine").
local DEFAULT_SHIP_ID = "patrol_interceptor"

-- main/main.collection's "player_ship" instance embeds one model component
-- per (ship_id, faction) combination in ships.lua, all named this way -
-- exactly one is enabled at a time (start_flight() below), the other 23
-- disabled, rather than trying to swap a single component's underlying
-- mesh at runtime (Defold's Model component doesn't expose that as a
-- settable resource property the way e.g. a Sprite's image can be
-- swapped) - same "pre-instantiate every possibility, toggle visibility"
-- shape main/outpost.gui_script's own ship-preview rigs already use for
-- the exact same reason, just via component enable/disable here instead
-- of camera targeting.
local function model_component_id(ship_id, faction)
	return "model_" .. ship_id .. "_" .. faction
end

-- Must match main/main.collection's own accord_outpost/swarm_outpost
-- embedded instance positions exactly - same "hardcoded mirror, kept in
-- sync by hand" approach (and same reasoning) as the other local reference
-- project's own ship.script FACTION_OUTPOST table, which this is ported
-- from (§0 - mechanics, not creative expression). Used for both the
-- launch spawn point and the docking proximity check below.
local FACTION_OUTPOST = {
	accord = vmath.vector3(-4000, 0, -4000),
	swarm = vmath.vector3(4000, 0, 4000),
}

-- Ambient lighting (per direct instruction: "increase the general ambient
-- light in all the systems"). /builtins/materials/model.material's
-- compiled fragment shader (extracted and read directly from the build
-- output - build/default/_generated_b1605dbb.spc, the only way to see its
-- actual source, since it's a Defold builtin with no .fp file in this
-- project's own tree) is:
--   out_fragColor = (texture_color * tint.rgb * tint.a)
--                    * clamp(max(dot(normal, light_dir), 0.0) + 0.2, 0, 1)
-- The 0.2 ambient floor is a FIXED CONSTANT BAKED INTO THE COMPILED
-- SHADER, not a uniform - `light` (a world-space position, already used
-- above for crude sun-direction faking) and `tint` are the ONLY two
-- constants actually exposed to go.set (confirmed by the compiled
-- material's own reflection data: mtx_worldview/mtx_view/mtx_proj/
-- mtx_normal/light/tint/tex0 - no separate "ambient"). Scaling `light`
-- does nothing for this purpose either - it only ever feeds a
-- normalize()'d direction, so its magnitude is irrelevant, only its
-- direction is. `tint` is consequently the only real lever: a flat
-- multiply applied to the texture BEFORE the light factor, so raising it
-- brightens the ambient-only (unlit-facing) 0.2 floor right along with
-- the fully-lit 1.0 side (the latter simply clips back down at the
-- framebuffer, same visual effect a genuinely higher ambient floor would
-- have). 1.4 is a moderate, clearly-noticeable placeholder multiplier,
-- not a lighting-design decision (plan.md §4) - applied to every model
-- component this project ever renders during flight (this file's own
-- ship hulls below, main/asteroid_hub.script's spawned asteroids,
-- main/ambient_lit.script's outposts) so the boost reads as one
-- consistent scene-wide change, not just brighter ships.
local AMBIENT_TINT = vmath.vector4(1.4, 1.4, 1.4, 1.0)

-- Docking (per direct instruction): a ship may only dock within DOCK_RANGE
-- of its own faction's outpost, and launching drops it back at a random
-- point on the surface of that same DOCK_RANGE sphere (not a filled ball -
-- "any point ON a sphere") - see random_spawn()/update()'s docking block
-- below.
local DOCK_RANGE = 500
local DOCK_COUNTDOWN_SEC = 5

-- FTL jump (per direct instruction: "implement [the SuperShips jump
-- mechanic] here" - see the SuperShips research findings this ports).
-- COMBAT_JUMP_MULTIPLIER quadruples charge time while self.in_combat -
-- an inert, documented hook, not enforced: there's no weapon-fire system
-- in this project yet to ever set self.in_combat true, same "flag as a
-- future hook rather than pretend to enforce it" footing the reference
-- project's own identical constant has (§0).
local COMBAT_JUMP_MULTIPLIER = 4

-- Uniform-on-sphere-surface point at radius DOCK_RANGE around
-- outpost_pos, facing the system origin from there - same
-- acos(2u-1)-for-polar-angle technique main/data/asteroids.lua already
-- uses to avoid bunching at the poles (there it's for a filled ball; here
-- radius is fixed, only the direction is randomized). Rotation technique
-- (quat_from_to with a same-axis fallback for the exactly-opposite case,
-- which quat_from_to can't itself handle - it returns NaN) is ported from
-- the reference project's own random_spawn() (§0).
local function random_spawn(outpost_pos)
	local theta = math.acos(2 * math.random() - 1)
	local phi = math.random() * 2 * math.pi
	local offset = vmath.vector3(
		DOCK_RANGE * math.sin(theta) * math.cos(phi),
		DOCK_RANGE * math.cos(theta),
		DOCK_RANGE * math.sin(theta) * math.sin(phi))
	local pos = outpost_pos + offset

	local to_center = -pos
	local rot
	if vmath.length(to_center) < 0.0001 then
		rot = vmath.quat()
	else
		local dir = vmath.normalize(to_center)
		if vmath.dot(SHIP_FORWARD, dir) < -0.9999 then
			rot = vmath.quat_axis_angle(UP, math.pi)
		else
			rot = vmath.quat_from_to(SHIP_FORWARD, dir)
		end
	end
	return pos, rot
end

-- Turning/acceleration/speed now read from this ship's own real stat block
-- (main/data/ships.lua's `data` table, plan.md §2.1.1's Engine Systems -
-- previously flat placeholders here, per direct instruction: the Patrol
-- Interceptor "should do more than 20 m/s"). DEFAULT_* below only cover
-- the case the selected ship_id ever points at a ship with no `data` block
-- yet - same fallback shape as camera_distance_height()'s own DEFAULT pair.
local DEFAULT_TURN_SPEED_DEG = 60
local DEFAULT_TURN_ACCELERATION_DEG = 60 -- deg/sec^2, how fast pitch/yaw ramp up to turning_speed_deg_per_sec - see update()'s body-frame rotation block
local DEFAULT_MAX_SPEED = 20 -- m/sec, unboosted
local DEFAULT_BOOST_SPEED = 40 -- m/sec, boosted
local DEFAULT_ACCELERATION = 12 -- m/sec^2, how fast throttle ramps the actual speed
local DEFAULT_VISUAL_RANGE = 500 -- m, radar range - see update()'s "contacts" block below
local DEFAULT_FTL_RANGE = 4.5 -- ly, matches patrol_interceptor's own ftl_range_ly - converted to star_systems.lua's own map-unit scale via M.ly_to_map_units() at each use site below (toggle_map()/on_message's "set_jump_preset" handler), not compared directly

local DEFAULT_JUMP_TIMER_SEC = 15 -- sec, fallback for a ship with no ftl_charge_sec of its own - matches the reference project's own DEFAULT_JUMP_TIMER_SEC (§0)

local function flight_stats(ship_id)
	local ship = ships.SHIPS[ship_id]
	local d = ship and ship.data
	return
		(d and d.turning_speed_deg_per_sec) or DEFAULT_TURN_SPEED_DEG,
		(d and d.speed_m_per_sec) or DEFAULT_MAX_SPEED,
		(d and d.boost_speed_m_per_sec) or DEFAULT_BOOST_SPEED,
		(d and d.acceleration_m_per_sec2) or DEFAULT_ACCELERATION,
		(d and d.visual_range_m) or DEFAULT_VISUAL_RANGE,
		(d and d.ftl_range_ly) or DEFAULT_FTL_RANGE,
		(d and d.ftl_charge_sec) or DEFAULT_JUMP_TIMER_SEC,
		(d and d.turning_acceleration_deg_per_sec2) or DEFAULT_TURN_ACCELERATION_DEG
end

-- Chase camera - ported subset (chase mode only; the reference project's
-- front/target-view modes aren't built here, not asked for) of
-- ~/Defold/SuperShips/main/ship.script's own chase-camera math (§0 - UX/
-- mechanics technique, not creative expression). Two key ideas carried
-- over directly from that file's own header comment on this exact logic:
-- (1) frame-rate-independent lag via `1 - exp(-speed*dt)`, not a fixed
-- per-frame lerp fraction; (2) camera POSITION is derived from the
-- already-lagged ROTATION each frame, not lerped on its own - lerping
-- position independently would cut a straight chord across a sustained
-- turn instead of swinging around it, so the camera would visibly drift
-- off-axis mid-turn even while correctly converging on the final target.
--
-- `distance`/`height` are per-ship-chassis now (plan.md §2.10.1, per direct
-- instruction - "each ship chassis will have its own coordinates/zoom for
-- where the camera should be looking from"): main/data/ships.lua's
-- `flight_camera` field, falling back to this DEFAULT pair (still the old
-- hand-picked values) for any ship with no entry of its own yet.
local CAMERA_DEFAULT_DISTANCE = 12
local CAMERA_DEFAULT_HEIGHT = 4
local CAMERA_FOLLOW_SPEED = 3.0

local function camera_distance_height(ship_id)
	local ship = ships.SHIPS[ship_id]
	local fc = ship and ship.flight_camera
	return (fc and fc.distance) or CAMERA_DEFAULT_DISTANCE, (fc and fc.height) or CAMERA_DEFAULT_HEIGHT
end

-- Throttle starts at full (1.0) rather than 0 - matches this slice's
-- previous always-move-at-MAX_SPEED behavior as the default, with
-- throttle_up/throttle_down (input/game.input_binding's =/- and numpad
-- +/-) now able to pull it down from there, stop_throttle (Q) zeroing it,
-- and full_throttle (E) snapping it back to 1.0 - see update()'s throttle
-- handling below.
local function default_input()
	return {
		pitch_up = false, pitch_down = false, yaw_left = false, yaw_right = false, boost = false,
		throttle_up = false, throttle_down = false,
	}
end

function init(self)
	self.flying = false
	self.input = default_input()
	self.throttle = 1.0
	self.speed = 0 -- actual current speed (m/sec) - see update()'s acceleration-bounded lerp toward target_speed below
	self.angular_velocity = vmath.vector3() -- rad/sec, local axes (x=pitch, y=yaw, z=roll) - see update()'s body-frame rotation block
	self.time_since_rotation_input = 0 -- seconds since the last pitch/yaw input - see AUTO_LEVEL_DELAY
	self.camera_rot = nil -- nil = "snap on next update", same convention the reference uses
	self.near_outpost = false
	self.docking = false
	self.dock_time_left = 0
	self.map_open = false
	self.jump_preset_system = nil
	self.jumping = false
	self.jump_time_left = 0
	self.jump_target_system = nil
	self.jump_hydrogen_spent = 0 -- refunded if K cancels the countdown - see on_input's "dock" handler
	self.in_combat = false -- see COMBAT_JUMP_MULTIPLIER's own comment - always false, nothing sets this true yet
	self.current_system_id = nil
	self.ship_id = nil -- resolved from session.get_ship_id() in start_flight() - not known yet here (faction/ship selection hasn't happened this early)
	self.model_component_id = nil
	msg.post("flight_camera#camera", "disable")
end

local function start_flight(self)
	self.flying = true
	self.input = default_input()
	self.throttle = 1.0
	self.speed = 0 -- ship starts at rest and spools up to cruise, same as any other launch - see update()
	self.angular_velocity = vmath.vector3()
	self.time_since_rotation_input = 0
	self.camera_rot = nil
	self.near_outpost = false
	self.docking = false
	self.dock_time_left = 0
	self.map_open = false
	-- self.jump_preset_system is deliberately NOT reset here - same
	-- "survives everything except actually being consumed/reselected"
	-- persistence the source project's own version describes.
	self.jumping = false
	self.jump_time_left = 0
	self.jump_target_system = nil
	self.jump_hydrogen_spent = 0
	self.in_combat = false

	-- Which of main/main.collection's 24 pre-embedded model components to
	-- show (per direct instruction: the ship actually flown must match
	-- whatever's purchased/selected, not always the Patrol Interceptor) -
	-- see model_component_id()'s own comment above for why toggling
	-- enabled state on 24 pre-built components, not a runtime mesh swap.
	local faction = session.get_faction()
	self.ship_id = session.get_ship_id() or DEFAULT_SHIP_ID
	self.model_component_id = model_component_id(self.ship_id, faction)
	for ship_id, _ in pairs(ships.SHIPS) do
		for _, f in ipairs({ "accord", "swarm" }) do
			local id = model_component_id(ship_id, f)
			msg.post("#" .. id, (id == self.model_component_id) and "enable" or "disable")
		end
	end

	-- `light` is a world-space POINT LIGHT POSITION on model.material (see
	-- main/ship_preview.script's own header comment on this exact constant),
	-- not a color - model.material's
	-- undocumented DEFAULT of (1,1,1,1) is a light sitting almost exactly where
	-- the ship spawns, which rendered near-black. A large fixed offset acts as a
	-- crude stand-in directional light for this minimal slice - real lighting
	-- design (sun direction, ambient, etc.) is plan.md §4 territory, not solved here.
	-- Set on the CURRENTLY VISIBLE model component specifically, not a
	-- fixed "#model" (only ever true back when there was exactly one).
	go.set("#" .. self.model_component_id, "light", vmath.vector4(4000, 6000, 4000, 1.0))
	-- `tint` (per direct instruction: "increase the general ambient light
	-- in all the systems") - see AMBIENT_TINT's own comment above for why
	-- this, not `light`, is the lever that actually reaches the shader's
	-- fixed 0.2 ambient floor.
	go.set("#" .. self.model_component_id, "tint", AMBIENT_TINT)

	local outpost_pos = FACTION_OUTPOST[faction]
	local pos, rot = random_spawn(outpost_pos)
	go.set_position(pos)
	go.set_rotation(rot)
	msg.post(".", "acquire_input_focus")
	msg.post("flight_camera#camera", "enable")
	msg.post("flight_hud#gui", "show_flight_hud")

	-- Every flight starts at the player's own home system, same convention
	-- main/outpost.gui_script's refresh_map() already uses (and the
	-- reference project's own init()-time apply_system() call) - jumping
	-- elsewhere during flight is arrive_at_system()'s job below. Stored on
	-- self (not just a local) so toggle_map()/on_input, called at any
	-- later point during flight, can still reach it.
	self.current_system_id = star_systems.HOME_SYSTEM[faction]
	msg.post("asteroid_hub#script", "spawn_field", { system_id = self.current_system_id })
	msg.post("flight_hud#gui", "system_changed", { text = "SYSTEM: " .. star_systems.SYSTEMS[self.current_system_id].name })
end

-- Makes `system_id` the player's current system - the Galaxy-appropriate
-- slice of the reference project's own apply_system() (§0): repositions
-- the ship, respawns the asteroid field, and updates the HUD's system-name
-- readout. Called once from execute_jump()'s countdown-complete handler in
-- update() below (never from start_flight(), which always goes home - see
-- that function's own comment).
--
-- What this does NOT do, unlike the source: enable/disable per-system
-- outpost meshes, or switch any multiplayer room - main/main.collection
-- only has the ONE physical accord/swarm outpost pair (fixed-position,
-- used for docking), not a real per-system 3D world/outpost per
-- main/data/star_systems.lua's own M.has_outpost - flight mode is still
-- one generic scene regardless of which system_id is "current" (§4, a
-- known, larger, un-built gap - not this feature's job to invent a
-- multi-world architecture). Docking still degrades sensibly despite
-- this: jumping to a non-home system spawns you at the map origin
-- (jump_in_spawn below), physically far from FACTION_OUTPOST's fixed
-- position, so self.near_outpost's own plain distance check already
-- reads false there without any extra system-aware logic - the "no
-- outpost to dock at outside your own home system" behavior falls out of
-- the existing physical-distance check as a side effect, not a deliberate
-- per-system rule.
local function arrive_at_system(self, system_id)
	self.current_system_id = system_id
	local faction = session.get_faction()
	local home = star_systems.faction_home_of(system_id)

	local pos, rot
	if home == faction then
		pos, rot = random_spawn(FACTION_OUTPOST[faction])
	else
		-- Same ring-spawn as random_spawn(), just centered on the map
		-- origin instead of an outpost - ported technique from the
		-- reference project's own jump_in_spawn() (§0), used whenever the
		-- destination has no outpost of the player's own faction to
		-- arrive near. Also conveniently right where main/data/asteroids.lua's
		-- own field is centered, unlike the source (whose ambient drone
		-- pool just happens to roam near its own map origin too, per that
		-- function's own comment).
		pos, rot = random_spawn(vmath.vector3(0, 0, 0))
	end
	go.set_position(pos)
	go.set_rotation(rot)
	self.camera_rot = nil -- snap the chase camera to the new position/rotation instead of slerping from wherever it was before the jump (same convention start_flight() already uses for the exact same "ship just teleported" case)

	msg.post("asteroid_hub#script", "spawn_field", { system_id = system_id })
	msg.post("flight_hud#gui", "system_changed", { text = "SYSTEM: " .. star_systems.SYSTEMS[system_id].name })
end

-- Mirror image of start_flight() - returns to the outpost menu the same
-- way Launch left it (main/outpost.gui_script's "show_outpost" handler
-- already does the "reset to Overview tab, refresh currency/ship text"
-- work, same as when faction_select first hands off there). Called once
-- update()'s docking countdown reaches zero, see below.
local function complete_dock(self)
	self.flying = false
	self.docking = false
	self.dock_time_left = 0
	if self.map_open then
		self.map_open = false
		msg.post("flight_map#gui", "toggle", { open = false })
	end
	msg.post("flight_camera#camera", "disable")
	msg.post("flight_hud#gui", "hide_flight_hud")
	msg.post("outpost#gui", "show_outpost")
end

-- Shared by on_input's "toggle_map" key (N) handler below - flight_map.gui_script
-- owns showing/hiding itself and acquiring its own input focus while open
-- (see that file), this just flips the shared flag and tells it to react.
-- Ported technique from the reference project's own ship.script
-- toggle_map() (§0).
local function toggle_map(self)
	if self.jumping then
		-- mid-countdown - nothing to browse, and there's no [X]/close
		-- affordance needed since the map can't be open right now anyway
		-- (execute_jump() below force-closes it the moment the countdown
		-- starts) - matches the reference project's own toggle_map() guard.
		return
	end
	self.map_open = not self.map_open
	local _, _, _, _, _, ftl_range_ly = flight_stats(self.ship_id)
	msg.post("flight_map#gui", "toggle", {
		open = self.map_open,
		current_system_id = self.current_system_id,
		ftl_range = star_systems.ly_to_map_units(ftl_range_ly), -- flight_map.gui_script/star_systems.in_ftl_range both work in map units, not light-years
		preset_system_id = self.jump_preset_system, -- lets flight_map.gui_script re-highlight whatever's already armed when reopening, rather than forgetting it visually
	})
end

-- Actually starts the FTL countdown for whatever's currently armed in
-- self.jump_preset_system - shared by the J key (on_input below) and
-- main/flight_map.gui's [JUMP] button (via on_message's
-- "execute_jump_preset" below), same "preset selects, J/[JUMP] commits"
-- split the sector map's own header comment describes. No-ops quietly if
-- nothing's armed, a jump is already underway, or docking is (can't do
-- both at once) - all easy to hit legitimately (J out of habit with
-- nothing preset, or twice in a row), matching the reference project's
-- own execute_jump_preset() (§0). Re-validates independently rather than
-- trusting whatever armed the preset (same reasoning as on_message's
-- "set_jump_preset" handler).
local function execute_jump(self)
	if self.jumping or self.docking or not self.jump_preset_system then
		return
	end
	local faction = session.get_faction()
	if not star_systems.can_enter(self.jump_preset_system, faction) then
		self.jump_preset_system = nil
		return
	end
	local dist = self.current_system_id and star_systems.distance(self.current_system_id, self.jump_preset_system)
	local _, _, _, _, _, ftl_range_ly, ftl_charge_sec = flight_stats(self.ship_id)
	if not star_systems.in_ftl_range(dist, star_systems.ly_to_map_units(ftl_range_ly)) then
		return
	end
	-- Hydrogen is real fuel, not just displayed - main/flight_map.gui_script
	-- already checks affordability before ever describing this system as
	-- reachable, but re-checked here too for the same "don't just trust
	-- the sender" reason as the checks above.
	local cost = star_systems.hydrogen_cost(dist)
	if not session.spend_hydrogen(cost) then
		return
	end

	self.jumping = true
	self.jump_time_left = ftl_charge_sec * (self.in_combat and COMBAT_JUMP_MULTIPLIER or 1)
	self.jump_target_system = self.jump_preset_system
	self.jump_hydrogen_spent = cost
	self.jump_preset_system = nil
	msg.post("flight_hud#gui", "jump_preset", { text = nil })

	if self.map_open then
		self.map_open = false
		msg.post("flight_map#gui", "toggle", { open = false })
	end
end

-- Selecting a system on main/flight_map.gui arms it as a preset -
-- re-validated independently here rather than trusting that gui_script's
-- own reachability check outright (same "don't just trust the sender"
-- reasoning the source project's own identically-named handler gives).
function on_message(self, message_id, message)
	if message_id == hash("start_flight") then
		start_flight(self)
	elseif message_id == hash("set_jump_preset") then
		local faction = session.get_faction()
		if star_systems.can_enter(message.system_id, faction) then
			local _, _, _, _, _, ftl_range_ly = flight_stats(self.ship_id)
			local dist = self.current_system_id and star_systems.distance(self.current_system_id, message.system_id)
			if star_systems.in_ftl_range(dist, star_systems.ly_to_map_units(ftl_range_ly)) then
				self.jump_preset_system = message.system_id
				local name = star_systems.SYSTEMS[message.system_id].name
				msg.post("flight_hud#gui", "jump_preset", { text = "PRESET: " .. name .. " [J]" })
			end
		end
	elseif message_id == hash("execute_jump_preset") then
		-- main/flight_map.gui's [JUMP] button - same effect as pressing J
		execute_jump(self)
	end
end

function on_input(self, action_id, action)
	if not self.flying then
		return false
	end
	if action_id == hash("toggle_map") and action.pressed then
		-- Checked first, and unconditionally (even while the map's
		-- already open - this is also how it closes again).
		toggle_map(self)
		return true
	end
	if self.map_open then
		-- swallow everything else (flight keys, dock, throttle, camera,
		-- ...) while the map's open, rather than letting any of it fall
		-- through to the normal handling below.
		return true
	end
	if action_id == hash("pitch_up") then
		self.input.pitch_up = not action.released
	elseif action_id == hash("pitch_down") then
		self.input.pitch_down = not action.released
	elseif action_id == hash("yaw_left") then
		self.input.yaw_left = not action.released
	elseif action_id == hash("yaw_right") then
		self.input.yaw_right = not action.released
	elseif action_id == hash("boost") then
		self.input.boost = not action.released
	elseif action_id == hash("throttle_up") then
		self.input.throttle_up = not action.released
	elseif action_id == hash("throttle_down") then
		self.input.throttle_down = not action.released
	elseif action_id == hash("stop_throttle") then
		if action.pressed then
			self.throttle = 0.0
		end
	elseif action_id == hash("full_throttle") then
		if action.pressed then
			self.throttle = 1.0
		end
	elseif action_id == hash("dock") then
		-- "Pressing K will cancel your FTL jump" - checked first, same key
		-- docking's own countdown already uses to commit, so jump-cancel
		-- takes priority (mirrors the reference project's own on_input
		-- "dock" handler): the two countdowns can never really overlap in
		-- practice (execute_jump() above refuses to start while docking,
		-- and starting to dock requires near_outpost, which a jump's own
		-- arrival spawn point away from any outpost already rules out),
		-- but checking self.jumping first keeps K's meaning unambiguous
		-- regardless.
		if action.pressed then
			if self.jumping then
				self.jumping = false
				self.jump_target_system = nil
				session.add_hydrogen(self.jump_hydrogen_spent)
				self.jump_hydrogen_spent = 0
			elseif self.near_outpost and not self.docking then
				self.docking = true
				self.dock_time_left = DOCK_COUNTDOWN_SEC
			end
		end
	elseif action_id == hash("execute_jump") then
		-- "This is very handy when you need to FTL away rather than die" -
		-- fires whatever's currently armed in self.jump_preset_system
		-- without needing the map open at all, see execute_jump() above.
		if action.pressed then
			execute_jump(self)
		end
	else
		return false
	end
	return true
end

function update(self, dt)
	if not self.flying then
		return
	end

	local turn_speed_deg, max_speed, boost_speed, acceleration, visual_range, _, _, turn_accel_deg = flight_stats(self.ship_id)
	local turn_speed_rad = math.rad(turn_speed_deg)
	local turn_accel_rad = math.rad(turn_accel_deg)

	local pitch_delta = (self.input.pitch_up and 1 or 0) - (self.input.pitch_down and 1 or 0)
	local yaw_delta = (self.input.yaw_left and 1 or 0) - (self.input.yaw_right and 1 or 0)

	-- Full body-frame rotation (per direct instruction: "port" the
	-- reference project's own arcade flight model - see this project's own
	-- research findings on it) - pitch/yaw torque coasts under angular
	-- "drag" (here: eases toward a target angular velocity bounded by
	-- turn_accel_rad, same acceleration-bounded-target technique
	-- self.speed below already uses, rather than the reference's own
	-- exponential 1/(1+drag*dt) decay - a cleaner fit for this project's
	-- existing turning_speed_deg_per_sec/turning_acceleration_deg_per_sec2
	-- stat PAIR, which was already sitting unused in main/data/ships.lua
	-- - not the reference's own single turn_rate/drag pair) - and, unlike
	-- the WORLD-frame yaw this replaces, pitch+yaw now compose in the
	-- ship's own LOCAL frame each frame (rot = rot * delta, not delta *
	-- rot), which is what lets bank/roll emerge organically from combined
	-- pitch+yaw the same way a real aircraft's does - there is still no
	-- manual roll key (matching the reference project's own default
	-- scheme exactly - bank is never directly flown, only ever drifted
	-- into and auto-leveled back out of).
	if pitch_delta ~= 0 or yaw_delta ~= 0 then
		self.time_since_rotation_input = 0
	else
		self.time_since_rotation_input = self.time_since_rotation_input + dt
	end

	local rot = go.get_rotation()
	local target_angular_velocity = vmath.vector3(
		turn_speed_rad * pitch_delta,
		turn_speed_rad * yaw_delta,
		0)
	if pitch_delta == 0 and yaw_delta == 0 and self.time_since_rotation_input >= AUTO_LEVEL_DELAY then
		-- Auto-level (per direct instruction) - a proportional "spring
		-- back to level" target for roll ALONE, only once the player's
		-- genuinely let go for AUTO_LEVEL_DELAY seconds, same "don't
		-- fight an active maneuver" reasoning the reference project's own
		-- version has. See level_roll_angle()'s own comment for why the
		-- sign here is the OPPOSITE of the reference project's own
		-- `torque.z - roll_angle*speed` - this hull's nose is at local
		-- +Z, not the reference's -Z, which flips which rotation SENSE
		-- around the forward axis counts as "banking right" (verified
		-- numerically via a standalone quaternion simulation before
		-- landing, not just re-derived by hand - flag if this ever needs
		-- re-checking, e.g. if SHIP_FORWARD's own sign ever changes).
		local roll_angle = level_roll_angle(rot)
		target_angular_velocity.z = math.max(-turn_speed_rad, math.min(turn_speed_rad, AUTO_LEVEL_SPEED * roll_angle))
	end

	local max_angular_delta = turn_accel_rad * dt
	for _, axis in ipairs({ "x", "y", "z" }) do
		local diff = target_angular_velocity[axis] - self.angular_velocity[axis]
		if diff > max_angular_delta then
			self.angular_velocity[axis] = self.angular_velocity[axis] + max_angular_delta
		elseif diff < -max_angular_delta then
			self.angular_velocity[axis] = self.angular_velocity[axis] - max_angular_delta
		else
			self.angular_velocity[axis] = target_angular_velocity[axis]
		end
	end

	local rotation_delta = vmath.quat_axis_angle(RIGHT, self.angular_velocity.x * dt)
		* vmath.quat_axis_angle(UP, self.angular_velocity.y * dt)
		* vmath.quat_axis_angle(SHIP_FORWARD, self.angular_velocity.z * dt)
	rot = vmath.normalize(rot * rotation_delta)
	go.set_rotation(rot)

	-- self.throttle is the CONTROL position (0..1, what the stick/lever is
	-- set to) - this ramp is how fast holding +/- moves that lever, same
	-- acceleration-derived rate as before (e.g. 10 m/sec^2 on a 52.5
	-- m/sec ship sweeps the lever 0 -> full in ~5.25 sec). Q/E (on_input)
	-- can still snap it straight to 0/1.0.
	local throttle_delta = (self.input.throttle_up and 1 or 0) - (self.input.throttle_down and 1 or 0)
	if throttle_delta ~= 0 then
		self.throttle = self.throttle + (acceleration / max_speed) * throttle_delta * dt
		self.throttle = math.max(0.0, math.min(1.0, self.throttle))
	end

	-- self.speed is the ACTUAL current speed - it always chases
	-- target_speed, accelerating/decelerating at the ship's own
	-- acceleration_m_per_sec2 (the same stat the lever ramp above uses),
	-- regardless of how abruptly the target itself moves - a plain
	-- move-toward-target bounded by acceleration*dt each frame, not an
	-- exponential lerp (acceleration is a constant rate, not a "close the
	-- gap by a fraction" one).
	--
	-- Boost (per direct instruction: "no matter what speed the ship is
	-- travelling at... boost [pushes] the ship to the boost maximum
	-- speed... [releasing] the speed should revert [to] what it was
	-- previous[ly]") is the ship's own absolute boost_speed_m_per_sec
	-- UNSCALED by throttle while held - not self.throttle*boost_speed
	-- (that earlier version only ever reached the full boost speed at
	-- full throttle, contradicting "no matter what speed"). Releasing it
	-- drops target_speed straight back to whatever the throttle lever
	-- alone commands (self.throttle*max_speed) - "what it was previous" -
	-- with self.speed easing back down/up to that the same
	-- acceleration-bounded way as any other target change.
	local target_speed = self.input.boost and boost_speed or (self.throttle * max_speed)
	local max_speed_delta = acceleration * dt
	local speed_delta = target_speed - self.speed
	if speed_delta > max_speed_delta then
		self.speed = self.speed + max_speed_delta
	elseif speed_delta < -max_speed_delta then
		self.speed = self.speed - max_speed_delta
	else
		self.speed = target_speed
	end

	local forward = vmath.rotate(rot, SHIP_FORWARD)
	local pos = go.get_position() + forward * self.speed * dt
	go.set_position(pos)
	msg.post("flight_hud#gui", "set_speed", { speed = self.speed })

	-- Currency (per direct instruction: "show the amount of currency for
	-- each resource that the player has") - same four main/session.lua
	-- getters main/outpost.gui_script's own refresh_currency() reads.
	msg.post("flight_hud#gui", "currency", {
		scrip = session.get_scrip(),
		water = session.get_water(),
		iron = session.get_iron(),
		hydrogen = session.get_hydrogen(),
	})

	-- FTL jump countdown - started by execute_jump() above (J key, or
	-- main/flight_map.gui's [JUMP] button), cancelable with K (see
	-- on_input's "dock" handler, which checks self.jumping first and
	-- refunds the spent Hydrogen). Unlike docking, nothing here cancels it
	-- automatically once started - there's no "drifted out of range"
	-- equivalent for a jump already underway. Reaching zero hands off to
	-- arrive_at_system() above. Ported technique from the reference
	-- project's own ship.script (§0).
	if self.jumping then
		self.jump_time_left = self.jump_time_left - dt
		if self.jump_time_left <= 0 then
			self.jumping = false
			local target = self.jump_target_system
			self.jump_target_system = nil
			self.jump_hydrogen_spent = 0 -- already spent, not refundable now that it's landed
			arrive_at_system(self, target)
			-- arrive_at_system() just teleported/reoriented the ship -
			-- refresh `pos`/`rot` (computed earlier this frame, now stale)
			-- so the docking check/radar post/chase-camera math below all
			-- use where the ship actually is now, not wherever it was a
			-- moment before landing.
			pos = go.get_position()
			rot = go.get_rotation()
		end
	end

	-- Docking (per direct instruction: only within DOCK_RANGE of the
	-- player's own faction's outpost) - K (on_input's "dock" case above)
	-- starts a DOCK_COUNTDOWN_SEC countdown; drifting back out of range
	-- mid-countdown cancels it rather than completing from wherever the
	-- ship happens to be once it elapses. Reaching zero hands off to the
	-- outpost menu via complete_dock() above - same "one script owns the
	-- transition" shape start_flight()'s own Launch hand-off uses, just
	-- reversed. Ported technique from the reference project's own
	-- ship.script (§0).
	local outpost_pos = FACTION_OUTPOST[session.get_faction()]
	self.near_outpost = outpost_pos and vmath.length(pos - outpost_pos) <= DOCK_RANGE or false
	if self.docking then
		if not self.near_outpost then
			self.docking = false
		else
			self.dock_time_left = self.dock_time_left - dt
			if self.dock_time_left <= 0 then
				complete_dock(self)
			end
		end
	end

	local dock_text = nil
	if self.jumping then
		dock_text = string.format("Jumping to %s in %d... [K] to cancel",
			star_systems.SYSTEMS[self.jump_target_system].name, math.ceil(self.jump_time_left))
	elseif self.docking then
		dock_text = string.format("Docking in %d...", math.ceil(self.dock_time_left))
	elseif self.near_outpost then
		dock_text = "Press [K] to dock"
	end
	msg.post("flight_hud#gui", "dock_prompt", { text = dock_text })

	-- Radar (per direct instruction: "each ship has its own visible
	-- range" / "a gooey that shows a radar indicating all ships within
	-- visible range") - visual_range above, NOT the longer
	-- sensor_range_m/"Dradis Range" main/data/ships.lua's own comment
	-- already distinguishes it from. `contacts` is always empty right now
	-- - there are no other ships anywhere in this project yet (no NPCs,
	-- no multiplayer) - but the radar display itself
	-- (main/flight_hud.gui's dot pool) and this message contract are both
	-- real and ready for whichever of those lands first, same
	-- "build the real system even though nothing populates it yet"
	-- footing main/data/asteroids.lua's own M.OVERRIDES already has.
	msg.post("flight_hud#gui", "contacts", { own_pos = pos, range = visual_range, contacts = {} })

	-- Chase camera - see this file's header comment for why position is
	-- derived from camera_rot rather than lerped independently, and for why
	-- camera_target_rot needs the extra YAW_180 (this hull's nose is at
	-- local +Z, but a Defold camera looks down its own local -Z - without
	-- the flip the camera would face away from the ship it's chasing).
	local camera_target_rot = rot * YAW_180
	if self.camera_rot == nil then
		self.camera_rot = camera_target_rot
	else
		local t = 1.0 - math.exp(-CAMERA_FOLLOW_SPEED * dt)
		self.camera_rot = vmath.slerp(t, self.camera_rot, camera_target_rot)
	end
	local camera_distance, camera_height = camera_distance_height(self.ship_id)
	local camera_pos = pos - vmath.rotate(self.camera_rot, CAMERA_FORWARD) * camera_distance
		+ vmath.rotate(self.camera_rot, UP) * camera_height
	go.set_position(camera_pos, "flight_camera")
	go.set_rotation(self.camera_rot, "flight_camera")
end
