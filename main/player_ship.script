-- Minimal flight-mode slice (plan.md §4's "Build flight mode" TODO - first
-- piece only, per direct instruction): a player ship that actually moves,
-- plus a third-person chase camera that follows it with a lerp delay.
-- Deliberately NOT real flight physics - simple kinematic pitch/yaw +
-- constant forward thrust, just enough to exercise and tune the camera.
-- Turning/acceleration/speed now read from ships.lua's real per-ship stats
-- (§2.1.1, see flight_stats() below) rather than flat placeholders - the
-- DEFAULT_* constants there are only a fallback for a ship with no `data`
-- block, same "flag as not final" footing as other placeholder numbers
-- elsewhere in this project (plan.md §4).
--
-- Both this game object ("player_ship") and the camera-only sibling
-- ("flight_camera", main/flight_camera.camera) are embedded directly in
-- main/main.collection, always enabled from load (same "always-on script,
-- gated by an internal active/flying flag" pattern outpost.gui_script and
-- main/ship_preview.script's off-world preview rigs already use) - the
-- outpost's Launch button (main/outpost.gui_script) posts "start_flight"
-- here to actually begin - see complete_dock() below for the reverse trip
-- (K near the player's own outpost, docking countdown, back to the
-- outpost menu).

local ships = require("main.data.ships")
local star_systems = require("main.data.star_systems")
local session = require("main.session")
local catalog = require("main.data.modules.catalog")
local network = require("main.network")
local remote_registry = require("main.remote_registry")
local asteroid_registry = require("main.asteroid_registry")
local asteroid_data = require("main.data.asteroids")
local skin_flight = require("main.skin_flight")
local profile = require("main.profile")
local audio = require("main.audio")

-- Two DIFFERENT "forward" concepts, deliberately kept separate - conflating
-- them into one shared FORWARD constant was a real bug, found via live
-- testing (per direct instruction: "the camera needs to be rotated 180
-- degrees and moved to the other end of the ship"):
--
-- 1. SHIP_FORWARD - this hull's own nose direction, an ASSET fact.
--    tools/build_sardine_model.py's own header comment is explicit the hull
--    is built "nose at +Z" - the opposite of the reference project's own
--    ship.script FORWARD constant (0,0,-1), which was wrongly copied
--    verbatim without checking. Used for movement only.
-- 2. CAMERA_FORWARD - Defold's own ENGINE convention that a camera looks
--    down its local -Z, unrelated to any particular ship's nose direction.
--    Used for the chase camera's position/rotation math only.
--
-- Since these two are opposite on this hull (+Z nose vs. a camera that
-- looks down -Z), the camera's rotation needs an extra 180-degree yaw
-- relative to the ship's own rotation - see camera_target_rot in update()
-- below - so that the camera's native "look down -Z" ends up pointing at
-- the ship's own +Z nose (i.e. at the ship), not away from it. Using the
-- ship's raw rotation for the camera directly (no 180 flip) is exactly what
-- caused the reported symptom: camera on the nose end looking backward at
-- the tail while the ship itself moved tail-first.
local SHIP_FORWARD = vmath.vector3(0, 0, 1)
local CAMERA_FORWARD = vmath.vector3(0, 0, -1)
local UP = vmath.vector3(0, 1, 0)
local RIGHT = vmath.vector3(1, 0, 0)
local YAW_180 = vmath.quat_axis_angle(UP, math.pi)

-- Auto-level assist (per direct instruction: "port" the reference
-- project's own bank/roll system - §0, mechanics not creative
-- expression). Measures how far the ship's CURRENT bank angle has
-- drifted from level (wings horizontal for its current heading), in
-- radians, so update()'s body-frame rotation block can apply a simple
-- proportional "spring back to zero" target once AUTO_LEVEL_DELAY has
-- passed with no pitch/yaw input. Ported from the reference's own
-- level_roll_angle() - same idea (derive a "level" right/up basis for the
-- ship's current forward, measure where its actual up vector sits within
-- that basis via atan2), but right_level's cross product ARGUMENT ORDER
-- is swapped (cross(UP, forward), not the reference's cross(forward, UP))
-- to match this hull's own +Z-forward convention (the reference's is
-- -Z) - verified this swap (and the correction sign in update() below)
-- numerically, not just re-derived by hand: cross(forward,UP) instead
-- would silently make the correction UNSTABLE (roll error growing
-- instead of shrinking) rather than throwing any error, so this was
-- checked against a small standalone Lua/Python simulation before
-- landing, not just symbolically.
local function level_roll_angle(rot)
	local forward = vmath.rotate(rot, SHIP_FORWARD)
	local right_level
	if math.abs(forward.y) < 0.999 then
		right_level = vmath.normalize(vmath.cross(UP, forward))
	else
		-- Degenerate only when forward is (near-)vertical, where "level"
		-- has no meaningful heading to measure roll against - freezes on
		-- the ship's own current right vector that one frame rather than
		-- producing a NaN from a zero-length cross product.
		right_level = vmath.rotate(rot, RIGHT)
	end
	local up_level = vmath.cross(forward, right_level)
	local up_world = vmath.rotate(rot, UP)
	return math.atan2(vmath.dot(up_world, right_level), vmath.dot(up_world, up_level))
end

-- Auto-level only kicks in this long after the player's last pitch/yaw
-- input (there's no manual roll key - see update()'s own comment) - give
-- an active maneuver room to bank into a turn without the assist fighting
-- it mid-turn, only easing the ship back level once they've actually let
-- go. AUTO_LEVEL_SPEED is the proportional "spring" strength (how much
-- target angular velocity per radian of roll error) - both flat
-- placeholder constants (matching the reference project's own
-- AUTO_LEVEL_DELAY/auto_level_speed go.property defaults, 3.0/2.0) since
-- main/data/ships.lua has no per-ship fields for either yet.
local AUTO_LEVEL_DELAY = 3.0
local AUTO_LEVEL_SPEED = 2.0

-- Which ship this slice flies - main/session.lua's own session.get_ship_id()
-- (whatever the player last selected at the outpost), falling back to the
-- same starting ship session.lua itself defaults to (M.STARTING_SHIP_ID,
-- not exported, so mirrored here as a literal) for the case flight somehow
-- starts before a ship is ever selected. Determines BOTH the stat block
-- (flight_stats()/camera_distance_height() below) AND which of
-- main/main.collection's 24 pre-embedded "model_<ship_id>_<faction>"
-- components (one per ships.lua chassis x faction skin - see
-- model_component_id()/start_flight()'s own enable/disable loop below) is
-- shown - previously always the Patrol Interceptor/Sardine model
-- regardless of what was actually purchased/selected, a real bug (per
-- direct instruction: "no matter what ship I purchase and select... I only
-- see the Sardine").
local DEFAULT_SHIP_ID = "patrol_interceptor"

-- main/main.collection's "player_ship" instance embeds one model component
-- per (ship_id, faction) combination in ships.lua, all named this way -
-- exactly one is enabled at a time (start_flight() below), the other 23
-- disabled, rather than trying to swap a single component's underlying
-- mesh at runtime (Defold's Model component doesn't expose that as a
-- settable resource property the way e.g. a Sprite's image can be
-- swapped) - same "pre-instantiate every possibility, toggle visibility"
-- shape main/outpost.gui_script's own ship-preview rigs already use for
-- the exact same reason, just via component enable/disable here instead
-- of camera targeting.
-- Enters `system_id`'s server match (main/network.lua) once the server has
-- caught up: the launch / jump arrival that put us there is a queued
-- progress change (main/profile.lua), and the server only lets players into
-- the system its copy says they're in. Skipped if we've moved on meanwhile.
local function enter_system_when_synced(self, system_id)
	profile.flush(function()
		if self.flying and self.current_system_id == system_id then
			network.enter_system(system_id)
		end
	end)
end

local function model_component_id(ship_id, faction)
	return "model_" .. ship_id .. "_" .. faction
end

-- Outposts come from main/data/star_systems.lua's outpost_position(): each
-- faction's outpost sits in its own corner of every system where it has one
-- (large systems included; per-system overrides allowed there). The one
-- accord_outpost / swarm_outpost object pair in main/main.collection is
-- moved there on every system change (place_outposts() below), and hidden
-- in systems where that faction has no outpost, or while it's destroyed
-- (the server's state, main/network.lua outpost_state).
local OUTPOST_FACTIONS = { "accord", "swarm" }

-- `faction`'s outpost in `system_id` as a vector3, or nil if it has none
-- or it's currently destroyed.
local function outpost_position(system_id, faction)
	local p = system_id and star_systems.outpost_position(system_id, faction)
	if not (p and session.outpost_available(system_id, faction)) then
		return nil
	end
	return vmath.vector3(p.x, p.y, p.z)
end

local function place_outposts(system_id)
	for _, faction in ipairs(OUTPOST_FACTIONS) do
		local id = "/" .. faction .. "_outpost"
		local pos = outpost_position(system_id, faction)
		if pos then
			go.set_position(pos, id)
			msg.post(id, "enable")
		else
			msg.post(id, "disable")
		end
	end
end

-- Ambient lighting (per direct instruction: "increase the general ambient
-- light in all the systems"). /builtins/materials/model.material's
-- compiled fragment shader (extracted and read directly from the build
-- output - build/default/_generated_b1605dbb.spc, the only way to see its
-- actual source, since it's a Defold builtin with no .fp file in this
-- project's own tree) is:
--   out_fragColor = (texture_color * tint.rgb * tint.a)
--                    * clamp(max(dot(normal, light_dir), 0.0) + 0.2, 0, 1)
-- The 0.2 ambient floor is a FIXED CONSTANT BAKED INTO THE COMPILED
-- SHADER, not a uniform - `light` (a world-space position, already used
-- above for crude sun-direction faking) and `tint` are the ONLY two
-- constants actually exposed to go.set (confirmed by the compiled
-- material's own reflection data: mtx_worldview/mtx_view/mtx_proj/
-- mtx_normal/light/tint/tex0 - no separate "ambient"). Scaling `light`
-- does nothing for this purpose either - it only ever feeds a
-- normalize()'d direction, so its magnitude is irrelevant, only its
-- direction is. `tint` is consequently the only real lever: a flat
-- multiply applied to the texture BEFORE the light factor, so raising it
-- brightens the ambient-only (unlit-facing) 0.2 floor right along with
-- the fully-lit 1.0 side (the latter simply clips back down at the
-- framebuffer, same visual effect a genuinely higher ambient floor would
-- have). 1.4 is a moderate, clearly-noticeable placeholder multiplier,
-- not a lighting-design decision (plan.md §4) - applied to every model
-- component this project ever renders during flight (this file's own
-- ship hulls below, main/asteroid_hub.script's spawned asteroids,
-- main/ambient_lit.script's outposts) so the boost reads as one
-- consistent scene-wide change, not just brighter ships.
local AMBIENT_TINT = vmath.vector4(1.4, 1.4, 1.4, 1.0)

-- Shows the equipped skin on the visible model component (main/skin_flight.lua:
-- recolors swap its texture, surface themes spawn their own model on this
-- ship). One skin_flight state per model component, created the first time
-- that ship is flown so it remembers the component's own texture.
local SHIP_LIGHT_POS = vmath.vector4(4000, 6000, 4000, 1.0)

local function apply_skin(self)
	local id = self.model_component_id
	if not self.skin_states[id] then
		self.skin_states[id] = skin_flight.new_state(go.get_id(), msg.url("#" .. id), function(model)
			go.set(model, "light", SHIP_LIGHT_POS)
			go.set(model, "tint", AMBIENT_TINT)
		end)
	end
	self.skin_state = self.skin_states[id]
	skin_flight.show(self.skin_state, session.get_equipped_skin(self.ship_id), self.ship_id, session.get_faction())
end


-- Docking (per direct instruction): a ship may dock within DOCK_RANGE of
-- its own faction's outpost in whatever system it's in. Launching and
-- arriving from a jump both put it at a random point on the surface of a
-- LAUNCH_DISTANCE sphere around that outpost (or around the system centre
-- where its faction has no outpost), facing the system centre - see
-- arrival_spawn()/update()'s docking block below. LAUNCH_DISTANCE is beyond
-- DOCK_RANGE, so a freshly arrived ship has to fly in before it can dock.
local DOCK_RANGE = 1000
local LAUNCH_DISTANCE = 1200
local DOCK_COUNTDOWN_SEC = 5

-- FTL jump (per direct instruction: "implement [the SuperShips jump
-- mechanic] here" - see the SuperShips research findings this ports).
-- COMBAT_JUMP_MULTIPLIER quadruples charge time while self.in_combat -
-- an inert, documented hook, not enforced: there's no weapon-fire system
-- in this project yet to ever set self.in_combat true, same "flag as a
-- future hook rather than pretend to enforce it" footing the reference
-- project's own identical constant has (§0).
local COMBAT_JUMP_MULTIPLIER = 4

-- Transform broadcasts to main/network.lua's current room use dead
-- reckoning: remote clients extrapolate each ship along its heading at its
-- last reported speed (main/remote_ships.script), so an update is only sent
-- when this ship has drifted from that prediction - turning, changing speed,
-- or jumping - plus a keep-alive while it cruises straight or sits still.
-- NETWORK_SEND_INTERVAL caps the rate at 5Hz; server fan-out grows with the
-- square of the players in a system, so every skipped update counts.
local NETWORK_SEND_INTERVAL = 0.2
local NETWORK_KEEPALIVE_INTERVAL = 1.0
local NETWORK_POS_TOLERANCE = 1.0 -- metres from the predicted position
local NETWORK_SPEED_TOLERANCE = 0.5 -- m/sec
-- cos(half of 2 degrees): quaternion dot product below this = turned >2 deg
local NETWORK_ROT_TOLERANCE_COS = math.cos(math.rad(2) / 2)

-- True if this ship has drifted far enough from where remote clients are
-- predicting it (last sent position + heading * speed * time since) that
-- they need a fresh update.
local function network_state_changed(self, pos, rot)
	if not self.net_sent_pos then
		return true
	end
	if math.abs(self.speed - self.net_sent_speed) > NETWORK_SPEED_TOLERANCE then
		return true
	end
	local sent = self.net_sent_rot
	local dot = math.abs(rot.x * sent.x + rot.y * sent.y + rot.z * sent.z + rot.w * sent.w)
	if dot < NETWORK_ROT_TOLERANCE_COS then
		return true
	end
	local predicted = self.net_sent_pos
		+ vmath.rotate(sent, SHIP_FORWARD) * self.net_sent_speed * self.network_since_sent
	return vmath.length(pos - predicted) > NETWORK_POS_TOLERANCE
end

-- Uniform-on-sphere-surface point at `radius` around
-- outpost_pos, facing the system origin from there - same
-- acos(2u-1)-for-polar-angle technique main/data/asteroids.lua already
-- uses to avoid bunching at the poles (there it's for a filled ball; here
-- radius is fixed, only the direction is randomized). Rotation technique
-- (quat_from_to with a same-axis fallback for the exactly-opposite case,
-- which quat_from_to can't itself handle - it returns NaN) is ported from
-- the reference project's own random_spawn() (§0).
local function random_spawn(outpost_pos, radius)
	local theta = math.acos(2 * math.random() - 1)
	local phi = math.random() * 2 * math.pi
	local offset = vmath.vector3(
		radius * math.sin(theta) * math.cos(phi),
		radius * math.cos(theta),
		radius * math.sin(theta) * math.sin(phi))
	local pos = outpost_pos + offset

	local to_center = -pos
	local rot
	if vmath.length(to_center) < 0.0001 then
		rot = vmath.quat()
	else
		local dir = vmath.normalize(to_center)
		if vmath.dot(SHIP_FORWARD, dir) < -0.9999 then
			rot = vmath.quat_axis_angle(UP, math.pi)
		else
			rot = vmath.quat_from_to(SHIP_FORWARD, dir)
		end
	end
	return pos, rot
end

-- Where a ship appears in `system_id` after launching or jumping in:
-- LAUNCH_DISTANCE from its faction's outpost there (or from the system
-- centre if its faction has no outpost), facing the system centre.
local function arrival_spawn(system_id, faction)
	return random_spawn(outpost_position(system_id, faction) or vmath.vector3(), LAUNCH_DISTANCE)
end

-- Turning/acceleration/speed now read from this ship's own real stat block
-- (main/data/ships.lua's `data` table, plan.md §2.1.1's Engine Systems -
-- previously flat placeholders here, per direct instruction: the Patrol
-- Interceptor "should do more than 20 m/s"). DEFAULT_* below only cover
-- the case the selected ship_id ever points at a ship with no `data` block
-- yet - same fallback shape as camera_distance_height()'s own DEFAULT pair.
local DEFAULT_TURN_SPEED_DEG = 60
local DEFAULT_TURN_ACCELERATION_DEG = 60 -- deg/sec^2, how fast pitch/yaw ramp up to turning_speed_deg_per_sec - see update()'s body-frame rotation block
local DEFAULT_MAX_SPEED = 20 -- m/sec, unboosted
local DEFAULT_BOOST_SPEED = 40 -- m/sec, boosted
local DEFAULT_ACCELERATION = 12 -- m/sec^2, how fast throttle ramps the actual speed
local DEFAULT_VISUAL_RANGE = 500 -- m, radar range - see update()'s "contacts" block below
local DEFAULT_FTL_RANGE = 4.5 -- ly, matches patrol_interceptor's own ftl_range_ly - converted to star_systems.lua's own map-unit scale via M.ly_to_map_units() at each use site below (toggle_map()/on_message's "set_jump_preset" handler), not compared directly

local DEFAULT_JUMP_TIMER_SEC = 15 -- sec, fallback for a ship with no ftl_charge_sec of its own - matches the reference project's own DEFAULT_JUMP_TIMER_SEC (§0)

local function flight_stats(ship_id)
	local ship = ships.SHIPS[ship_id]
	local d = ship and ship.data
	return
		(d and d.turning_speed_deg_per_sec) or DEFAULT_TURN_SPEED_DEG,
		(d and d.speed_m_per_sec) or DEFAULT_MAX_SPEED,
		(d and d.boost_speed_m_per_sec) or DEFAULT_BOOST_SPEED,
		(d and d.acceleration_m_per_sec2) or DEFAULT_ACCELERATION,
		(d and d.visual_range_m) or DEFAULT_VISUAL_RANGE,
		(d and d.ftl_range_ly) or DEFAULT_FTL_RANGE,
		(d and d.ftl_charge_sec) or DEFAULT_JUMP_TIMER_SEC,
		(d and d.turning_acceleration_deg_per_sec2) or DEFAULT_TURN_ACCELERATION_DEG
end

-- Chase camera - ported subset (chase mode only; the reference project's
-- front/target-view modes aren't built here, not asked for) of
-- ~/Defold/SuperShips/main/ship.script's own chase-camera math (§0 - UX/
-- mechanics technique, not creative expression). Two key ideas carried
-- over directly from that file's own header comment on this exact logic:
-- (1) frame-rate-independent lag via `1 - exp(-speed*dt)`, not a fixed
-- per-frame lerp fraction; (2) camera POSITION is derived from the
-- already-lagged ROTATION each frame, not lerped on its own - lerping
-- position independently would cut a straight chord across a sustained
-- turn instead of swinging around it, so the camera would visibly drift
-- off-axis mid-turn even while correctly converging on the final target.
--
-- `distance`/`height` are per-ship-chassis now (plan.md §2.10.1, per direct
-- instruction - "each ship chassis will have its own coordinates/zoom for
-- where the camera should be looking from"): main/data/ships.lua's
-- `flight_camera` field, falling back to this DEFAULT pair (still the old
-- hand-picked values) for any ship with no entry of its own yet.
local CAMERA_DEFAULT_DISTANCE = 12
local CAMERA_DEFAULT_HEIGHT = 4
local CAMERA_FOLLOW_SPEED = 3.0

-- How fast Y's Follow Friend eases heading toward pure pursuit of its
-- target each frame (update()'s follow_friend rotation block) - same
-- shape/purpose as CAMERA_FOLLOW_SPEED above, just for the ship's own
-- heading instead of the chase camera's. Same default value as the source
-- project's own go.property("autopilot_response", 2.0) (§0).
local AUTOPILOT_RESPONSE = 2.0

local function camera_distance_height(ship_id)
	local ship = ships.SHIPS[ship_id]
	local fc = ship and ship.flight_camera
	return (fc and fc.distance) or CAMERA_DEFAULT_DISTANCE, (fc and fc.height) or CAMERA_DEFAULT_HEIGHT
end

-- Throttle (target speed as a fraction of max speed) starts at 0 on game
-- load and on every launch from an outpost, so the ship sits still until the
-- player throttles up - throttle_up/throttle_down (input/game.input_binding's
-- =/- and numpad +/-) move it, stop_throttle (Q) zeroes it, and
-- full_throttle (E) snaps it to 1.0 - see update()'s throttle
-- handling below.
local function default_input()
	return {
		pitch_up = false, pitch_down = false, yaw_left = false, yaw_right = false, boost = false,
		throttle_up = false, throttle_down = false,
	}
end

function init(self)
	self.flying = false
	self.input = default_input()
	self.throttle = 0.0
	self.speed = 0 -- actual current speed (m/sec) - see update()'s acceleration-bounded lerp toward target_speed below
	self.engine_sound_on = false -- whether the engine loop is currently playing - see set_engine_sound()
	self.angular_velocity = vmath.vector3() -- rad/sec, local axes (x=pitch, y=yaw, z=roll) - see update()'s body-frame rotation block
	self.time_since_rotation_input = 0 -- seconds since the last pitch/yaw input - see AUTO_LEVEL_DELAY
	self.camera_rot = nil -- nil = "snap on next update", same convention the reference uses
	self.near_outpost = false
	self.docking = false
	self.dock_time_left = 0
	self.map_open = false
	self.jump_preset_system = nil
	self.jumping = false
	self.jump_time_left = 0
	self.jump_target_system = nil
	self.jump_hydrogen_spent = 0 -- refunded if K cancels the countdown - see on_input's "dock" handler
	self.in_combat = false -- see COMBAT_JUMP_MULTIPLIER's own comment - always false, nothing sets this true yet
	self.current_system_id = nil
	self.ship_id = nil -- resolved from session.get_ship_id() in start_flight() - not known yet here (faction/ship selection hasn't happened this early)
	self.model_component_id = nil
	self.skin_states = {} -- model component id -> main/skin_flight.lua state, see apply_skin()
	self.skin_state = nil -- the one for the ship currently flown
	self.network_send_timer = 0
	self.network_since_sent = 0
	self.net_sent_pos = nil -- last broadcast state (nil = send on the next check) - see network_state_changed()
	self.net_sent_rot = nil
	self.net_sent_speed = 0
	self.firing = false -- switched-on weapons are firing at the target (update_firing)
	self.fire_order = nil -- the fire order last sent to the server
	self.fire_match = nil
	self.weapons_on = {}
	-- Per-slot end time (socket.gettime() clock) of an active module's
	-- running effect, e.g. the Asteroid Analyser's scan window - the
	-- flight HUD's ship diagram shows those slots "live" until then (see
	-- slot_states below).
	self.module_live_until = {}
	self.shift_held = false
	-- The server's outpost state for our system: hide destroyed outposts,
	-- show returned ones. Socket callbacks run outside this script's
	-- context (no go.* there), so update() does the re-placing.
	self.outposts_changed = false
	network.set_outposts_callback(function(system_id)
		if system_id == self.current_system_id then
			self.outposts_changed = true
		end
	end)
	self.target_id = nil -- currently-targeted remote user_id (any ship, friend or foe - see cycle_target()/target_nearest_enemy() above), or nil
	self.follow_friend = false -- Y's Follow Friend - see update()'s targeting/movement block
	msg.post("flight_camera#camera", "disable")
end

-- Defined with the weapons further down; start_flight shows it on launch.
local show_hotkeys

local function start_flight(self)
	self.flying = true
	self.input = default_input()
	self.throttle = 0.0
	self.speed = 0 -- ship starts at rest and stays there until the player throttles up - see update()
	self.engine_sound_on = false -- a fresh launch always starts at rest, so the engine loop is silent - see set_engine_sound()
	self.angular_velocity = vmath.vector3()
	self.time_since_rotation_input = 0
	self.camera_rot = nil
	self.near_outpost = false
	self.docking = false
	self.dock_time_left = 0
	self.map_open = false
	-- self.jump_preset_system is deliberately NOT reset here - same
	-- "survives everything except actually being consumed/reselected"
	-- persistence the source project's own version describes.
	self.jumping = false
	self.jump_time_left = 0
	self.jump_target_system = nil
	self.jump_hydrogen_spent = 0
	self.in_combat = false
	self.network_send_timer = 0
	self.network_since_sent = 0
	self.net_sent_pos = nil -- broadcast this launch straight away
	self.target_id = nil
	self.follow_friend = false
	self.firing = false
	self.fire_order = nil
	-- Every fitted weapon starts switched on (Shift+n toggles it).
	self.weapons_on = {}
	for _, entry in ipairs(session.get_loadout() or {}) do
		if entry.slot:sub(1, 1) == "W" then
			self.weapons_on[entry.slot] = true
		end
	end
	show_hotkeys(self)

	-- Which of main/main.collection's 24 pre-embedded model components to
	-- show (per direct instruction: the ship actually flown must match
	-- whatever's purchased/selected, not always the Patrol Interceptor) -
	-- see model_component_id()'s own comment above for why toggling
	-- enabled state on 24 pre-built components, not a runtime mesh swap.
	local faction = session.get_faction()
	session.launch() -- flights start in the home system (see self.current_system_id below)
	self.ship_id = session.get_ship_id() or DEFAULT_SHIP_ID
	self.model_component_id = model_component_id(self.ship_id, faction)
	-- Drop the previous flight's skin first, so its model component's
	-- re-enable can't undo the enable/disable pass below.
	if self.skin_state then
		skin_flight.clear(self.skin_state)
	end
	for ship_id, _ in pairs(ships.SHIPS) do
		for _, f in ipairs({ "accord", "swarm" }) do
			local id = model_component_id(ship_id, f)
			msg.post("#" .. id, (id == self.model_component_id) and "enable" or "disable")
		end
	end
	apply_skin(self)

	-- `light` is a world-space POINT LIGHT POSITION on model.material (see
	-- main/ship_preview.script's own header comment on this exact constant),
	-- not a color - model.material's
	-- undocumented DEFAULT of (1,1,1,1) is a light sitting almost exactly where
	-- the ship spawns, which rendered near-black. A large fixed offset acts as a
	-- crude stand-in directional light for this minimal slice - real lighting
	-- design (sun direction, ambient, etc.) is plan.md §4 territory, not solved here.
	-- Set on the CURRENTLY VISIBLE model component specifically, not a
	-- fixed "#model" (only ever true back when there was exactly one).
	go.set("#" .. self.model_component_id, "light", SHIP_LIGHT_POS)
	-- `tint` (per direct instruction: "increase the general ambient light
	-- in all the systems") - see AMBIENT_TINT's own comment above for why
	-- this, not `light`, is the lever that actually reaches the shader's
	-- fixed 0.2 ambient floor.
	go.set("#" .. self.model_component_id, "tint", AMBIENT_TINT)

	-- Flights start in the system whose outpost the player is docked at
	-- (session.launch() above picked it: the current system if their faction
	-- has an outpost there, otherwise home). Stored on self so
	-- toggle_map()/on_input can reach it later in the flight.
	self.current_system_id = session.get_current_system()
	place_outposts(self.current_system_id)
	local pos, rot = arrival_spawn(self.current_system_id, faction)
	go.set_position(pos)
	go.set_rotation(rot)
	msg.post(".", "acquire_input_focus")
	msg.post("flight_camera#camera", "enable")
	msg.post("flight_hud#gui", "show_flight_hud")

	msg.post("asteroid_hub#script", "spawn_field", { system_id = self.current_system_id })
	msg.post("flight_hud#gui", "system_changed", { text = "SYSTEM: " .. star_systems.SYSTEMS[self.current_system_id].name })
	-- Realtime presence: join this system's match.
	enter_system_when_synced(self, self.current_system_id)
end

-- Makes `system_id` the player's current system after a jump - the
-- Galaxy-appropriate slice of the reference project's own apply_system()
-- (§0): moves the outposts to this system's positions (place_outposts),
-- repositions the ship (arrival_spawn), respawns the asteroid field,
-- updates the HUD's system name and switches to the system's match. Called
-- from update() when a jump's countdown completes. Docking then works at our
-- faction's outpost here, if we have one (see update()'s docking block).
local function arrive_at_system(self, system_id)
	self.current_system_id = system_id
	self.target_id = nil
	self.firing = false -- the old system's match stops our fire as we leave it
	self.fire_order = nil
	place_outposts(system_id)
	-- Same rule as launching: LAUNCH_DISTANCE from our faction's outpost in
	-- the new system (or from its centre if we have none there), facing
	-- the centre.
	local pos, rot = arrival_spawn(system_id, session.get_faction())
	go.set_position(pos)
	go.set_rotation(rot)
	self.camera_rot = nil -- snap the chase camera to the new position/rotation instead of slerping from wherever it was before the jump (same convention start_flight() already uses for the exact same "ship just teleported" case)

	msg.post("asteroid_hub#script", "spawn_field", { system_id = system_id })
	msg.post("flight_hud#gui", "system_changed", { text = "SYSTEM: " .. star_systems.SYSTEMS[system_id].name })
	-- Leave the old system's match and join the new one, so players in
	-- different systems don't see each other (main/network.lua).
	enter_system_when_synced(self, system_id)
end

-- Mirror image of start_flight() - returns to the outpost menu the same
-- way Launch left it (main/outpost.gui_script's "show_outpost" handler
-- already does the "reset to Overview tab, refresh currency/ship text"
-- work, same as when faction_select first hands off there). Called once
-- update()'s docking countdown reaches zero, see below.
-- The ship's engine hum (main/main.collection's "engine_sound" component,
-- assets/audio/engine_loop.sound), looped while the engines are producing
-- THRUST - not while the ship is moving (per direct instruction: "the engine
-- is providing not the speed of the ship itself. So once the thrust has been
-- set to 0 the engine noise should stop even if the ship is still slowing
-- down"). The call site passes the COMMANDED speed (target_speed: the throttle
-- lever, boost, or Follow Friend's speed-matching) rather than self.speed, so
-- cutting thrust to 0 silences the loop immediately while the ship coasts down
-- to a stop under its own deceleration. Also stopped on dock and on being
-- destroyed (both route through complete_dock). Guarded by self.engine_sound_on
-- so sound.play()/sound.stop() only cross a frame boundary when the state
-- actually changes.
local ENGINE_MIN_THRUST = 0.01 -- m/sec of commanded speed; below this the engines are idle

-- Pitch scales with THRUST LEVEL rather than a fixed offset (per direct
-- instruction: "scale the engine pitch with thrust level"). Thrust level is the
-- commanded speed as a fraction of the ship's unboosted top speed, so the pitch
-- rises smoothly from the recorded 1.0 at idle to 1 + ENGINE_PITCH_MAX (1.2, i.e.
-- +20%) at full throttle, then holds there under boost - boost commands above
-- max_speed, so the fraction is clamped. There's no sound.set_speed(), but
-- `speed` is a component property and the engine retunes live voices when it
-- changes (verified against 1.13.1's comp_sound.cpp,
-- SoundSetParameter/PARAMETER_SPEED), so this is written with go.set via
-- main/audio.lua's M.set_speed and can follow the throttle every frame.
local ENGINE_PITCH_MAX = 0.2

-- Commanded speed as a 0..1 fraction of the unboosted top speed. Clamped, so
-- boost (above max_speed) sits at the same ceiling as full throttle.
local function thrust_level(target_speed, max_speed)
	if not max_speed or max_speed <= 0 then
		return 0
	end
	return math.max(0, math.min(1, target_speed / max_speed))
end

-- How far astern the engine loop's origin sits, in metres, along the ship's
-- own -Z (SHIP_FORWARD is +Z, so the stern is -forward). PLACEHOLDER
-- (plan.md §4) - roughly the stern of the current Patrol hull rather than a
-- per-ship value; a real per-chassis origin belongs in ships.lua next to
-- `flight_camera` and `slot_positions`.
local ENGINE_ORIGIN_OFFSET = 6

-- Where a ship-local (x, z) offset sits in the world, given the ship's
-- position and rotation. Ship-local axes: +z = bow, +x = starboard, +y = up
-- - the same convention ships.lua's own slot_positions table uses.
local function ship_local_to_world(pos, rot, local_x, local_z)
	local forward = vmath.rotate(rot, SHIP_FORWARD)
	local right = vmath.rotate(rot, RIGHT)
	return pos + right * local_x + forward * local_z
end

local function engine_origin(self, pos, rot)
	pos = pos or go.get_position()
	rot = rot or go.get_rotation()
	return ship_local_to_world(pos, rot, 0, -ENGINE_ORIGIN_OFFSET)
end

-- `level` is the thrust level (0..1, see thrust_level above): 0 means idle.
-- Called every frame, so it both starts/stops the loop on the idle boundary and
-- keeps the pitch following the throttle while it runs.
local function set_engine_sound(self, level)
	local on = level > 0
	if on ~= self.engine_sound_on then
		self.engine_sound_on = on
		if on then
			-- Positioned at the STERN (per direct instruction: "the engine
			-- movement sound should be localised to the rear of the ship"), not
			-- the ship's centre - so with the stock chase camera (looking at the
			-- stern) it reads as centred-and-behind, and from any future camera
			-- angle it still comes from where the engines actually are. The
			-- offset is re-applied every frame in update() as the ship turns.
			audio.play_loop("#engine_sound", engine_origin(self), { attenuate = false })
		else
			-- Thrust cut: restore the recorded pitch before stopping, so the next
			-- activation starts clean rather than inheriting a raised value.
			audio.set_speed("#engine_sound", 1)
			audio.stop_loop("#engine_sound")
		end
	end
	if on then
		-- Follow the throttle: +ENGINE_PITCH_MAX at full thrust, unity at idle.
		audio.set_speed("#engine_sound", 1 + ENGINE_PITCH_MAX * level)
	end
end

local function complete_dock(self)
	set_engine_sound(self, 0) -- engines off before the ship leaves flight
	network.leave_system() -- docked ships leave the system's match (which stops any fire)
	self.firing = false
	self.fire_order = nil
	msg.post("flight_hud#gui", "hotkeys", { text = nil })
	self.flying = false
	self.docking = false
	self.dock_time_left = 0
	if self.map_open then
		self.map_open = false
		msg.post("flight_map#gui", "toggle", { open = false })
	end
	msg.post("flight_camera#camera", "disable")
	msg.post("flight_hud#gui", "hide_flight_hud")
	msg.post("outpost#gui", "show_outpost")
end

-- The ship was destroyed: the player respawns at the outpost screen, which
-- (like docking and quitting) is session.docked_system() - this system's
-- outpost if their faction has one here, otherwise their home system's.
-- The next launch starts there (session.launch(), also on the server).
-- Nothing sends "ship_destroyed" yet; combat will.
local function ship_destroyed(self)
	if not self.flying then
		return
	end
	self.jumping = false -- an unfinished jump is refunded by the next launch
	self.jump_target_system = nil
	self.jump_hydrogen_spent = 0
	complete_dock(self)
end

-- Shared by on_input's "toggle_map" key (N) handler below - flight_map.gui_script
-- owns showing/hiding itself and acquiring its own input focus while open
-- (see that file), this just flips the shared flag and tells it to react.
-- Ported technique from the reference project's own ship.script
-- toggle_map() (§0).
local function toggle_map(self)
	if self.jumping then
		-- mid-countdown - nothing to browse, and there's no [X]/close
		-- affordance needed since the map can't be open right now anyway
		-- (execute_jump() below force-closes it the moment the countdown
		-- starts) - matches the reference project's own toggle_map() guard.
		return
	end
	self.map_open = not self.map_open
	local _, _, _, _, _, ftl_range_ly = flight_stats(self.ship_id)
	msg.post("flight_map#gui", "toggle", {
		open = self.map_open,
		current_system_id = self.current_system_id,
		ftl_range = star_systems.ly_to_map_units(ftl_range_ly), -- flight_map.gui_script/star_systems.in_ftl_range both work in map units, not light-years
		preset_system_id = self.jump_preset_system, -- lets flight_map.gui_script re-highlight whatever's already armed when reopening, rather than forgetting it visually
	})
end

-- Actually starts the FTL countdown for whatever's currently armed in
-- self.jump_preset_system - shared by the J key (on_input below) and
-- main/flight_map.gui's [JUMP] button (via on_message's
-- "execute_jump_preset" below), same "preset selects, J/[JUMP] commits"
-- split the sector map's own header comment describes. No-ops quietly if
-- nothing's armed, a jump is already underway, or docking is (can't do
-- both at once) - all easy to hit legitimately (J out of habit with
-- nothing preset, or twice in a row), matching the reference project's
-- own execute_jump_preset() (§0). Re-validates independently rather than
-- trusting whatever armed the preset (same reasoning as on_message's
-- "set_jump_preset" handler).
local function execute_jump(self)
	if self.jumping or self.docking or not self.jump_preset_system then
		return
	end
	local faction = session.get_faction()
	if not star_systems.can_enter(self.jump_preset_system, faction) then
		self.jump_preset_system = nil
		return
	end
	local dist = self.current_system_id and star_systems.distance(self.current_system_id, self.jump_preset_system)
	local _, _, _, _, _, ftl_range_ly, ftl_charge_sec = flight_stats(self.ship_id)
	if not star_systems.in_ftl_range(dist, star_systems.ly_to_map_units(ftl_range_ly)) then
		return
	end
	-- Hydrogen is real fuel: session.start_jump() prices the jump from the
	-- saved current system and spends it (the server re-checks the same rule
	-- - nakama-server/modules/economy.lua). nil = not allowed or can't afford.
	local cost = session.start_jump(self.jump_preset_system)
	if not cost then
		return
	end

	self.jumping = true
	self.jump_time_left = ftl_charge_sec * (self.in_combat and COMBAT_JUMP_MULTIPLIER or 1)
	self.jump_target_system = self.jump_preset_system
	self.jump_hydrogen_spent = cost
	self.jump_preset_system = nil
	msg.post("flight_hud#gui", "jump_preset", { text = nil })

	if self.map_open then
		self.map_open = false
		msg.post("flight_map#gui", "toggle", { open = false })
	end
end

-- Targeting (per direct instruction: "search superships for all references
-- to target. Implement what you find") - ported from
-- ~/Defold/SuperShips/main/ship.script (§0). input/game.input_binding
-- already declared every one of these actions (cycle_target/TAB,
-- target_nearest_enemy/X, cancel_target/C, match_speed/T, follow_friend/Y,
-- target_nearest_missile/Z, track_target/right-click) when the whole
-- control scheme was ported wholesale, well before flight mode itself was
-- built - none of them were ever wired to a handler until now, and none of
-- those keys collide with anything Galaxy's own flight controls (WASD/
-- arrows, +/-/Q/E, Space, K, J, N) use, so there's no key-binding
-- discrepancy to flag.
--
-- Deliberately NOT ported: right-click's own track_target/Target Tracking
-- pivot (needs a screen-to-world mouse raycast against remote ships -
-- Galaxy's flight camera has no picking utility of any kind yet, unlike
-- the source project, and everything else in Galaxy's own flight mode is
-- keyboard-only - see main/player_ship.script's own header comment), V's
-- target-view camera mode (a separate camera-cycle feature, not itself a
-- "target" mechanic - V/camera_cycle isn't wired to anything else yet
-- either), and Z's target_nearest_missile (kept as the source project's own
-- honest no-op - Galaxy has no missile/projectile entity, same as there).
-- All are pre-existing, unrelated gaps, not new discrepancies this task
-- introduced.
--
-- Targeting (BSGO's controls): Tab cycles through everything targetable
-- within the ship's sensor range, nearest first; X targets the nearest
-- enemy, F1 the nearest friendly, C cancels, and a left-click targets
-- whatever is under the cursor. Targetable: other players' ships, both
-- factions' outposts and asteroids. The target is marked on screen
-- (main/flight_hud.gui_script) and described in the top-middle panel.
--
-- Target ids: a ship's user_id, "outpost:<faction>" (also the server's FIRE
-- target) or "asteroid:<index>" (main/asteroid_registry.lua).
local OUTPOST_TARGET_PREFIX = "outpost:"
local ASTEROID_TARGET_PREFIX = "asteroid:"
local DEFAULT_SENSOR_RANGE = 3000 -- m, for a ship without its own sensor_range_m
local SHIP_RADIUS = 15 -- m, rough size of a ship for clicking and the marker
local OUTPOST_RADIUS = 150 -- m, same for an outpost
local CLICK_MIN_RADIUS = 28 -- px: small or distant objects are still easy to click
local FACTION_NAMES = { accord = "Accord", swarm = "Swarm" }

-- The flight camera's projection (main/flight_camera.camera), for putting
-- world positions on screen.
local CAMERA_FOV = 0.7
local CAMERA_ASPECT = 1.7778
local CAMERA_NEAR, CAMERA_FAR = 0.5, 20000
local SCREEN_W, SCREEN_H = 1920, 1080 -- game.project display size (GUI and input coordinates)

local function with_commas(n)
	local formatted = tostring(math.floor(n)):reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (formatted:gsub("^,", ""))
end

local function outpost_target_faction(target_id)
	return target_id and target_id:sub(1, #OUTPOST_TARGET_PREFIX) == OUTPOST_TARGET_PREFIX
		and target_id:sub(#OUTPOST_TARGET_PREFIX + 1) or nil
end

local function asteroid_target_index(target_id)
	return target_id and target_id:sub(1, #ASTEROID_TARGET_PREFIX) == ASTEROID_TARGET_PREFIX
		and tonumber(target_id:sub(#ASTEROID_TARGET_PREFIX + 1)) or nil
end

local function sensor_range(ship_id)
	local ship = ships.SHIPS[ship_id]
	return (ship and ship.data and ship.data.sensor_range_m) or DEFAULT_SENSOR_RANGE
end

local function asteroid_target(a)
	local resource = a.analysed and asteroid_data.RESOURCE_BY_ID[a.resource]
	return {
		id = ASTEROID_TARGET_PREFIX .. a.index, pos = a.pos, radius = a.radius, kind = "asteroid",
		index = a.index,
		-- Only known (and shown) once analysed, like the resource itself.
		resource_amount = resource and asteroid_data.resource_amount(a.resource, a.radius * 2) or nil,
		relation = "neutral", name = resource and ("Asteroid: " .. resource.name) or "Asteroid (not analysed)",
	}
end

-- The target `id` as { id, pos, radius, kind, relation, name, faction,
-- destroyed }, or nil if it's gone. An outpost stays a target while it's
-- destroyed (the panel says when it returns).
local function resolve_target(self, id)
	if not id then
		return nil
	end
	local faction = outpost_target_faction(id)
	if faction then
		local p = star_systems.outpost_position(self.current_system_id, faction)
		if not p then
			return nil
		end
		return {
			id = id, pos = vmath.vector3(p.x, p.y, p.z), radius = OUTPOST_RADIUS, kind = "outpost", faction = faction,
			relation = faction == session.get_faction() and "friendly" or "enemy",
			name = FACTION_NAMES[faction] .. " outpost",
			destroyed = not session.outpost_available(self.current_system_id, faction),
		}
	end
	local index = asteroid_target_index(id)
	if index then
		local a = asteroid_registry.by_index[index]
		return a and asteroid_target(a) or nil
	end
	local ship = remote_registry.ships[id]
	if not ship then
		return nil
	end
	return {
		id = id, pos = ship.pos, radius = SHIP_RADIUS, kind = "ship", faction = ship.faction, speed = ship.speed,
		relation = ship.faction == session.get_faction() and "friendly" or "enemy",
		name = (FACTION_NAMES[ship.faction] or "?") .. " ship",
	}
end

-- Everything that can be targeted right now (standing outposts only).
local function target_candidates(self)
	local list = {}
	for user_id in pairs(remote_registry.ships) do
		table.insert(list, resolve_target(self, user_id))
	end
	for _, faction in ipairs(OUTPOST_FACTIONS) do
		local target = resolve_target(self, OUTPOST_TARGET_PREFIX .. faction)
		if target and not target.destroyed then
			table.insert(list, target)
		end
	end
	for _, a in ipairs(asteroid_registry.asteroids) do
		table.insert(list, asteroid_target(a))
	end
	return list
end

-- Candidates within sensor range of the ship, nearest first; with
-- `relation`, only enemies or only friendlies.
local function targets_in_range(self, relation)
	local pos = go.get_position()
	local range = sensor_range(self.ship_id)
	local list = {}
	for _, target in ipairs(target_candidates(self)) do
		local dist = vmath.length(target.pos - pos)
		if dist <= range and (not relation or target.relation == relation) then
			target.dist = dist
			table.insert(list, target)
		end
	end
	table.sort(list, function(a, b) return a.dist < b.dist end)
	return list
end

-- Tab: the next target after the current one, nearest first (wrapping).
local function cycle_target(self)
	local list = targets_in_range(self)
	if #list == 0 then
		self.target_id = nil
		return
	end
	local next_index = 1
	for i, target in ipairs(list) do
		if target.id == self.target_id then
			next_index = (i % #list) + 1
			break
		end
	end
	self.target_id = list[next_index].id
end

-- X / F1: the nearest enemy or friendly in range (nothing changes if none).
local function target_nearest(self, relation)
	local list = targets_in_range(self, relation)
	if list[1] then
		self.target_id = list[1].id
	end
end

-- The GUI scene (main/flight_hud.gui, so every node in it, the target
-- marker included) is laid out in the project's display coordinates
-- (SCREEN_W x SCREEN_H) around the CENTRE of the window, scaled by one
-- uniform "fit" factor and letterboxed on whichever axis is left over - the
-- engine applies exactly this to the ADJUST_MODE_FIT / no-anchors nodes this
-- HUD is built from, and main/render/custom.render_script already relies on
-- the same mapping for its own design-space preview rects:
--
--     screen = design * u + (window - design * u) / 2,  u = min(w/1920, h/1080)
--
-- The chase camera instead fills the WHOLE window (the render script's
-- full-window viewport, main/flight_camera.camera's fixed 1.7778 aspect), so
-- its pixels only agree with those design coordinates on an exactly 16:9
-- window. Treating the camera's NDC as design pixels - the obvious
-- (ndc + 1) * 0.5 * 1920 - is what slid the bracket off a target that had
-- moved away from the middle of any other window shape; inverting the GUI's
-- own mapping above, as project() does, places the marker where the engine
-- actually draws the node.
--
-- self.gui_half_w/h are the window's half-extent in DESIGN pixels (960/540
-- at exactly 16:9), and self.gui_win_scale the extra size factor that keeps
-- the bracket as tall on screen as the object it surrounds.
local function update_gui_mapping(self)
	local w, h = window.get_size()
	if not w or not h or w <= 0 or h <= 0 then
		w, h = SCREEN_W, SCREEN_H -- no window to ask about: assume 16:9
	end
	local u = math.min(w / SCREEN_W, h / SCREEN_H)
	self.gui_half_w = w / (2 * u)
	self.gui_half_h = h / (2 * u)
	self.gui_win_scale = (h / SCREEN_H) / u
end

-- Where `world_pos` is on screen (main/flight_hud.gui_script's own design
-- coordinates - update_gui_mapping above is how those relate to the window),
-- how big an object of `radius` metres looks there (px), and whether it's in
-- front of the camera. Uses the view-projection the renderer will draw with
-- this frame (see update()'s chase-camera block).
local function project(self, world_pos, radius)
	if not self.view_proj then
		return nil
	end
	if not self.gui_half_w then
		update_gui_mapping(self)
	end
	local v = self.view_proj * vmath.vector4(world_pos.x, world_pos.y, world_pos.z, 1)
	local w = v.w
	local in_front = w > 0.001
	local inv = 1 / (in_front and w or -math.max(-w, 0.001))
	local x = SCREEN_W * 0.5 + v.x * inv * self.gui_half_w
	local y = SCREEN_H * 0.5 + v.y * inv * self.gui_half_h
	local size = 0
	if in_front then
		size = (radius or 0) * (SCREEN_H * 0.5) / (math.abs(w) * math.tan(CAMERA_FOV / 2)) * self.gui_win_scale
	end
	return x, y, size, in_front
end

-- Left-click: target the object under the cursor (the nearest one, if
-- several overlap). Returns true if something was targeted.
local function pick_target(self, x, y)
	if not self.gui_half_w then
		update_gui_mapping(self)
	end
	-- on_input's action.x/y are spread across the whole window (the engine
	-- scales the window's physical size up to the project's display size),
	-- while project() hands back the GUI's own centre-fit coordinates - so
	-- convert here, or a click would land off the bracket the same way the
	-- marker used to.
	local cx, cy = SCREEN_W * 0.5, SCREEN_H * 0.5
	x = cx + (x - cx) * (self.gui_half_w / cx)
	y = cy + (y - cy) * (self.gui_half_h / cy)
	local best, best_dist = nil, math.huge
	local cam = self.camera_pos or go.get_position()
	for _, target in ipairs(target_candidates(self)) do
		local sx, sy, size, in_front = project(self, target.pos, target.radius)
		if sx and in_front then
			local reach = math.max(size, CLICK_MIN_RADIUS)
			local dx, dy = sx - x, sy - y
			local dist = vmath.length(target.pos - cam)
			if dx * dx + dy * dy <= reach * reach and dist < best_dist then
				best, best_dist = target, dist
			end
		end
	end
	if best then
		self.target_id = best.id
		return true
	end
	return false
end

-- The on-screen marker for the current target (main/flight_hud.gui_script):
-- a bracket around it, or an arrow at the screen edge pointing to it when
-- it's off screen.
local function update_target_marker(self, target)
	if not target then
		msg.post("flight_hud#gui", "target_marker", { visible = false })
		return
	end
	local x, y, size, in_front = project(self, target.pos, target.radius)
	if not x then
		return
	end
	local margin = 40
	local cx, cy = SCREEN_W * 0.5, SCREEN_H * 0.5
	local half_w, half_h = self.gui_half_w or cx, self.gui_half_h or cy
	-- "On screen" means the window's own edge, half_w/h away from the GUI's
	-- centre - on a window that isn't 16:9 the visible area reaches past
	-- SCREEN_W/SCREEN_H in these design coordinates.
	local on_screen = in_front and math.abs(x - cx) <= half_w and math.abs(y - cy) <= half_h
	if on_screen then
		msg.post("flight_hud#gui", "target_marker", {
			visible = true, on_screen = true, x = x, y = y, size = math.max(size, 18), relation = target.relation,
		})
		return
	end
	-- Off screen (or behind): point from the centre towards it, clamped to
	-- the edge.
	local dx, dy = x - cx, y - cy
	if not in_front then
		dx, dy = -dx, -dy
	end
	if dx == 0 and dy == 0 then
		dy = -1
	end
	local scale = math.min((half_w - margin) / math.max(math.abs(dx), 0.0001), (half_h - margin) / math.max(math.abs(dy), 0.0001))
	msg.post("flight_hud#gui", "target_marker", {
		visible = true, on_screen = false, x = cx + dx * scale, y = cy + dy * scale,
		dx = dx, dy = dy, relation = target.relation,
	})
end

-- Weapons (per direct instruction): each fitted weapon is switched on and
-- off with Shift + its slot number (Wn = Shift+n, session.slot_hotkey), and
-- all start on at launch. Switched-on weapons fire by themselves at the
-- current target whenever it's the other faction's standing outpost or an
-- asteroid (BSGO-style; ships can't be shot yet). The server applies the
-- damage while the target is inside each weapon's range and firing arc
-- (nakama-server/modules/system_match.lua) - outposts lose hull for XP, an
-- asteroid is mined out (hull, main/data/asteroids.lua) and comes back after
-- a while.

-- The fitted weapon slots that are switched on, in slot order.
local function weapons_on_slots(self)
	local slots = {}
	for _, entry in ipairs(session.get_loadout() or {}) do
		if entry.slot:sub(1, 1) == "W" and self.weapons_on[entry.slot] then
			table.insert(slots, entry.slot)
		end
	end
	table.sort(slots)
	return slots
end

-- Keeps the server's fire order in step with the target and the switched-on
-- weapons. Only changes are sent; a new match (another system, or a
-- reconnect) gets the order again.
local function update_firing(self, target)
	local slots = {}
	local can_fire = target and (
		(target.kind == "outpost" and target.faction ~= session.get_faction()
			and session.outpost_available(self.current_system_id, target.faction))
		or target.kind == "asteroid")
	if can_fire then
		slots = weapons_on_slots(self)
	end
	local order = #slots > 0 and (self.target_id .. "|" .. table.concat(slots, ",")) or nil
	if network.match_id ~= self.fire_match then
		self.fire_match = network.match_id
		self.fire_order = nil
	end
	if order ~= self.fire_order then
		if order then
			self.fire_order = network.fire(self.target_id, slots) and order or nil
		else
			if self.fire_order then
				network.stop_fire()
			end
			self.fire_order = nil
		end
	end
	self.firing = self.fire_order ~= nil
end

-- One line for the flight HUD: each weapon's key and whether it's on, then
-- the keys of the fitted active modules.
local function hotkeys_text(self)
	local ship_id = session.get_ship_id()
	local weapon_parts, module_parts = {}, {}
	local loadout = {}
	for _, entry in ipairs(session.get_loadout() or {}) do
		table.insert(loadout, entry)
	end
	table.sort(loadout, function(a, b) return (session.slot_hotkey(ship_id, a.slot) or 99) < (session.slot_hotkey(ship_id, b.slot) or 99) end)
	for _, entry in ipairs(loadout) do
		local key = session.slot_hotkey(ship_id, entry.slot)
		local module = key and session.module_in_slot(entry.slot)
		if module and entry.slot:sub(1, 1) == "W" then
			table.insert(weapon_parts, "SHIFT+" .. key .. " " .. module.name:upper() .. (self.weapons_on[entry.slot] and " ON" or " OFF"))
		elseif module and module.behavior == "active" then
			table.insert(module_parts, key .. " " .. module.name:upper())
		end
	end
	local text = table.concat(weapon_parts, "   ")
	if #module_parts > 0 then
		text = text .. "      " .. table.concat(module_parts, "   ")
	end
	return text
end

show_hotkeys = function(self)
	msg.post("flight_hud#gui", "hotkeys", { text = hotkeys_text(self) })
end

-- Short message on the flight HUD's status line (the analyser's line).
local function flash_status(text)
	msg.post("asteroid_hub#script", "analyser_status", { text = text })
end

-- The fitted module with catalog key `item_key` (its catalog entry), or nil.
local function installed_module(item_key)
	for _, entry in ipairs(session.get_loadout() or {}) do
		local instance = session.get_instance(entry.instance_id)
		if instance and instance.item_key == item_key then
			return catalog.get(item_key)
		end
	end
	return nil
end

-- P: the Asteroid Analyser (a Computer module) analyses every asteroid in
-- its range - main/asteroid_hub.script runs the scan and shows the result.
local function activate_analyser(self)
	local analyser = installed_module("asteroid_analyser")
	if not analyser then
		msg.post("asteroid_hub#script", "analyser_status", { text = "NO ASTEROID ANALYSER FITTED" })
		return
	end
	-- The slot the analyser is actually fitted in, so the hub can put the scan
	-- sound at that mount rather than the ship's centre (plan.md §2.12).
	local slot = nil
	for _, entry in ipairs(session.get_loadout() or {}) do
		local instance = session.get_instance(entry.instance_id)
		if instance and instance.item_key == "asteroid_analyser" then
			slot = entry.slot
			break
		end
	end
	local pos, rot = go.get_position(), go.get_rotation()
	msg.post("asteroid_hub#script", "analyse", {
		position = pos, range = analyser.range_m, scan_time = analyser.scan_time_s,
		origin = slot and weapon_mount_position(self.ship_id, slot, pos, rot) or pos,
	})
	-- The server runs the same scan and awards XP for new asteroids.
	network.analyse()
end

-- Shift+n: switch weapon slot Wn on or off.
local function toggle_weapon(self, n)
	local slot = "W" .. n
	local module = session.module_in_slot(slot)
	if not module then
		flash_status("SHIFT+" .. n .. ": NO WEAPON IN " .. slot)
		return
	end
	self.weapons_on[slot] = not self.weapons_on[slot]
	flash_status(module.name:upper() .. " (" .. slot .. ") " .. (self.weapons_on[slot] and "ON" or "OFF"))
	show_hotkeys(self)
end

-- G: switch every fitted weapon off if any is on, otherwise all on.
local function toggle_all_weapons(self)
	local any_on = false
	for _, on in pairs(self.weapons_on) do
		any_on = any_on or on
	end
	for _, entry in ipairs(session.get_loadout() or {}) do
		if entry.slot:sub(1, 1) == "W" then
			self.weapons_on[entry.slot] = not any_on
		end
	end
	flash_status(any_on and "ALL WEAPONS OFF" or "ALL WEAPONS ON")
	show_hotkeys(self)
end

-- Visible weapon fire: each switched-on weapon shoots at the target (an
-- enemy outpost or any asteroid; not ships yet, and never friendlies)
-- once per reload while the target is inside its range and firing arc -
-- the same test the server uses to apply damage. Purely visual on the
-- client: the server owns the damage - outposts lose hull, and an asteroid
-- is mined out (destroyed_until, main/network.lua asteroid_state), which
-- main/asteroid_hub.script turns into a despawn.
local DEFAULT_RELOAD_S = 0.5
local MUZZLE_OFFSET = 6 -- m ahead of the ship's centre

-- The world position of weapon slot `slot`'s mount, from ships.lua's own
-- slot_positions table (the same {x, y} the outpost screen draws the fitting
-- markers from, where +y is toward the bow) - so the firing sound comes from
-- the mount that actually fired, not the ship's centre. Falls back to the
-- ship's centre for any slot without a position (Escort/Frigate ships have
-- empty slot_positions, plan.md §2.1.2).
local function weapon_mount_position(ship_id, slot, pos, rot)
	local ship = ships.SHIPS[ship_id]
	local positions = ship and ship.slot_positions
	local entry = positions and positions[slot]
	if not entry then
		return pos
	end
	return ship_local_to_world(pos, rot, entry.x, entry.y)
end

local function update_weapon_fire(self, dt, target, pos, rot)
	self.gun_timers = self.gun_timers or {}
	local can_shoot = target and not target.destroyed and target.relation ~= "friendly" and target.kind ~= "ship"
	local shot = false
	for _, entry in ipairs(session.get_loadout() or {}) do
		local slot = entry.slot
		if slot:sub(1, 1) == "W" then
			local timer = math.max(0, (self.gun_timers[slot] or 0) - dt)
			local module = can_shoot and self.weapons_on[slot] and session.module_in_slot(slot)
			if module and module.max_range_m and timer <= 0 then
				local to_target = target.pos - pos
				local dist = vmath.length(to_target)
				local reach = target.kind == "asteroid" and dist - target.radius or dist
				local forward = vmath.rotate(rot, SHIP_FORWARD)
				local dir = dist > 0 and to_target / dist or forward
				if reach <= module.max_range_m and vmath.dot(forward, dir) >= math.cos(math.rad((module.arc or 0) / 2)) then
					local aim = target.kind == "asteroid" and (pos + dir * math.max(0, dist - target.radius)) or target.pos
					msg.post("asteroid_hub#script", "shot", {
						from = pos + forward * MUZZLE_OFFSET,
						to = aim,
						-- Where this shot's sound should come from - the firing
						-- mount itself (plan.md §2.12).
						origin = weapon_mount_position(self.ship_id, slot, pos, rot),
					})
					timer = module.reload_s or DEFAULT_RELOAD_S
					shot = true
				end
			end
			self.gun_timers[slot] = timer
		end
	end
	if shot then
		self.last_shot_time = socket.gettime()
	end
end

-- n (1-9): use the active Computer/Engine/Hull module in that key's slot.
local function activate_module(self, n)
	local slot = session.module_slot_for_hotkey(session.get_ship_id(), n)
	local module = slot and session.module_in_slot(slot)
	if not module then
		flash_status(n .. ": NOTHING FITTED" .. (slot and (" IN " .. slot) or ""))
	elseif module.behavior ~= "active" then
		flash_status(module.name:upper() .. " IS PASSIVE (ALWAYS ON)")
	elseif module.range_m and module.scan_time_s then
		-- The flight HUD's ship diagram shows this slot "live" while the
		-- effect runs (slot_states below).
		self.module_live_until[slot] = socket.gettime() + module.scan_time_s
		activate_analyser(self)
	else
		flash_status(module.name:upper() .. ": NOT BUILT YET")
	end
end

-- Per-slot live/cooldown state for the flight HUD's bottom-left ship
-- diagram (main/flight_hud.gui_script's "slot_states" handler), one entry
-- per fitted slot: a switched-on weapon is "live" and reports its reload
-- countdown as "cooldown" (frac = remaining/total of reload_s), a passive
-- module is always "live", and an active module is "live" only while its
-- effect runs (activate_module's scan window above) - anything else
-- (weapon switched off, active module on standby) is "off".
local function slot_states(self)
	local states = {}
	local now = socket.gettime()
	for _, entry in ipairs(session.get_loadout() or {}) do
		local module = session.module_in_slot(entry.slot)
		if module then
			local state, frac = "off", 0
			if entry.slot:sub(1, 1) == "W" then
				local timer = (self.gun_timers or {})[entry.slot] or 0
				if self.weapons_on[entry.slot] then
					if timer > 0 then
						state, frac = "cooldown", timer / (module.reload_s or DEFAULT_RELOAD_S)
					else
						state = "live"
					end
				end
			elseif module.behavior == "passive" then
				state = "live"
			elseif now < (self.module_live_until[entry.slot] or 0) then
				state = "live"
			end
			states[entry.slot] = { state = state, frac = frac }
		end
	end
	return states
end

-- key_trigger actions weapon_1..weapon_9 (keys 1-9)
local NUMBER_KEYS = {}
for n = 1, 9 do
	NUMBER_KEYS[hash("weapon_" .. n)] = n
end

-- Selecting a system on main/flight_map.gui arms it as a preset -
-- re-validated independently here rather than trusting that gui_script's
-- own reachability check outright (same "don't just trust the sender"
-- reasoning the source project's own identically-named handler gives).
function on_message(self, message_id, message)
	if message_id == hash("start_flight") then
		start_flight(self)
	elseif message_id == hash("ship_destroyed") then
		ship_destroyed(self)
	elseif message_id == hash("set_jump_preset") then
		local faction = session.get_faction()
		if star_systems.can_enter(message.system_id, faction) then
			local _, _, _, _, _, ftl_range_ly = flight_stats(self.ship_id)
			local dist = self.current_system_id and star_systems.distance(self.current_system_id, message.system_id)
			if star_systems.in_ftl_range(dist, star_systems.ly_to_map_units(ftl_range_ly)) then
				self.jump_preset_system = message.system_id
				local name = star_systems.SYSTEMS[message.system_id].name
				msg.post("flight_hud#gui", "jump_preset", { text = "PRESET: " .. name .. " [J]" })
			end
		end
	elseif message_id == hash("execute_jump_preset") then
		-- main/flight_map.gui's [JUMP] button - same effect as pressing J
		execute_jump(self)
	end
end

function on_input(self, action_id, action)
	if not self.flying then
		return false
	end
	if action_id == hash("toggle_map") and action.pressed then
		-- Checked first, and unconditionally (even while the map's
		-- already open - this is also how it closes again).
		toggle_map(self)
		return true
	end
	if self.map_open then
		-- swallow everything else (flight keys, dock, throttle, camera,
		-- ...) while the map's open, rather than letting any of it fall
		-- through to the normal handling below.
		return true
	end
	if action_id == hash("pitch_up") then
		self.input.pitch_up = not action.released
	elseif action_id == hash("pitch_down") then
		self.input.pitch_down = not action.released
	elseif action_id == hash("yaw_left") then
		self.input.yaw_left = not action.released
	elseif action_id == hash("yaw_right") then
		self.input.yaw_right = not action.released
	elseif action_id == hash("boost") then
		self.input.boost = not action.released
	elseif action_id == hash("throttle_up") then
		self.input.throttle_up = not action.released
		if action.pressed then
			self.follow_friend = false -- manual throttle always wins over Y's own speed-matching
		end
	elseif action_id == hash("throttle_down") then
		self.input.throttle_down = not action.released
		if action.pressed then
			self.follow_friend = false
		end
	elseif action_id == hash("stop_throttle") then
		if action.pressed then
			self.throttle = 0.0
			self.follow_friend = false
		end
	elseif action_id == hash("full_throttle") then
		if action.pressed then
			self.throttle = 1.0
			self.follow_friend = false
		end
	elseif action_id == hash("cancel_target") then
		-- C - clears whatever TAB/X currently has locked; follow-friend is
		-- cleared alongside it, same as when the target disconnects
		-- entirely (see update()'s targeting block) - it means nothing
		-- without a target.
		if action.pressed then
			self.target_id = nil
			self.follow_friend = false
		end
	elseif action_id == hash("cycle_target") then
		-- TAB - see cycle_target()'s own comment above
		if action.pressed then
			cycle_target(self)
		end
	elseif action_id == hash("target_nearest_enemy") then
		-- X - nearest enemy ship or outpost (see target_nearest above)
		if action.pressed then
			target_nearest(self, "enemy")
		end
	elseif action_id == hash("target_nearest_friendly") then
		-- F1 - nearest friendly ship or outpost
		if action.pressed then
			target_nearest(self, "friendly")
		end
	elseif action_id == hash("touch") then
		-- left-click: target whatever is under the cursor
		if action.pressed then
			pick_target(self, action.x, action.y)
		end
	elseif action_id == hash("toggle_guns") then
		-- G (BSGO): all weapons on, or all off if any are on
		if action.pressed then
			toggle_all_weapons(self)
		end
	elseif action_id == hash("target_nearest_missile") then
		-- Z - NOT IMPLEMENTED: no missile/projectile-in-flight entity
		-- exists anywhere in this project for this to ever refer to, same
		-- as the source project's own honest no-op for this key (§0) -
		-- consumed rather than left unbound.
		-- (nothing to do)
	elseif action_id == hash("match_speed") then
		-- T - Match Speed: a ONE-SHOT snapshot, not a continuous track -
		-- sets this ship's own throttle LEVER to whatever fraction of its
		-- own top speed currently equals the target's broadcast speed,
		-- right now; update()'s existing acceleration-bounded lerp (same
		-- one +/-/Q/E already drive) eases self.speed toward that from
		-- here, same as any other throttle change. Doesn't keep re-syncing
		-- afterward if the target's speed changes later - press T again
		-- for that - and, like any manual throttle change, always
		-- overrides follow-friend. Ported technique from the source
		-- project's own on_input "match_speed" handler (§0).
		if action.pressed then
			local target = self.target_id and remote_registry.ships[self.target_id]
			if target then
				local _, max_speed = flight_stats(self.ship_id)
				self.throttle = math.max(0, math.min(1, (target.speed or 0) / max_speed))
				self.follow_friend = false
			end
		end
	elseif action_id == hash("follow_friend") then
		-- Y - no-op with no target, or a target that isn't a SAME-faction
		-- ship - there'd be nothing sensible to fly in formation with (an
		-- enemy isn't a "friend" to follow). Ported technique from the
		-- source project's own on_input "follow_friend" handler (§0).
		if action.pressed then
			local target = self.target_id and remote_registry.ships[self.target_id]
			if target and target.faction == session.get_faction() then
				self.follow_friend = not self.follow_friend
			end
		end
	elseif action_id == hash("dock") then
		-- "Pressing K will cancel your FTL jump" - checked first, same key
		-- docking's own countdown already uses to commit, so jump-cancel
		-- takes priority (mirrors the reference project's own on_input
		-- "dock" handler): the two countdowns can never really overlap in
		-- practice (execute_jump() above refuses to start while docking,
		-- and starting to dock requires near_outpost, which a jump's own
		-- arrival spawn point away from any outpost already rules out),
		-- but checking self.jumping first keeps K's meaning unambiguous
		-- regardless.
		if action.pressed then
			if self.jumping then
				self.jumping = false
				self.jump_target_system = nil
				session.cancel_jump() -- refunds what start_jump() charged
				self.jump_hydrogen_spent = 0
			elseif self.near_outpost and not self.docking then
				self.docking = true
				self.dock_time_left = DOCK_COUNTDOWN_SEC
			end
		end
	elseif action_id == hash("shift") then
		if action.pressed then
			self.shift_held = true
		elseif action.released then
			self.shift_held = false
		end
		return false
	elseif NUMBER_KEYS[action_id] then
		-- Shift+1-9: weapon on/off; 1-9: use an active module
		if action.pressed then
			if self.shift_held then
				toggle_weapon(self, NUMBER_KEYS[action_id])
			else
				activate_module(self, NUMBER_KEYS[action_id])
			end
		end
	elseif action_id == hash("activate_scanner") then
		if action.pressed then
			activate_analyser(self)
		end
	elseif action_id == hash("execute_jump") then
		-- "This is very handy when you need to FTL away rather than die" -
		-- fires whatever's currently armed in self.jump_preset_system
		-- without needing the map open at all, see execute_jump() above.
		if action.pressed then
			execute_jump(self)
		end
	else
		return false
	end
	return true
end

function update(self, dt)
	if not self.flying then
		return
	end

	local turn_speed_deg, max_speed, boost_speed, acceleration, visual_range, _, _, turn_accel_deg = flight_stats(self.ship_id)
	local turn_speed_rad = math.rad(turn_speed_deg)
	local turn_accel_rad = math.rad(turn_accel_deg)
	local pos = go.get_position()

	-- Targeting: self.target_id is set by TAB/X (cycle_target()/
	-- target_nearest_enemy() above) or cleared by C - resolved right at the
	-- top of update() since the follow-friend movement block immediately
	-- below needs the target's position/speed, and the HUD readout further
	-- down reuses this same local. Ported technique from the source
	-- project's own update() (§0).
	if self.outposts_changed then
		self.outposts_changed = false
		place_outposts(self.current_system_id)
	end

	-- The current target, if it still exists (a ship that left the system,
	-- an asteroid of a system we've jumped away from, ...). Drifting out of
	-- range keeps the lock; an outpost stays locked while destroyed.
	local target = resolve_target(self, self.target_id)
	if not target then
		self.target_id = nil
	end
	local target_ship = target and target.kind == "ship" and remote_registry.ships[target.id] or nil
	update_firing(self, target)
	if self.follow_friend and not (target_ship and target_ship.faction == session.get_faction()) then
		-- target gone entirely, or (shouldn't normally happen - on_input's
		-- "follow_friend" handler already only turns this on for a
		-- same-faction target - but re-checked every frame anyway in case
		-- the registry entry itself changes) no longer a friendly ship.
		self.follow_friend = false
	end

	local pitch_delta = (self.input.pitch_up and 1 or 0) - (self.input.pitch_down and 1 or 0)
	local yaw_delta = (self.input.yaw_left and 1 or 0) - (self.input.yaw_right and 1 or 0)

	-- Full body-frame rotation (per direct instruction: "port" the
	-- reference project's own arcade flight model - see this project's own
	-- research findings on it) - pitch/yaw torque coasts under angular
	-- "drag" (here: eases toward a target angular velocity bounded by
	-- turn_accel_rad, same acceleration-bounded-target technique
	-- self.speed below already uses, rather than the reference's own
	-- exponential 1/(1+drag*dt) decay - a cleaner fit for this project's
	-- existing turning_speed_deg_per_sec/turning_acceleration_deg_per_sec2
	-- stat PAIR, which was already sitting unused in main/data/ships.lua
	-- - not the reference's own single turn_rate/drag pair) - and, unlike
	-- the WORLD-frame yaw this replaces, pitch+yaw now compose in the
	-- ship's own LOCAL frame each frame (rot = rot * delta, not delta *
	-- rot), which is what lets bank/roll emerge organically from combined
	-- pitch+yaw the same way a real aircraft's does - there is still no
	-- manual roll key (matching the reference project's own default
	-- scheme exactly - bank is never directly flown, only ever drifted
	-- into and auto-leveled back out of).
	if pitch_delta ~= 0 or yaw_delta ~= 0 then
		self.time_since_rotation_input = 0
	else
		self.time_since_rotation_input = self.time_since_rotation_input + dt
	end

	local rot = go.get_rotation()
	if self.follow_friend and target_ship then
		-- Y's Follow Friend, fully driving rotation in place of the manual
		-- pitch/yaw/auto-level block below: steers straight at the
		-- target's CURRENT position every frame (pure pursuit, not a lead/
		-- intercept solution - it re-aims continuously as the target moves
		-- rather than predicting ahead). on_input cancels follow-friend the
		-- instant a manual throttle key is pressed, and pitch/yaw simply
		-- aren't read while this branch is active, so it and manual
		-- rotation never actually run in the same frame - no blending/
		-- arbitration needed here. Ported technique from the source
		-- project's own update() (§0).
		local to_target = target_ship.pos - pos
		local look_rot = rot
		if vmath.length(to_target) > 0.0001 then
			local dir = vmath.normalize(to_target)
			if vmath.dot(SHIP_FORWARD, dir) < -0.9999 then
				-- quat_from_to() returns NaN for exactly-opposite vectors,
				-- same edge case random_spawn() above already handles.
				look_rot = vmath.quat_axis_angle(UP, math.pi)
			else
				look_rot = vmath.quat_from_to(SHIP_FORWARD, dir)
			end
		end
		local t = 1.0 - math.exp(-AUTOPILOT_RESPONSE * dt)
		rot = vmath.normalize(vmath.slerp(t, rot, look_rot))
		self.angular_velocity = vmath.vector3()
		self.time_since_rotation_input = 0
	else
		local target_angular_velocity = vmath.vector3(
			turn_speed_rad * pitch_delta,
			turn_speed_rad * yaw_delta,
			0)
		if pitch_delta == 0 and yaw_delta == 0 and self.time_since_rotation_input >= AUTO_LEVEL_DELAY then
			-- Auto-level (per direct instruction) - a proportional "spring
			-- back to level" target for roll ALONE, only once the player's
			-- genuinely let go for AUTO_LEVEL_DELAY seconds, same "don't
			-- fight an active maneuver" reasoning the reference project's own
			-- version has. See level_roll_angle()'s own comment for why the
			-- sign here is the OPPOSITE of the reference project's own
			-- `torque.z - roll_angle*speed` - this hull's nose is at local
			-- +Z, not the reference's -Z, which flips which rotation SENSE
			-- around the forward axis counts as "banking right" (verified
			-- numerically via a standalone quaternion simulation before
			-- landing, not just re-derived by hand - flag if this ever needs
			-- re-checking, e.g. if SHIP_FORWARD's own sign ever changes).
			local roll_angle = level_roll_angle(rot)
			target_angular_velocity.z = math.max(-turn_speed_rad, math.min(turn_speed_rad, AUTO_LEVEL_SPEED * roll_angle))
		end

		local max_angular_delta = turn_accel_rad * dt
		for _, axis in ipairs({ "x", "y", "z" }) do
			local diff = target_angular_velocity[axis] - self.angular_velocity[axis]
			if diff > max_angular_delta then
				self.angular_velocity[axis] = self.angular_velocity[axis] + max_angular_delta
			elseif diff < -max_angular_delta then
				self.angular_velocity[axis] = self.angular_velocity[axis] - max_angular_delta
			else
				self.angular_velocity[axis] = target_angular_velocity[axis]
			end
		end

		local rotation_delta = vmath.quat_axis_angle(RIGHT, self.angular_velocity.x * dt)
			* vmath.quat_axis_angle(UP, self.angular_velocity.y * dt)
			* vmath.quat_axis_angle(SHIP_FORWARD, self.angular_velocity.z * dt)
		rot = vmath.normalize(rot * rotation_delta)
	end
	go.set_rotation(rot)

	-- self.throttle is the CONTROL position (0..1, what the stick/lever is
	-- set to) - this ramp is how fast holding +/- moves that lever, same
	-- acceleration-derived rate as before (e.g. 10 m/sec^2 on a 52.5
	-- m/sec ship sweeps the lever 0 -> full in ~5.25 sec). Q/E (on_input)
	-- can still snap it straight to 0/1.0.
	local throttle_delta = (self.input.throttle_up and 1 or 0) - (self.input.throttle_down and 1 or 0)
	if throttle_delta ~= 0 then
		self.throttle = self.throttle + (acceleration / max_speed) * throttle_delta * dt
		self.throttle = math.max(0.0, math.min(1.0, self.throttle))
	end

	-- self.speed is the ACTUAL current speed - it always chases
	-- target_speed, accelerating/decelerating at the ship's own
	-- acceleration_m_per_sec2 (the same stat the lever ramp above uses),
	-- regardless of how abruptly the target itself moves - a plain
	-- move-toward-target bounded by acceleration*dt each frame, not an
	-- exponential lerp (acceleration is a constant rate, not a "close the
	-- gap by a fraction" one).
	--
	-- Boost (per direct instruction: "no matter what speed the ship is
	-- travelling at... boost [pushes] the ship to the boost maximum
	-- speed... [releasing] the speed should revert [to] what it was
	-- previous[ly]") is the ship's own absolute boost_speed_m_per_sec
	-- UNSCALED by throttle while held - not self.throttle*boost_speed
	-- (that earlier version only ever reached the full boost speed at
	-- full throttle, contradicting "no matter what speed"). Releasing it
	-- drops target_speed straight back to whatever the throttle lever
	-- alone commands (self.throttle*max_speed) - "what it was previous" -
	-- with self.speed easing back down/up to that the same
	-- acceleration-bounded way as any other target change.
	local target_speed
	if self.follow_friend and target_ship then
		-- Y's Follow Friend also eases velocity toward matching the
		-- target's own broadcast speed (main/network.lua's send_transform,
		-- main/remote_ships.script) every frame, through this same
		-- acceleration-bounded chase - not a separate mechanism. Ported
		-- technique from the source project's own update() (§0).
		target_speed = target_ship.speed or 0
	else
		target_speed = self.input.boost and boost_speed or (self.throttle * max_speed)
	end
	local max_speed_delta = acceleration * dt
	local speed_delta = target_speed - self.speed
	if speed_delta > max_speed_delta then
		self.speed = self.speed + max_speed_delta
	elseif speed_delta < -max_speed_delta then
		self.speed = self.speed - max_speed_delta
	else
		self.speed = target_speed
	end

	-- Engines on while thrust is commanded (target_speed > 0), whatever
	-- commands it - throttle, boost or Follow Friend's speed-matching. Using
	-- target_speed rather than self.speed is the point: with the throttle at 0
	-- target_speed is 0 even though self.speed is still bleeding off, so the
	-- loop stops with the thrust instead of humming until the ship drifts to a
	-- halt. The thrust LEVEL (0..1, fraction of top speed) drives the loop's
	-- pitch too - see set_engine_sound.
	local thrust = target_speed > ENGINE_MIN_THRUST and thrust_level(target_speed, max_speed) or 0
	set_engine_sound(self, thrust)

	local forward = vmath.rotate(rot, SHIP_FORWARD)
	pos = pos + forward * self.speed * dt
	go.set_position(pos)
	msg.post("flight_hud#gui", "set_speed", { speed = self.speed })

	-- Realtime presence (AskUserQuestion's "Realtime presence only" slice) -
	-- broadcast this ship's own transform at NETWORK_SEND_INTERVAL, not
	-- every frame (see that constant's own comment).
	self.network_send_timer = self.network_send_timer + dt
	self.network_since_sent = self.network_since_sent + dt
	if self.network_send_timer >= NETWORK_SEND_INTERVAL then
		self.network_send_timer = 0
		if (self.network_since_sent >= NETWORK_KEEPALIVE_INTERVAL or network_state_changed(self, pos, rot))
			and network.send_transform(pos, rot, self.speed, self.ship_id) then
			self.net_sent_pos = pos
			self.net_sent_rot = rot
			self.net_sent_speed = self.speed
			self.network_since_sent = 0
		end
	end

	-- Currency (per direct instruction: "show the amount of currency for
	-- each resource that the player has") - same four main/session.lua
	-- getters main/outpost.gui_script's own refresh_currency() reads.
	msg.post("flight_hud#gui", "currency", {
		tope = session.get_tope(),
		water = session.get_water(),
		iron = session.get_iron(),
		hydrogen = session.get_hydrogen(),
	})

	-- FTL jump countdown - started by execute_jump() above (J key, or
	-- main/flight_map.gui's [JUMP] button), cancelable with K (see
	-- on_input's "dock" handler, which checks self.jumping first and
	-- refunds the spent Hydrogen). Unlike docking, nothing here cancels it
	-- automatically once started - there's no "drifted out of range"
	-- equivalent for a jump already underway. Reaching zero hands off to
	-- arrive_at_system() above. Ported technique from the reference
	-- project's own ship.script (§0).
	if self.jumping then
		self.jump_time_left = self.jump_time_left - dt
		if self.jump_time_left <= 0 then
			self.jumping = false
			local target = self.jump_target_system
			self.jump_target_system = nil
			self.jump_hydrogen_spent = 0 -- already spent, not refundable now that it's landed
			session.arrive_jump()
			arrive_at_system(self, target)
			-- arrive_at_system() just teleported/reoriented the ship -
			-- refresh `pos`/`rot` (computed earlier this frame, now stale)
			-- so the docking check/radar post/chase-camera math below all
			-- use where the ship actually is now, not wherever it was a
			-- moment before landing.
			pos = go.get_position()
			rot = go.get_rotation()
		end
	end

	-- Docking (per direct instruction: only within DOCK_RANGE of the
	-- player's own faction's outpost) - K (on_input's "dock" case above)
	-- starts a DOCK_COUNTDOWN_SEC countdown; drifting back out of range
	-- mid-countdown cancels it rather than completing from wherever the
	-- ship happens to be once it elapses. Reaching zero hands off to the
	-- outpost menu via complete_dock() above - same "one script owns the
	-- transition" shape start_flight()'s own Launch hand-off uses, just
	-- reversed. Ported technique from the reference project's own
	-- ship.script (§0).
	local outpost_pos = outpost_position(self.current_system_id, session.get_faction())
	self.near_outpost = outpost_pos and vmath.length(pos - outpost_pos) <= DOCK_RANGE or false
	if self.docking then
		if not self.near_outpost then
			self.docking = false
		else
			self.dock_time_left = self.dock_time_left - dt
			if self.dock_time_left <= 0 then
				complete_dock(self)
			end
		end
	end

	local dock_text = nil
	if self.jumping then
		dock_text = string.format("Jumping to %s in %d... [K] to cancel",
			star_systems.SYSTEMS[self.jump_target_system].name, math.ceil(self.jump_time_left))
	elseif self.docking then
		dock_text = string.format("Docking in %d...", math.ceil(self.dock_time_left))
	elseif self.near_outpost then
		dock_text = "Press [K] to dock"
	end
	msg.post("flight_hud#gui", "dock_prompt", { text = dock_text })

	-- Targeting HUD readout (per direct instruction: "search superships for
	-- all references to target. Implement what you find") - `target_ship`
	-- was already resolved at the top of update() for the follow-friend
	-- movement block above; reused here for the same reason. Out-of-range
	-- doesn't clear the lock (see that resolution's own comment), it just
	-- changes what this reads - same distinction the source project's own
	-- "TARGET: <faction> (out of range)" text makes. Ported technique from
	-- the source project's own update() (§0), simplified to hide the node
	-- entirely with no target rather than always showing "TARGET: none",
	-- matching this HUD's own dock_prompt/jump_preset convention.
	local target_text = nil
	if target then
		local details = {}
		if target.kind == "outpost" and target.destroyed then
			table.insert(details, string.format("DESTROYED - returns in %d min",
				math.ceil(network.outpost_returns_in(self.current_system_id, target.faction) / 60)))
		elseif target.kind == "outpost" then
			local st = network.outpost_state(self.current_system_id, target.faction)
			if st then
				table.insert(details, "HULL " .. with_commas(st.hp) .. " / " .. with_commas(st.max_hp))
			end
		elseif target.kind == "asteroid" then
			-- Hull the server (or the shared rule, until it says otherwise)
			-- gives a rock this size: main/data/asteroids.lua max_hull.
			local max_hp = asteroid_data.max_hull(target.radius * 2)
			local st = network.asteroid_state(self.current_system_id, target.index)
			table.insert(details, "HULL " .. with_commas(st and st.hp or max_hp) .. " / " .. with_commas(max_hp))
			if target.resource_amount then
				table.insert(details, "RESOURCE " .. with_commas(target.resource_amount))
			end
		end
		table.insert(details, with_commas(vmath.length(target.pos - pos)) .. " m")
		if self.firing or (self.last_shot_time and socket.gettime() - self.last_shot_time < 1) then
			table.insert(details, "[FIRING]")
		end
		if self.follow_friend then
			table.insert(details, "[FOLLOWING]")
		end
		target_text = target.name:upper() .. "\n" .. table.concat(details, "   ")
	end
	msg.post("flight_hud#gui", "target", { text = target_text, relation = target and target.relation })

	-- Radar (per direct instruction: "each ship has its own visible
	-- range" / "a gooey that shows a radar indicating all ships within
	-- visible range") - visual_range above, NOT the longer
	-- sensor_range_m/"Dradis Range" main/data/ships.lua's own comment
	-- already distinguishes it from. `contacts` was always empty until now
	-- (no NPCs, no multiplayer) - main/remote_registry.lua (populated every
	-- frame by main/remote_ships.script from the current system's Nakama
	-- room) is the first real source: every remote ship there is already
	-- guaranteed to be in this same system (main/network.lua's per-system
	-- room join), so this only needs its own visual_range distance filter,
	-- same "build the real system even though nothing populates it yet"
	-- footing main/data/asteroids.lua's own M.OVERRIDES already had before
	-- this landed.
	local contacts = {}
	for _, remote in pairs(remote_registry.ships) do
		if vmath.length(remote.pos - pos) <= visual_range then
			table.insert(contacts, remote)
		end
	end
	msg.post("flight_hud#gui", "contacts", { own_pos = pos, range = visual_range, contacts = contacts })

	-- Chase camera - see this file's header comment for why position is
	-- derived from camera_rot rather than lerped independently, and for why
	-- camera_target_rot needs the extra YAW_180 (this hull's nose is at
	-- local +Z, but a Defold camera looks down its own local -Z - without
	-- the flip the camera would face away from the ship it's chasing).
	local camera_target_rot = rot * YAW_180
	if self.camera_rot == nil then
		self.camera_rot = camera_target_rot
	else
		local t = 1.0 - math.exp(-CAMERA_FOLLOW_SPEED * dt)
		self.camera_rot = vmath.slerp(t, self.camera_rot, camera_target_rot)
	end
	local camera_distance, camera_height = camera_distance_height(self.ship_id)
	local camera_pos = pos - vmath.rotate(self.camera_rot, CAMERA_FORWARD) * camera_distance
		+ vmath.rotate(self.camera_rot, UP) * camera_height
	go.set_position(camera_pos, "flight_camera")
	go.set_rotation(self.camera_rot, "flight_camera")

	-- The camera's view-projection, built from the transform just set
	-- (identical settings and construction to the engine's own camera
	-- component), i.e. the one this frame's render will use. Deliberately
	-- NOT read back with camera.get_view/camera.get_projection: the camera
	-- component only refreshes its cached matrices in its OWN late update,
	-- which runs after this script's update, so those are still last
	-- frame's - reading them made the marker lag a frame behind the camera
	-- and drift off the target whenever the ship was turning.
	self.camera_pos = camera_pos
	-- The camera IS the audio listener (plan.md §2.12): publish it every
	-- frame so the hub's world sounds (asteroid shot/breakup/scan) pan and
	-- fade relative to what the player is actually looking through. Because
	-- the listener carries the camera's own rotation, a future camera mode
	-- that re-orients (or relocates) the camera changes the panning for
	-- free - nothing here assumes the camera sits behind the ship.
	audio.set_listener(camera_pos, self.camera_rot)
	-- Re-place the engine loop at the ship's stern as it turns. Cheap (two
	-- property writes) and only while the loop is actually running.
	if self.engine_sound_on then
		audio.update_loop("#engine_sound", engine_origin(self, pos, rot), { attenuate = false })
	end
	-- The window's own shape (a browser window resize, ...) - see
	-- update_gui_mapping for what the target marker does with it.
	update_gui_mapping(self)
	local look = vmath.rotate(self.camera_rot, CAMERA_FORWARD)
	local up = vmath.rotate(self.camera_rot, UP)
	self.view_proj = vmath.matrix4_perspective(CAMERA_FOV, CAMERA_ASPECT, CAMERA_NEAR, CAMERA_FAR)
		* vmath.matrix4_look_at(camera_pos, camera_pos + look, up)
	update_weapon_fire(self, dt, target, pos, go.get_rotation())
	-- Ship diagram's live/cooldown state (flight HUD) - every frame like
	-- the other HUD updates above, so cooldown bars drain smoothly.
	msg.post("flight_hud#gui", "slot_states", { states = slot_states(self) })
	update_target_marker(self, target)
end
