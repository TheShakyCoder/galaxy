	-- radius.
	["/assets/models/escort_interceptor/falcon.model"] = { eye_offset = vmath.vector3(0, 91.2, 243.2), far = 438.23 },
	-- frigatebird.glb (aesir.glb, §0-flagged, see ships.lua's frigate_interceptor
