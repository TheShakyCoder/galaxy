	["/assets/models/escort_assault/moray.model"] = { eye_offset = vmath.vector3(0.000, 36.918, 98.809), far = 189.289 },
	["/assets/models/escort_tactical/lionfish.model"] = { eye_offset = vmath.vector3(0.000, 40.947, 109.592), far = 204.490 },
	["/assets/models/frigate_interceptor/marlin.model"] = { eye_offset = vmath.vector3(0.000, 155.384, 415.874), far = 636.247 },
	["/assets/models/frigate_support/manta_ray.model"] = { eye_offset = vmath.vector3(0.000, 173.995, 465.685), far = 706.464 },
	["/assets/models/frigate_assault/tiger_shark.model"] = { eye_offset = vmath.vector3(0.000, 152.118, 407.132), far = 623.923 },
	["/assets/models/frigate_tactical/hammerhead.model"] = { eye_offset = vmath.vector3(0.000, 171.204, 458.216), far = 695.936 },
	["/assets/models/patrol_interceptor/hummingbird.model"] = { eye_offset = vmath.vector3(0.000, 9.829, 26.308), far = 87.085 },
	["/assets/models/patrol_support/oxpecker.model"] = { eye_offset = vmath.vector3(0.000, 9.126, 24.426), far = 84.432 },
	["/assets/models/patrol_assault/shrike.model"] = { eye_offset = vmath.vector3(0.000, 10.018, 26.812), far = 87.797 },
	["/assets/models/patrol_tactical/kingfisher.model"] = { eye_offset = vmath.vector3(0.000, 9.789, 26.199), far = 86.933 },
	["/assets/models/escort_interceptor/falcon.model"] = { eye_offset = vmath.vector3(0.000, 41.614, 111.376), far = 207.004 },
	["/assets/models/escort_support/egret.model"] = { eye_offset = vmath.vector3(0.000, 37.206, 99.580), far = 190.375 },
	["/assets/models/escort_assault/goshawk.model"] = { eye_offset = vmath.vector3(0.000, 40.368, 108.041), far = 202.303 },
	["/assets/models/escort_tactical/osprey.model"] = { eye_offset = vmath.vector3(0.000, 39.348, 105.311), far = 198.455 },
	["/assets/models/frigate_interceptor/frigatebird.model"] = { eye_offset = vmath.vector3(0.000, 152.271, 407.542), far = 624.502 },
	["/assets/models/frigate_support/pelican.model"] = { eye_offset = vmath.vector3(0.000, 159.141, 425.929), far = 650.422 },
