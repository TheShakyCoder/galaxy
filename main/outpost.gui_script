	["/assets/models/frigate_support/manta_ray.model"] = vmath.vector3(100000, 15000, 0),
	["/assets/models/frigate_assault/tiger_shark.model"] = vmath.vector3(100000, 16000, 0),
	["/assets/models/patrol_support/oxpecker.model"] = vmath.vector3(100000, 17000, 0),
	["/assets/models/patrol_assault/shrike.model"] = vmath.vector3(100000, 18000, 0),
	["/assets/models/patrol_tactical/kingfisher.model"] = vmath.vector3(100000, 19000, 0),
