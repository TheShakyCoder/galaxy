-- Lays out the detail modal's visible buttons (`slots`: list of
-- { box, label } pairs, in order) evenly spaced and centered - shared by the
-- ship detail modal and the skin purchase modal.
local function layout_detail_buttons(slots)
	local row_w = #slots * DETAIL_BUTTON_W + (#slots - 1) * DETAIL_BUTTON_GAP
	local left_x = DETAIL_BUTTON_CENTER_X - row_w / 2 + DETAIL_BUTTON_W / 2
	for i, pair in ipairs(slots) do
		local cx = left_x + (i - 1) * (DETAIL_BUTTON_W + DETAIL_BUTTON_GAP)
		local pos = vmath.vector3(cx, DETAIL_BUTTON_Y, 0)
		gui.set_position(pair[1], pos)
		gui.set_size(pair[1], vmath.vector3(DETAIL_BUTTON_W, DETAIL_BUTTON_H, 0))
		gui.set_position(pair[2], pos)
		gui.set_size(pair[2], vmath.vector3(DETAIL_BUTTON_W, DETAIL_BUTTON_H, 0))
	end
end

-- Opens the ship detail modal (§2.8.9) for `ship_id` - replaces the old
-- straight-to-confirm-dialog behavior on a Ships tab card click. Figures out
-- its own button state (Purchase/Select/just-Cancel) from real session state
-- rather than the caller needing to know which case applies.
local function show_ship_detail(self, ship_id)
	local ship = ships.SHIPS[ship_id]
	local faction = session.get_faction()
	local owned = session.is_ship_owned(ship_id)
	local is_active = ship_id == session.get_ship_id()

	self.ship_detail = { ship_id = ship_id }
	gui.set_text(self.ship_detail_nodes.name, ship_display_name(ship_id, faction) .. "  (" .. (ship and ship.class or "?") .. ")"
		.. (session.is_ship_advanced(ship_id) and "  [Advanced]" or ""))

	local stats = ship_stats_text(ship_id)
	if not owned then
		local required = session.ship_level_required(ship_id)
		local locked = session.get_level() < required
			and ("Requires level " .. required .. " (you're level " .. session.get_level() .. ")\n") or ""
		stats = locked .. "Price: " .. ship_price_text(ship_id) .. "\n\n" .. stats
	end
	local model_path = ship and faction and ship.faction_skins[faction] and ship.faction_skins[faction].model
	local world_pos = model_path and PREVIEW_WORLD_POS[model_path]
	if not world_pos then
		stats = "(no preview available for this ship yet)\n\n" .. stats
	end
	gui.set_text(self.ship_detail_nodes.stats, stats)

	-- Not owned -> "Purchase"; owned but not the active ship -> "Select";
	-- owned AND already active -> no primary button at all (nothing for it
	-- to do - this used to be a silent no-op click on the card itself; now
	-- it's an explicit "just Cancel" state instead of a dead-end button).
	local show_primary = true
	if not owned then
		-- The price goes in the text (see `stats` above); a ship that isn't for
		-- sale (the starter) gets no Purchase button at all.
		show_primary = session.get_ship_price(ship_id) ~= nil
		gui.set_text(self.ship_detail_nodes.primary_label, "Purchase")
	elseif not is_active then
		gui.set_text(self.ship_detail_nodes.primary_label, "Select")
	else
		show_primary = false
	end

	-- Sell (direct instruction: with the separate Owned Ships list gone,
	-- this is the only place left to sell a ship) - any owned hull, active
	-- or not, same "can't sell your last ship" rule the old Owned Ships
	-- list's inline Sell button enforced.
	local sellable = owned and #(session.get_owned_ships() or {}) > 1

	-- Advance (direct instruction) - only offered for an owned ship that
	-- HAS an `advanced` table (not every ship gets one - "some of the other
	-- ships will also receive an advanced option") and isn't already there.
	local advanceable = owned and ship and ship.advanced ~= nil and not session.is_ship_advanced(ship_id)
	if advanceable then
		gui.set_text(self.ship_detail_nodes.advance_label, "Advance (" .. session.get_ship_advance_price() .. " Scrip)")
	end

	-- Open the modal FIRST, before touching the preview below - keeps the
	-- fix from §2.8.9's click-through bug (a bad texture/flipbook call must
	-- never leave the whole modal invisible just because its preview art
	-- failed) even now that there's no static image left to call
	-- gui.set_texture/play_flipbook on.
	for _, node in pairs(self.ship_detail_nodes) do
		gui.set_enabled(node, true)
	end
	gui.set_enabled(self.ship_detail_nodes.primary, show_primary)
	gui.set_enabled(self.ship_detail_nodes.primary_label, show_primary)
	gui.set_enabled(self.ship_detail_nodes.sell, sellable)
	gui.set_enabled(self.ship_detail_nodes.sell_label, sellable)
	gui.set_enabled(self.ship_detail_nodes.advance, advanceable)
	gui.set_enabled(self.ship_detail_nodes.advance_label, advanceable)

	-- Lay out whichever of {primary, advance, sell, cancel} are actually
	-- visible this time, evenly spaced and centered - rather than 4 fixed
	-- authored slots that'd leave an awkward gap whenever fewer apply.
	-- Cancel always shows, always last (rightmost).
	local slots = {}
	if show_primary then
		table.insert(slots, { self.ship_detail_nodes.primary, self.ship_detail_nodes.primary_label })
	end
	if advanceable then
		table.insert(slots, { self.ship_detail_nodes.advance, self.ship_detail_nodes.advance_label })
	end
	if sellable then
		table.insert(slots, { self.ship_detail_nodes.sell, self.ship_detail_nodes.sell_label })
	end
	table.insert(slots, { self.ship_detail_nodes.cancel, self.ship_detail_nodes.cancel_label })
	layout_detail_buttons(slots)

	-- No static 2D image anymore (removed per direct instruction, once every
	-- ship had its own live 3D preview) - `ship_detail_preview` is a plain
	-- GUI box node; the live 3D overlay below is the only thing that
	-- actually paints it (the render script only clears DEPTH for this
	-- viewport, not color, so whatever's left showing around the ship's own
	-- silhouette is this node's own base color - a dark "viewport" tone
	-- rather than a jarring flat white). A ship with no world position
	-- (below) just shows that plain dark box, honestly, instead of a stale
	-- or faked image.
	gui.set_color(self.ship_detail_nodes.preview, vmath.vector4(0.06, 0.07, 0.1, 1.0))

	-- Live 3D overlay (§2.8.9, third attempt) - purely a message to the
	-- render script itself; see PREVIEW_WORLD_POS's own comment above for
	-- why this is considered safe where the previous two attempts weren't.
	-- camera is per-model (PREVIEW_CAMERA's own comment above) - nil is
	-- fine, the render script falls back to its own built-in default.
	local camera = model_path and PREVIEW_CAMERA[model_path]
	msg.post("@render:", "set_ship_preview", {
		visible = world_pos ~= nil,
		target_pos = world_pos,
		eye_offset = camera and camera.eye_offset,
		far = camera and camera.far,
	})

	-- Suppress the Ships-For-Sale grid's own previews while this modal's
	-- single preview is showing - see refresh_forsale_preview's own comment.
	refresh_forsale_preview(self)
end

local function hide_ship_detail(self)
	self.ship_detail = nil
	for _, node in pairs(self.ship_detail_nodes) do
		gui.set_enabled(node, false)
	end
	msg.post("@render:", "set_ship_preview", { visible = false })
	-- Restore the Ships-For-Sale grid's own previews - suppressed while the
	-- modal was open (see refresh_forsale_preview's own comment below).
	refresh_forsale_preview(self)
end

-- Skin purchase modal: the ship detail modal's nodes with a thumbnail in
-- place of its live 3D preview (skins aren't bundled as models yet, so there
-- is nothing to render), the collection's details as its text, and just
-- Purchase + Cancel. Only opened for a skin the player doesn't own.
local function show_skin_detail(self, skin_id)
	local skin = skins.SKINS[skin_id]
	local collection = skin and skin_collections.COLLECTIONS[skin.collection]
	local price = session.get_skin_price(skin_id) or 0
	local ship_name = ship_display_name(session.get_ship_id(), session.get_faction())
	self.skin_detail = { skin_id = skin_id }

	gui.set_text(self.ship_detail_nodes.name, ship_name .. "  --  " .. (collection and collection.name or skin_id))
	gui.set_text(self.ship_detail_nodes.stats, table.concat({
		collection and collection.description or "",
		"",
		"Type: " .. (collection and SKIN_KIND_LABEL[collection.kind] or "?"),
		"Price: " .. price .. " Scrip",
		"Your Scrip: " .. session.get_scrip(),
		"",
		"Cosmetic only: no stat changes.",
		skin_flight.shown_in_flight(skin_id) and "Shown on your ship in flight." or "Not shown in flight yet.",
	}, "\n"))
	gui.set_text(self.ship_detail_nodes.primary_label, "Purchase (" .. price .. ")")

	for _, node in pairs(self.ship_detail_nodes) do
		gui.set_enabled(node, true)
	end
	for _, node in ipairs({ self.ship_detail_nodes.sell, self.ship_detail_nodes.sell_label,
		self.ship_detail_nodes.advance, self.ship_detail_nodes.advance_label }) do
		gui.set_enabled(node, false)
	end
	layout_detail_buttons({
		{ self.ship_detail_nodes.primary, self.ship_detail_nodes.primary_label },
		{ self.ship_detail_nodes.cancel, self.ship_detail_nodes.cancel_label },
	})

	local preview = self.ship_detail_nodes.preview
	gui.set_color(preview, SKIN_THUMB_BG)
	local texture_id = skin and skin_texture(self, skin.ship .. "-" .. skin.collection)
	if texture_id then
		local size = gui.get_size(preview)
		local thumb = gui.new_box_node(gui.get_position(preview), vmath.vector3(size.x, size.x / SKIN_THUMB_ASPECT, 0))
		gui.set_pivot(thumb, gui.PIVOT_CENTER)
		gui.set_size_mode(thumb, gui.SIZE_MODE_MANUAL)
		gui.set_texture(thumb, texture_id)
		-- Child of the preview box, so it draws with the modal (above the
		-- Skins grid) and is hidden along with it.
		gui.set_parent(thumb, preview, true)
		self.skin_detail.thumb = thumb
	end
end

local function hide_skin_detail(self)
	if self.skin_detail and self.skin_detail.thumb then
		gui.delete_node(self.skin_detail.thumb)
	end
	self.skin_detail = nil
	for _, node in pairs(self.ship_detail_nodes) do
		gui.set_enabled(node, false)
	end
end

-- Builds the render script's live-3D-preview list for the Ships-For-Sale
-- grid (direct instruction) - one entry per currently-visible grid cell
-- that actually has a model, in the same {rect, target_pos, eye_offset, far}
-- shape PREVIEW_WORLD_POS/PREVIEW_CAMERA already use for the single ship
-- detail modal preview above. `rect` only covers the area ABOVE each cell's
-- name+price strip (build_ship_forsale_grid's own SHIP_LABEL_H), so the 3D
-- overlay - drawn LAST each frame, after the normal GUI pass - never paints
-- over that strip.
--
-- A cell only makes the list if its whole rect currently sits inside
-- forsale_panel's own bounds: the render script's overlay pass isn't
-- clipped by this panel's stencil the way the cell's own box/label are (see
-- the render script's own header comment), so this check is what keeps a
-- partially-scrolled-off cell's 3D render from visually leaking past the
-- panel edge.
local function compute_forsale_preview_items(self)
	local items = {}
	local panel_pos = gui.get_position(self.forsale_panel_node)
	local panel_size = gui.get_size(self.forsale_panel_node)
	local panel_top = panel_pos.y + panel_size.y * 0.5
	local panel_bottom = panel_pos.y - panel_size.y * 0.5
	for _, card in ipairs(self.ship_cards) do
		if card.source == "ship_forsale" and card.box and card.model_path then
			local world_pos = PREVIEW_WORLD_POS[card.model_path]
			if world_pos then
				-- card.box is a child of forsale_panel_node (clipping, see
				-- init()), so gui.get_position returns a position relative
				-- to that panel - add the panel's own position back to get
				-- the absolute screen rect this render-script overlay needs.
				local local_pos = gui.get_position(card.box)
				local pos = vmath.vector3(local_pos.x + panel_pos.x, local_pos.y + panel_pos.y, 0)
				local size = gui.get_size(card.box)
				local cell_top = pos.y + size.y * 0.5
				local cell_bottom = pos.y - size.y * 0.5
				if cell_top <= panel_top and cell_bottom >= panel_bottom then
					local camera = PREVIEW_CAMERA[card.model_path]
					local preview_h = size.y - SHIP_LABEL_H
					table.insert(items, {
						rect = {
							x = pos.x - size.x / 2,
							y = cell_bottom + SHIP_LABEL_H,
							w = size.x,
							h = preview_h,
						},
						target_pos = world_pos,
						eye_offset = camera and camera.eye_offset,
						far = camera and camera.far,
					})
				end
			end
		end
	end
	return items
end

-- Sends (or clears) the Ships-For-Sale grid's live-preview list to the
-- render script. Suppressed (sent as an empty list) whenever the ship
-- detail modal is open - its own single preview overlay would otherwise
-- render alongside the grid's, since both are drawn in the same
-- LAST-after-GUI pass (§2.8.9) - or whenever the Ships tab isn't the active
-- page at all. Called from refresh_ship_cards (data/scroll changed),
-- show_ship_detail/hide_ship_detail (modal opened/closed), and set_page
-- (tab switched away).
-- Sent in small batches, not as one single message - msg.post's ad-hoc
-- Lua-table payload has a small fixed buffer, and the full 12-ship grid's
-- worth of items (each a {rect, target_pos, eye_offset, far} table)
-- overflows it in one shot: "buffer (26 bytes) too small for table,
-- exceeded at 'y' for element #2", which silently dropped the WHOLE
-- message - every grid preview went blank, not just the overflowing item.
-- The render script (render/custom.render_script) accumulates batches
-- itself, keyed by `reset` on the first one.
local FORSALE_PREVIEW_BATCH_SIZE = 4

function refresh_forsale_preview(self)
	local items = {}
	-- Also hidden under the confirm dialog: the 3D overlay draws after the GUI,
	-- so it would paint over the dialog.
	if self.active_page == "ships" and not self.ship_detail and not self.confirm then
		items = compute_forsale_preview_items(self)
	end
	if #items == 0 then
		msg.post("@render:", "set_ship_preview_grid", { items = {}, reset = true })
		return
	end
	for i = 1, #items, FORSALE_PREVIEW_BATCH_SIZE do
		local batch = {}
		for j = i, math.min(i + FORSALE_PREVIEW_BATCH_SIZE - 1, #items) do
			table.insert(batch, items[j])
		end
		msg.post("@render:", "set_ship_preview_grid", { items = batch, reset = (i == 1) })
	end
end

local function end_drag(self)
	if self.ghost then
		gui.delete_node(self.ghost.box)
		gui.delete_node(self.ghost.icon)
		self.ghost = nil
	end
	self.dragging = nil
	clear_hover(self)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("profile_resynced") then
		-- main/profile.lua: the server refused a change and its copy of the
		-- player's progress replaced ours. Redraw everything from it.
		if self.active and not self.launching then
			if self.skin_detail then
				hide_skin_detail(self)
			end
			if self.ship_detail then
				hide_ship_detail(self)
			end
			if self.confirm then
				hide_confirm(self)
			end
			end_drag(self)
			refresh_currency(self)
			local home_name, faction_label, ship_name = ship_overview_text(session.get_faction())
			gui.set_text(self.ship_node, faction_label .. "  --  " .. ship_name)
			set_page(self, self.active_page)
			show_confirm(self, "That change couldn't be saved, so your progress was reloaded from the server."
				.. (message.error and ("\n(" .. message.error .. ")") or ""), function() end, false)
		end
		return
	end
	if message_id == hash("show_outpost") then
		self.active = true
		msg.post("#gui", "enable")
		-- Reset any launch countdown left over from a PREVIOUS visit (docking
		-- always re-fires show_outpost) - without this, self.launching would
		-- still read true from before, and on_input's own modal guard for it
		-- would swallow every input forever.
		self.launching = false
		self.launch_countdown_time_left = 0
		gui.set_enabled(self.launch_countdown_node, false)
		local faction = session.get_faction()
		local home_name, faction_label, ship_name = ship_overview_text(faction)
		gui.set_text(self.title_node, home_name .. " Outpost")
		gui.set_text(self.ship_node, faction_label .. "  --  " .. ship_name)
		refresh_currency(self)
		set_page(self, "overview") -- default tab, per direct instruction
		-- Today's assignments, for the Overview (progress is kept on the server).
		network.assignments(function(result)
			if result and result.list then
				assignments_cache = result
				if self.active and not self.launching and self.active_page == "overview" then
					refresh_overview(self)
				end
			end
		end)
		-- Is this system's outpost still standing? If it has been destroyed
		-- (main/network.lua outpost_state), docked_system() is home instead:
		-- redraw the title and "Docked at" once the server has answered.
		local system_id = session.get_current_system()
		if system_id then
			network.fetch_outposts(system_id, function(ok)
				if ok and self.active and not self.launching then
					gui.set_text(self.title_node, (ship_overview_text(session.get_faction())) .. " Outpost")
					if self.active_page == "overview" then
						refresh_overview(self)
					end
				end
			end)
		end
	end
end

-- Actually starts flight - called once the LAUNCH_COUNTDOWN_SEC delay
-- armed by the launch_node click handler in on_input reaches zero (see
-- update() below). Was previously the click handler's own immediate
-- effect, before the countdown existed (per direct instruction: "when...
-- launch is triggered, countdown five seconds before launching").
local function do_launch(self)
	-- Launch is clickable from ANY tab (checked above the active_page-
	-- specific branches in on_input), including Ships with its live
	-- For-Sale grid/detail-modal previews - real bug found via direct
	-- instruction ("when I purchase and launch... I also see the grid of
	-- ships"): unlike an ordinary tab switch (set_page(), which always
	-- ends with refresh_forsale_preview()), arming the launch countdown
	-- never goes through set_page() at all, so render/custom.render_script's
	-- own "set_ship_preview"/"set_ship_preview_grid" state (a persistent
	-- overlay, entirely separate from this gui's own enable/disable) would
	-- otherwise just keep rendering through flight. Cleared directly here
	-- rather than via refresh_forsale_preview(self) - that function
	-- repopulates instead of clearing whenever self.active_page is still
	-- "ships" (the exact case that needs to become empty).
	self.ship_detail = nil
	msg.post("@render:", "set_ship_preview", { visible = false })
	msg.post("@render:", "set_ship_preview_grid", { items = {}, reset = true })
	self.launching = false
	gui.set_enabled(self.launch_countdown_node, false)
	self.active = false
	msg.post("#gui", "disable")
	msg.post("player_ship#script", "start_flight")
end

-- Animates the Ships-For-Sale grid's scroll position (direct instruction:
-- smooth scrolling instead of an instant snap) - eases self.scroll_display
-- toward self.scroll.forsale (set immediately by wheel/drag input,
-- unaffected) by SCROLL_LERP_SPEED's share of the remaining distance each
-- frame, snapping the rest of the way once close enough that the lerp would
-- otherwise never quite finish. Only touches anything while the Ships tab
-- is actually open and there's an actual gap to close - otherwise a no-op.
--
-- Also ticks the launch countdown (self.launching, armed by on_input's
-- launch_node handler) down to zero regardless of which tab is active,
-- then hands off to do_launch() above - checked first, before the
-- Ships-tab-only early return below.
function update(self, dt)
	if not self.active then
		return
	end

	if self.launching then
		self.launch_countdown_time_left = self.launch_countdown_time_left - dt
		if self.launch_countdown_time_left <= 0 then
			do_launch(self)
			return -- self.active is now false - nothing below has anything left to do
		else
			gui.set_text(self.launch_countdown_node, string.format("Launching in %d...", math.ceil(self.launch_countdown_time_left)))
		end
	end

	if self.active_page ~= "ships" then
		return
	end
	local target = self.scroll.forsale
	local display = self.scroll_display.forsale
	if display == target then
		return
	end
	if math.abs(target - display) < 0.5 then
		display = target
	else
		display = display + (target - display) * math.min(1, dt * SCROLL_LERP_SPEED)
	end
	self.scroll_display.forsale = display
	apply_forsale_scroll_display(self)
	refresh_forsale_preview(self)
	refresh_forsale_scrollbar(self)
end

function on_input(self, action_id, action)
	if not self.active then
		return false
	end

	-- Modal: while the launch countdown is running, it's the only thing
	-- that can be interacted with - swallow every other input until it
	-- actually launches (update() below ticks it down and starts flight
	-- once it reaches zero). Checked first, same footing as self.confirm/
	-- self.ship_detail below - Launch already refuses to arm a second
	-- countdown on top of a running one (see its own handler), so this is
	-- mostly a belt-and-braces guard against clicks during the delay.
	if self.launching then
		return true
	end

	-- Modal: while the confirmation dialog is open, it's the only thing
	-- that can be interacted with - swallow every other input (tabs,
	-- cards, slots, scrolling, drag) until it's resolved one way or the
	-- other.
	if self.confirm then
		if action_id == hash("touch") and action.pressed then
			if hits(self.confirm_nodes.yes, action) then
				local on_confirm = self.confirm.on_confirm
				hide_confirm(self)
				on_confirm()
				refresh_currency(self) -- Confirm is the only thing that can ever change the Scrip balance
			elseif gui.is_enabled(self.confirm_nodes.no) and hits(self.confirm_nodes.no, action) then
				hide_confirm(self)
			end
		end
		return true
	end

	-- Modal: the ship detail modal (§2.8.9) works the same way - swallow
	-- everything else until Purchase/Select or Cancel is clicked. Unlike
	-- self.confirm, Purchase/Select act immediately here (no further
	-- confirm dialog), per direct instruction - except insufficient Scrip
	-- on a Purchase, which still falls back to the plain notice-only
	-- confirm dialog (closing this one first).
	if self.ship_detail then
		if action_id == hash("touch") and action.pressed then
			if gui.is_enabled(self.ship_detail_nodes.primary) and hits(self.ship_detail_nodes.primary, action) then
				local ship_id = self.ship_detail.ship_id
				local owned = session.is_ship_owned(ship_id)
				hide_ship_detail(self)
				if owned then
					session.select_ship(ship_id)
					refresh_ship_cards(self)
					local faction = session.get_faction()
					local home_name, faction_label, ship_name = ship_overview_text(faction)
					gui.set_text(self.ship_node, faction_label .. "  --  " .. ship_name)
				else
					local name = ship_display_name(ship_id, session.get_faction())
					local price, currency = session.get_ship_price(ship_id)
					local required = session.ship_level_required(ship_id)
					if session.get_level() < required then
						show_confirm(self, name .. " needs level " .. required .. " (you're level " .. session.get_level()
							.. ", " .. session.get_rank() .. "). Earn XP by exploring, analysing asteroids,"
							.. " attacking enemy outposts and completing assignments.", function() end, false)
					elseif price and session.get_balance(currency) < price then
						show_confirm(self, "Not enough " .. CURRENCY_NAME[currency] .. " to buy " .. name
							.. " (need " .. with_commas(price) .. ", have " .. with_commas(session.get_balance(currency)) .. ").", function() end, false)
					elseif session.purchase_ship(ship_id) then
						session.select_ship(ship_id)
						refresh_ship_cards(self)
						local faction = session.get_faction()
						local home_name, faction_label, ship_name = ship_overview_text(faction)
						gui.set_text(self.ship_node, faction_label .. "  --  " .. ship_name)
						refresh_currency(self)
					end
				end
			elseif gui.is_enabled(self.ship_detail_nodes.advance) and hits(self.ship_detail_nodes.advance, action) then
				local ship_id = self.ship_detail.ship_id
				local name = ship_display_name(ship_id, session.get_faction())
				local price = session.get_ship_advance_price()
				hide_ship_detail(self)
				if session.get_scrip() < price then
					show_confirm(self, "Not enough Scrip to advance " .. name
						.. " (need " .. price .. ", have " .. session.get_scrip() .. ").", function() end)
				else
					show_confirm(self, "Advance " .. name .. " for " .. price
						.. " Scrip? This cannot be undone.", function()
						session.advance_ship(ship_id)
						refresh_ship_cards(self)
						refresh_currency(self)
					end)
				end
			elseif gui.is_enabled(self.ship_detail_nodes.sell) and hits(self.ship_detail_nodes.sell, action) then
				local ship_id = self.ship_detail.ship_id
				local name = ship_display_name(ship_id, session.get_faction())
				local refund = session.get_ship_sell_refund()
				hide_ship_detail(self)
				show_confirm(self, "Sell " .. name .. " for " .. refund .. " Scrip?", function()
					session.sell_ship(ship_id)
					refresh_ship_cards(self)
					local faction = session.get_faction()
					local home_name, faction_label, ship_name = ship_overview_text(faction)
					gui.set_text(self.ship_node, faction_label .. "  --  " .. ship_name)
				end)
			elseif hits(self.ship_detail_nodes.cancel, action) then
				hide_ship_detail(self)
			end
		end
		return true
	end

	-- Modal: skin purchase (show_skin_detail). Buying equips the skin at
	-- once, same as buying a ship selects it.
	if self.skin_detail then
		if action_id == hash("touch") and action.pressed then
			if hits(self.ship_detail_nodes.primary, action) then
				local skin_id = self.skin_detail.skin_id
				local price = session.get_skin_price(skin_id) or 0
				hide_skin_detail(self)
				if session.get_scrip() < price then
					show_confirm(self, "Not enough Scrip for this skin (need " .. price
						.. ", have " .. session.get_scrip() .. ").", function() end, false)
				elseif session.purchase_skin(skin_id) then
					session.equip_skin(session.get_ship_id(), skin_id)
					refresh_currency(self)
				end
				refresh_skin_cards(self)
			elseif hits(self.ship_detail_nodes.cancel, action) then
				hide_skin_detail(self)
			end
		end
		return true
	end

	-- Unbound mouse movement arrives with action_id == nil but still
	-- carries live x/y - used here to make the ghost node follow the
	-- cursor AND to update the drag-over slot highlight, while a drag is
	-- in progress.
	if action_id == nil then
		if self.dragging and self.ghost then
			local pos = vmath.vector3(action.x, action.y, 0)
			gui.set_position(self.ghost.box, pos)
			gui.set_position(self.ghost.icon, pos)
			update_hover(self, action)
			hide_weapon_arc(self) -- mid-drag already has its own hover feedback (the border highlight above)
		elseif self.active_page == "fitting" then
			update_weapon_arc_hover(self, action)
		else
			hide_weapon_arc(self)
		end
		-- Ships-For-Sale drag-to-scroll (direct instruction) - see
		-- self.forsale_press's own comment (init) and the "ships" tab press
		-- handling above for how it's started/resolved. Moves the TARGET
		-- (self.scroll.forsale) but snaps the display straight to it rather
		-- than going through update()'s own lerp - while the cursor is
		-- actively dragging it, the content should track the cursor exactly,
		-- not lag behind it; the eased animation is only for
		-- wheel/momentum-less discrete scroll steps.
		if self.forsale_press then
			local delta = action.y - self.forsale_press.last_y
			self.forsale_press.last_y = action.y
			if not self.forsale_press.dragged and math.abs(action.y - self.forsale_press.start_y) > DRAG_CLICK_THRESHOLD then
				self.forsale_press.dragged = true
			end
			if self.forsale_press.dragged then
				local max_scroll = max_scroll_for_grid()
				self.scroll.forsale = math.max(0, math.min(self.scroll.forsale + delta, max_scroll))
				self.scroll_display.forsale = self.scroll.forsale
				apply_forsale_scroll_display(self)
				refresh_forsale_preview(self)
				refresh_forsale_scrollbar(self)
			end
		end
		return false
	end

	-- Mouse wheel scrolling for whichever card-list panel is currently
	-- under the cursor (plan.md §4). Reuses the "zoom_in"/"zoom_out"
	-- input actions already bound to MOUSE_WHEEL_UP/DOWN
	-- (input/game.input_binding, originally meant for flight-mode camera
	-- zoom) - the physical wheel is what matters here, not that binding's
	-- flight-camera name.
	if action_id == hash("zoom_in") or action_id == hash("zoom_out") then
		local delta = (action_id == hash("zoom_in")) and -SCROLL_STEP or SCROLL_STEP
		if self.active_page == "fitting" then
			if hits(self.shop_panel_node, action) then
				self.scroll.shop = math.max(0, math.min(self.scroll.shop + delta, max_scroll_for(#shop_rows(self.type_filter))))
				refresh_module_cards(self)
			elseif hits(self.owned_panel_node, action) then
				self.scroll.owned = math.max(0, math.min(self.scroll.owned + delta, max_scroll_for(#owned_spare_rows(self.type_filter))))
				refresh_module_cards(self)
			end
		else
			if hits(self.forsale_panel_node, action) then
				-- Grid, not list, so it scrolls half a row (SCROLL_STEP_GRID)
				-- per wheel notch, not a full CARD_SPACING row - only moves
				-- the TARGET; update()'s own per-frame lerp eases the actual
				-- displayed position toward it (direct instruction: smooth
				-- animated scrolling instead of an instant snap/rebuild).
				local delta_grid = (action_id == hash("zoom_in")) and -SCROLL_STEP_GRID or SCROLL_STEP_GRID
				self.scroll.forsale = math.max(0, math.min(self.scroll.forsale + delta_grid, max_scroll_for_grid()))
			end
		end
		return true
	end

	if action_id ~= hash("touch") then
		return false
	end

	if action.pressed then
		if hits(self.tab_nodes.overview, action) then
			set_page(self, "overview")
			return true
		elseif hits(self.tab_nodes.fitting, action) then
			set_page(self, "fitting")
			return true
		elseif hits(self.tab_nodes.ships, action) then
			set_page(self, "ships")
			return true
		elseif hits(self.tab_nodes.map, action) then
			set_page(self, "map")
			return true
		elseif hits(self.tab_nodes.skins, action) then
			set_page(self, "skins")
			return true
		elseif hits(self.logout_node, action) then
			-- Overview clears every tab's dynamic nodes and the render
			-- script's 3D previews before the screen goes away.
			set_page(self, "overview")
			self.active = false
			msg.post("#gui", "disable")
			profile.flush(function()
				network.logout()
				network.open_account()
			end)
			return true
		elseif hits(self.launch_node, action) then
			-- Minimal flight-mode slice (plan.md §4/§2.8.10-adjacent, per
			-- direct instruction) - same "disable self, tell the next screen
			-- to show" hand-off start_screen/faction_select already use, just
			-- to a plain game object's script (player_ship.script) instead of
			-- another gui_script, since flight needs go.*/camera.* access a
			-- gui_script doesn't have (same limitation the reference project's
			-- own hud.gui_script header comment notes). Arms the
			-- LAUNCH_COUNTDOWN_SEC delay (per direct instruction) rather than
			-- launching immediately - do_launch() above is what actually does
			-- that, called from update() once the countdown below reaches
			-- zero. Guarded against re-arming a second countdown on top of a
			-- running one - shouldn't be reachable anyway (on_input's own
			-- self.launching modal guard swallows this click first), but
			-- cheap to also check directly here.
			if not self.launching then
				self.launching = true
				self.launch_countdown_time_left = LAUNCH_COUNTDOWN_SEC
				gui.set_enabled(self.launch_countdown_node, true)
				gui.set_text(self.launch_countdown_node, string.format("Launching in %d...", LAUNCH_COUNTDOWN_SEC))
			end
			return true
		end

		if self.active_page == "overview" then
			-- Read-only: no clickable content of its own, just the shared
			-- tab bar to navigate away (no separate "Go to" links - removed
			-- per direct instruction as redundant with the tab bar).
			return false
		end

		if self.active_page == "skins" then
			-- Owned (including Default): equip straight away. Not owned: open
			-- the purchase modal. The equipped card does nothing.
			if not hits(self.skins_panel_node, action) then
				return false
			end
			for _, card in ipairs(self.skin_cards) do
				if card.owned ~= nil and hits(card.box, action) then
					if not card.owned then
						show_skin_detail(self, card.skin_id)
					elseif not card.equipped then
						session.equip_skin(session.get_ship_id(), card.skin_id)
						refresh_skin_cards(self)
					end
					return true
				end
			end
			return true
		end

		if self.active_page == "ships" then
			-- Single merged panel now (direct instruction: no separate Owned
			-- Ships list) - press-and-drag-to-scroll, resolved on release
			-- (on_input's action.released branch) as either a click (opens
			-- whichever card, if any, was under the initial press) or a
			-- drag-scroll, depending on how far the cursor moved in between
			-- (DRAG_CLICK_THRESHOLD). In practice the grid fits all 3 rows
			-- without scrolling (SHIPS_PANEL_HEIGHT), so this almost always
			-- resolves as a plain click. Selling now happens from inside the
			-- detail modal itself (show_ship_detail/on_input's modal branch),
			-- not a card's own inline button.
			if hits(self.forsale_panel_node, action) then
				local hit_item_key = nil
				for _, card in ipairs(self.ship_cards) do
					if card.source == "ship_forsale" and card.box and hits(card.box, action) then
						hit_item_key = card.item_key
						break
					end
				end
				self.forsale_press = { item_key = hit_item_key, start_y = action.y, last_y = action.y, dragged = false }
				return true
			end
			return false
		end

		-- Fitting tab: type-filter buttons (§2.8.8) - clicking a type narrows
		-- both Shop and Owned to that type; clicking the already-active one
		-- clears the filter back to showing everything. Checked before the
		-- marker/card hit-tests below since it's its own click target, not a
		-- drag source.
		for _, type_name in ipairs(FILTER_TYPE_ORDER) do
			if hits(self.filter_nodes[type_name], action) then
				-- NOTE: deliberately an if/else, not the usual "cond and a or
				-- b" idiom - that idiom breaks when the "true" branch value
				-- is itself nil/false (here, clearing the filter), since
				-- "cond and nil" is always nil, so the "or b" always wins
				-- regardless of cond. Caught by this feature's own test
				-- harness case (clicking an active filter again silently
				-- failed to clear it) before this ever reached a real build.
				if self.type_filter == type_name then
					self.type_filter = nil
				else
					self.type_filter = type_name
				end
				refresh_filter_buttons(self)
				refresh_module_cards(self)
				return true
			end
		end

		-- Fitting tab: start dragging an installed item off its slot marker
		for slot_id, marker in pairs(self.markers) do
			if hits(marker.box, action) then
				local loadout = session.get_loadout() or {}
				for _, entry in ipairs(loadout) do
					if entry.slot == slot_id then
						start_drag(self, "slot", entry.instance_id, slot_id, action)
						update_hover(self, action)
						return true
					end
				end
				return false -- empty slot, nothing to drag
			end
		end
		-- start dragging a module card from either list - a Shop card
		-- carries a catalog item_key (no instance exists until it's
		-- actually dropped, §4), an Owned card carries the specific
		-- instance_id being moved.
		for _, card in ipairs(self.cards) do
			local panel_node = panel_for_card(self, card)

			-- Sell button (Owned spares only, §2.8/§4) - checked before
			-- the card's own drag-start hit so the two don't fire
			-- together (the two nodes overlap on screen: sell_box sits
			-- inside card.box's own full-width footprint).
			if card.sell_box and hits(card.sell_box, action) and hits(panel_node, action) then
				local module = catalog.get(card.item_key)
				local name = module and module.name or card.item_key
				local instance_id = card.instance_id
				local refund = session.get_module_sell_refund()
				show_confirm(self, "Sell " .. name .. " for " .. refund .. " Scrip?", function()
					session.sell(instance_id)
					refresh_module_cards(self)
				end)
				return true
			end

			if card.box and hits(card.box, action) and hits(panel_node, action) then
				local ref = (card.source == "shop") and card.item_key or card.instance_id
				start_drag(self, card.source, ref, nil, action)
				update_hover(self, action)
				return true
			end
		end
		return false
	elseif action.released and self.dragging then
		local drag = self.dragging
		local dropped_on_slot = nil
		local dropped_on_locked_slot = nil
		for slot_id, marker in pairs(self.markers) do
			if marker.type == drag.type and hits(marker.box, action) then
				if marker.locked then
					dropped_on_locked_slot = slot_id
				else
					dropped_on_slot = slot_id
				end
				break
			end
		end
		-- Dropped on a same-type slot that's only there for the ship's
		-- advanced tier (direct instruction) - explain why nothing happened
		-- rather than the plain silent no-op every other invalid drop gets
		-- (dropped on empty space, wrong type, etc. - those stay silent).
		if dropped_on_locked_slot then
			end_drag(self)
			-- Direct instruction: purely informational, no actual choice to
			-- make, so show only the one acknowledge button (show_cancel=false).
			show_confirm(self, "Slot " .. dropped_on_locked_slot
				.. " is only available once this ship has been advanced.", function() end, false)
			return true
		end
		if dropped_on_slot then
			-- Any PURCHASE (shop-sourced) or SWAP (displacing whatever's
			-- already installed in dropped_on_slot) needs a confirmation
			-- dialog before it actually happens, per direct instruction.
			-- Plain installs from an Owned/slot source into an EMPTY slot
			-- don't - nothing is being bought or replaced, so those still
			-- apply immediately below. Dropping an item back onto the
			-- exact slot it was just dragged off of doesn't count as a
			-- swap either - nothing would actually change.
			local is_purchase = drag.source == "shop"
			local existing_instance_id = nil
			for _, entry in ipairs(session.get_loadout() or {}) do
				if entry.slot == dropped_on_slot then
					existing_instance_id = entry.instance_id
				end
			end
			local is_swap = existing_instance_id ~= nil
				and not (drag.source == "slot" and drag.from_slot == dropped_on_slot)

			if is_purchase or is_swap then
				local module = catalog.get(drag.item_key)
				local module_name = module and module.name or drag.item_key
				local existing_name
				if is_swap then
					local existing = session.get_instance(existing_instance_id)
					local existing_module = existing and catalog.get(existing.item_key)
					existing_name = existing_module and existing_module.name or "the installed item"
				end
				local price = session.get_module_price()

				local pending_item_key = drag.item_key
				local pending_instance_id = drag.instance_id
				local pending_source = drag.source
				local pending_slot = dropped_on_slot
				end_drag(self) -- ends the drag visually either way; nothing installs until confirmed

				if is_purchase and session.get_scrip() < price then
					show_confirm(self, "Not enough Scrip to buy " .. module_name
						.. " (need " .. price .. ", have " .. session.get_scrip() .. ").", function() end)
					return true
				end

				local message
				if is_purchase and is_swap then
					message = "Buy " .. module_name .. " for " .. price .. " Scrip and swap it into " .. dropped_on_slot
						.. ", replacing " .. existing_name .. "?"
				elseif is_purchase then
					message = "Buy " .. module_name .. " for " .. price .. " Scrip and install it in " .. dropped_on_slot .. "?"
				else
					message = "Swap " .. module_name .. " into " .. dropped_on_slot
						.. ", replacing " .. existing_name .. "?"
				end

				show_confirm(self, message, function()
					local instance_id = pending_instance_id
					if pending_source == "shop" then
						instance_id = session.purchase(pending_item_key)
					end
					if instance_id then
						session.install(pending_slot, instance_id)
					end
					refresh_markers(self)
					refresh_module_cards(self)
				end)
				return true
			end

			session.install(dropped_on_slot, drag.instance_id)
		elseif drag.source == "slot" then
			session.uninstall(drag.from_slot)
		end
		-- otherwise (owned/shop card dropped somewhere invalid): no-op, cancel
		end_drag(self)
		refresh_markers(self)
		refresh_module_cards(self)
		return true
	elseif action.released and self.forsale_press then
		-- Resolves a Ships-For-Sale press (started above, in the "ships"
		-- active_page press handling) as a click only if the cursor never
		-- moved past DRAG_CLICK_THRESHOLD - a real drag-scroll (already
		-- applied live, per motion, in the action_id == nil branch above)
		-- never also opens the ship detail modal on release.
		local press = self.forsale_press
		self.forsale_press = nil
		if not press.dragged and press.item_key then
			show_ship_detail(self, press.item_key)
		end
		return true
	end
	return false
end
