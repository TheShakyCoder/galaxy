	["/assets/models/frigate_interceptor/frigatebird.model"] = { eye_offset = vmath.vector3(0, 227.83, 607.55), far = 1019.85 },
	-- remora.glb (glaive.glb, §0-flagged, see ships.lua's escort_support entry)
