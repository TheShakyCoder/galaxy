	["/assets/models/frigate_support/manta_ray.model"] = { eye_offset = vmath.vector3(0, 202.75, 540.65), far = 913.06 },
	-- tiger_shark.glb (jotunn.glb, §0-flagged, see ships.lua's frigate_assault
	-- entry) has a ~327-unit world-space bounding radius, no node-level scale
	-- transform on this asset.
	["/assets/models/frigate_assault/tiger_shark.model"] = { eye_offset = vmath.vector3(0, 232.09, 618.9), far = 1037.97 },
	-- oxpecker.glb (heavy_raider.glb, §0-flagged, see ships.lua's patrol_support
	-- entry) has a ~5.8-unit world-space bounding radius, no node-level scale
	-- transform on this asset.
	["/assets/models/patrol_support/oxpecker.model"] = { eye_offset = vmath.vector3(0, 4.09, 10.91), far = 67.42 },
	-- shrike.glb (marauder.glb, §0-flagged, see ships.lua's patrol_assault
	-- entry) has a ~8.4-unit world-space bounding radius, no node-level scale
	-- transform on this asset.
	["/assets/models/patrol_assault/shrike.model"] = { eye_offset = vmath.vector3(0, 5.94, 15.83), far = 75.27 },
	-- kingfisher.glb (war_raider.glb, §0-flagged, see ships.lua's
	-- patrol_tactical entry) has a ~8.2-unit world-space bounding radius, no
	-- node-level scale transform on this asset.
	["/assets/models/patrol_tactical/kingfisher.model"] = { eye_offset = vmath.vector3(0, 5.82, 15.52), far = 74.78 },
	-- egret.glb (spectre.glb, §0-flagged, see ships.lua's escort_support entry)
	-- has a ~146-unit world-space bounding radius, no node-level scale
	-- transform on this asset.
	["/assets/models/escort_support/egret.model"] = { eye_offset = vmath.vector3(0, 103.38, 275.69), far = 490.09 },
	-- goshawk.glb (wraith.glb, §0-flagged, see ships.lua's escort_assault
	-- entry) has a ~146-unit world-space bounding radius, no node-level scale
	-- transform on this asset.
	["/assets/models/escort_assault/goshawk.model"] = { eye_offset = vmath.vector3(0, 103.63, 276.34), far = 491.13 },
	-- pilotfish.glb (raptor.glb, §0-flagged, see ships.lua's patrol_support
	-- entry) has a ~7-unit world-space bounding radius, no node-level scale
	-- transform on this asset.
	["/assets/models/patrol_support/pilotfish.model"] = { eye_offset = vmath.vector3(0, 4.94, 13.17), far = 71.02 },
	-- anglerfish.glb (viper_mk7.glb, §0-flagged, see ships.lua's
	-- patrol_tactical entry) has a ~5.9-unit world-space bounding radius, no
	-- node-level scale transform on this asset.
	["/assets/models/patrol_tactical/anglerfish.model"] = { eye_offset = vmath.vector3(0, 4.16, 11.1), far = 67.72 },
}

-- Real stat block for the detail modal - straight from main/data/ships.lua's
-- `data` (Hull/Engine/FTL/Computer baseline, §2.1.1) and `components` (W/C/E/H
-- slot counts, §2.8), same numbers the Overview tab's fitting breakdown
-- already reads. A curated subset, not every field in `data` - legible in the
-- modal's fixed-size panel rather than a full engineering dump.
local function ship_stats_text(ship_id)
	local ship = ships.SHIPS[ship_id]
	if not ship then
		return ""
	end
	local d = ship.data or {}
	local c = ship.components or {}
	local lines = {
		"Class: " .. (ship.class or "?"),
		"",
		"Hull Points: " .. (d.hull_points or "?"),
		"Armor: " .. (d.armor or "?"),
		"Speed: " .. (d.speed_m_per_sec or "?") .. " m/s  (Boost: " .. (d.boost_speed_m_per_sec or "?") .. " m/s)",
		"FTL Range: " .. (d.ftl_range_ly or "?") .. " ly",
		"Power: " .. (d.power or "?"),
		"Sensor Range: " .. (d.sensor_range_m or "?") .. " m",
		"",
		"Slots: W" .. (c.W or 0) .. "  C" .. (c.C or 0) .. "  E" .. (c.E or 0) .. "  H" .. (c.H or 0),
	}
	return table.concat(lines, "\n")
end

-- Opens the ship detail modal (§2.8.9) for `ship_id` - replaces the old
-- straight-to-confirm-dialog behavior on a Ships tab card click. Figures out
-- its own button state (Purchase/Select/just-Cancel) from real session state
-- rather than the caller needing to know which case applies.
local function show_ship_detail(self, ship_id)
	local ship = ships.SHIPS[ship_id]
	local faction = session.get_faction()
	local owned = session.is_ship_owned(ship_id)
	local is_active = ship_id == session.get_ship_id()

	self.ship_detail = { ship_id = ship_id }
	gui.set_text(self.ship_detail_nodes.name, ship_display_name(ship_id, faction) .. "  (" .. (ship and ship.class or "?") .. ")")

	local stats = ship_stats_text(ship_id)
	local model_path = ship and faction and ship.faction_skins[faction] and ship.faction_skins[faction].model
	local world_pos = model_path and PREVIEW_WORLD_POS[model_path]
	if not world_pos then
		stats = "(no preview available for this ship yet)\n\n" .. stats
	end
	gui.set_text(self.ship_detail_nodes.stats, stats)

	-- Not owned -> "Purchase"; owned but not the active ship -> "Select";
	-- owned AND already active -> no primary button at all (nothing for it
	-- to do - this used to be a silent no-op click on the card itself; now
	-- it's an explicit "just Cancel" state instead of a dead-end button).
	local show_primary = true
	if not owned then
		gui.set_text(self.ship_detail_nodes.primary_label, "Purchase")
	elseif not is_active then
		gui.set_text(self.ship_detail_nodes.primary_label, "Select")
	else
		show_primary = false
	end

	-- Open the modal FIRST, before touching the preview below - keeps the
	-- fix from §2.8.9's click-through bug (a bad texture/flipbook call must
	-- never leave the whole modal invisible just because its preview art
	-- failed) even now that there's no static image left to call
	-- gui.set_texture/play_flipbook on.
	for _, node in pairs(self.ship_detail_nodes) do
		gui.set_enabled(node, true)
	end
	gui.set_enabled(self.ship_detail_nodes.primary, show_primary)
	gui.set_enabled(self.ship_detail_nodes.primary_label, show_primary)

	-- No static 2D image anymore (removed per direct instruction, once every
	-- ship had its own live 3D preview) - `ship_detail_preview` is a plain
	-- GUI box node; the live 3D overlay below is the only thing that
	-- actually paints it (the render script only clears DEPTH for this
	-- viewport, not color, so whatever's left showing around the ship's own
	-- silhouette is this node's own base color - a dark "viewport" tone
	-- rather than a jarring flat white). A ship with no world position
	-- (below) just shows that plain dark box, honestly, instead of a stale
	-- or faked image.
	gui.set_color(self.ship_detail_nodes.preview, vmath.vector4(0.06, 0.07, 0.1, 1.0))

	-- Live 3D overlay (§2.8.9, third attempt) - purely a message to the
	-- render script itself; see PREVIEW_WORLD_POS's own comment above for
	-- why this is considered safe where the previous two attempts weren't.
	-- camera is per-model (PREVIEW_CAMERA's own comment above) - nil is
	-- fine, the render script falls back to its own built-in default.
	local camera = model_path and PREVIEW_CAMERA[model_path]
	msg.post("@render:", "set_ship_preview", {
		visible = world_pos ~= nil,
		target_pos = world_pos,
		eye_offset = camera and camera.eye_offset,
		far = camera and camera.far,
	})

	-- Suppress the Ships-For-Sale grid's own previews while this modal's
	-- single preview is showing - see refresh_forsale_preview's own comment.
	refresh_forsale_preview(self)
end

local function hide_ship_detail(self)
	self.ship_detail = nil
	for _, node in pairs(self.ship_detail_nodes) do
		gui.set_enabled(node, false)
	end
	msg.post("@render:", "set_ship_preview", { visible = false })
	-- Restore the Ships-For-Sale grid's own previews - suppressed while the
	-- modal was open (see refresh_forsale_preview's own comment below).
	refresh_forsale_preview(self)
end

-- Builds the render script's live-3D-preview list for the Ships-For-Sale
-- grid (direct instruction) - one entry per currently-visible grid cell
-- that actually has a model, in the same {rect, target_pos, eye_offset, far}
-- shape PREVIEW_WORLD_POS/PREVIEW_CAMERA already use for the single ship
-- detail modal preview above. `rect` only covers the area ABOVE each cell's
-- name+price strip (build_ship_forsale_grid's own GRID_LABEL_H), so the 3D
-- overlay - drawn LAST each frame, after the normal GUI pass - never paints
-- over that strip.
--
-- A cell only makes the list if its whole rect currently sits inside
-- forsale_panel's own bounds: the render script's overlay pass isn't
-- clipped by this panel's stencil the way the cell's own box/label are (see
-- the render script's own header comment), so this check is what keeps a
-- partially-scrolled-off cell's 3D render from visually leaking past the
-- panel edge.
local function compute_forsale_preview_items(self)
	local items = {}
	local panel_pos = gui.get_position(self.forsale_panel_node)
	local panel_size = gui.get_size(self.forsale_panel_node)
	local panel_top = panel_pos.y + panel_size.y * 0.5
	local panel_bottom = panel_pos.y - panel_size.y * 0.5
	for _, card in ipairs(self.ship_cards) do
		if card.source == "ship_forsale" and card.box and card.model_path then
			local world_pos = PREVIEW_WORLD_POS[card.model_path]
			if world_pos then
				local pos = gui.get_position(card.box)
				local size = gui.get_size(card.box)
				local cell_top = pos.y + size.y * 0.5
				local cell_bottom = pos.y - size.y * 0.5
				if cell_top <= panel_top and cell_bottom >= panel_bottom then
					local camera = PREVIEW_CAMERA[card.model_path]
					local preview_h = size.y - GRID_LABEL_H
					table.insert(items, {
						rect = {
							x = pos.x - size.x / 2,
							y = cell_bottom + GRID_LABEL_H,
							w = size.x,
							h = preview_h,
						},
						target_pos = world_pos,
						eye_offset = camera and camera.eye_offset,
						far = camera and camera.far,
					})
				end
			end
		end
	end
	return items
end

-- Sends (or clears) the Ships-For-Sale grid's live-preview list to the
-- render script. Suppressed (sent as an empty list) whenever the ship
-- detail modal is open - its own single preview overlay would otherwise
-- render alongside the grid's, since both are drawn in the same
-- LAST-after-GUI pass (§2.8.9) - or whenever the Ships tab isn't the active
-- page at all. Called from refresh_ship_cards (data/scroll changed),
-- show_ship_detail/hide_ship_detail (modal opened/closed), and set_page
-- (tab switched away).
function refresh_forsale_preview(self)
	local items = {}
	if self.active_page == "ships" and not self.ship_detail then
		items = compute_forsale_preview_items(self)
	end
	msg.post("@render:", "set_ship_preview_grid", { items = items })
end

local function end_drag(self)
	if self.ghost then
		gui.delete_node(self.ghost.box)
		gui.delete_node(self.ghost.label)
		self.ghost = nil
	end
	self.dragging = nil
	clear_hover(self)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("show_outpost") then
		self.active = true
		msg.post("#gui", "enable")
		local faction = session.get_faction()
		local home_name, faction_label, ship_name = ship_overview_text(faction)
		gui.set_text(self.title_node, home_name .. " Outpost")
		gui.set_text(self.ship_node, faction_label .. "  --  " .. ship_name)
		refresh_currency(self)
		set_page(self, "overview") -- default tab, per direct instruction
	end
end

-- Animates the Ships-For-Sale grid's scroll position (direct instruction:
-- smooth scrolling instead of an instant snap) - eases self.scroll_display
-- toward self.scroll.forsale (set immediately by wheel/drag input,
-- unaffected) by SCROLL_LERP_SPEED's share of the remaining distance each
-- frame, snapping the rest of the way once close enough that the lerp would
-- otherwise never quite finish. Only touches anything while the Ships tab
-- is actually open and there's an actual gap to close - otherwise a no-op.
function update(self, dt)
	if not self.active or self.active_page ~= "ships" then
		return
	end
	local target = self.scroll.forsale
	local display = self.scroll_display.forsale
	if display == target then
		return
	end
	if math.abs(target - display) < 0.5 then
		display = target
	else
		display = display + (target - display) * math.min(1, dt * SCROLL_LERP_SPEED)
	end
	self.scroll_display.forsale = display
	apply_forsale_scroll_display(self)
	refresh_forsale_preview(self)
	refresh_forsale_scrollbar(self)
end

function on_input(self, action_id, action)
	if not self.active then
		return false
	end

	-- Modal: while the confirmation dialog is open, it's the only thing
	-- that can be interacted with - swallow every other input (tabs,
	-- cards, slots, scrolling, drag) until it's resolved one way or the
	-- other.
	if self.confirm then
		if action_id == hash("touch") and action.pressed then
			if hits(self.confirm_nodes.yes, action) then
				local on_confirm = self.confirm.on_confirm
				hide_confirm(self)
				on_confirm()
				refresh_currency(self) -- Confirm is the only thing that can ever change the Scrip balance
			elseif hits(self.confirm_nodes.no, action) then
				hide_confirm(self)
			end
		end
		return true
	end

	-- Modal: the ship detail modal (§2.8.9) works the same way - swallow
	-- everything else until Purchase/Select or Cancel is clicked. Unlike
	-- self.confirm, Purchase/Select act immediately here (no further
	-- confirm dialog), per direct instruction - except insufficient Scrip
	-- on a Purchase, which still falls back to the plain notice-only
	-- confirm dialog (closing this one first).
	if self.ship_detail then
		if action_id == hash("touch") and action.pressed then
			if hits(self.ship_detail_nodes.primary, action) then
				local ship_id = self.ship_detail.ship_id
				local owned = session.is_ship_owned(ship_id)
				hide_ship_detail(self)
				if owned then
					session.select_ship(ship_id)
					refresh_ship_cards(self)
					local faction = session.get_faction()
					local home_name, faction_label, ship_name = ship_overview_text(faction)
					gui.set_text(self.ship_node, faction_label .. "  --  " .. ship_name)
				else
					local name = ship_display_name(ship_id, session.get_faction())
					local price = session.get_ship_price()
					if session.get_scrip() < price then
						show_confirm(self, "Not enough Scrip to buy " .. name
							.. " (need " .. price .. ", have " .. session.get_scrip() .. ").", function() end)
					elseif session.purchase_ship(ship_id) then
						session.select_ship(ship_id)
						refresh_ship_cards(self)
						local faction = session.get_faction()
						local home_name, faction_label, ship_name = ship_overview_text(faction)
						gui.set_text(self.ship_node, faction_label .. "  --  " .. ship_name)
						refresh_currency(self)
					end
				end
			elseif hits(self.ship_detail_nodes.cancel, action) then
				hide_ship_detail(self)
			end
		end
		return true
	end

	-- Unbound mouse movement arrives with action_id == nil but still
	-- carries live x/y - used here to make the ghost node follow the
	-- cursor AND to update the drag-over slot highlight, while a drag is
	-- in progress.
	if action_id == nil then
		if self.dragging and self.ghost then
			local pos = vmath.vector3(action.x, action.y, 0)
			gui.set_position(self.ghost.box, pos)
			gui.set_position(self.ghost.label, pos)
			update_hover(self, action)
		end
		-- Ships-For-Sale drag-to-scroll (direct instruction) - see
		-- self.forsale_press's own comment (init) and the "ships" tab press
		-- handling above for how it's started/resolved. Moves the TARGET
		-- (self.scroll.forsale) but snaps the display straight to it rather
		-- than going through update()'s own lerp - while the cursor is
		-- actively dragging it, the content should track the cursor exactly,
		-- not lag behind it; the eased animation is only for
		-- wheel/momentum-less discrete scroll steps.
		if self.forsale_press then
			local delta = action.y - self.forsale_press.last_y
			self.forsale_press.last_y = action.y
			if not self.forsale_press.dragged and math.abs(action.y - self.forsale_press.start_y) > DRAG_CLICK_THRESHOLD then
				self.forsale_press.dragged = true
			end
			if self.forsale_press.dragged then
				local max_scroll = max_scroll_for_grid(#ship_forsale_rows(session.get_faction()))
				self.scroll.forsale = math.max(0, math.min(self.scroll.forsale + delta, max_scroll))
				self.scroll_display.forsale = self.scroll.forsale
				apply_forsale_scroll_display(self)
				refresh_forsale_preview(self)
				refresh_forsale_scrollbar(self)
			end
		end
		return false
	end

	-- Mouse wheel scrolling for whichever card-list panel is currently
	-- under the cursor (plan.md §4). Reuses the "zoom_in"/"zoom_out"
	-- input actions already bound to MOUSE_WHEEL_UP/DOWN
	-- (input/game.input_binding, originally meant for flight-mode camera
	-- zoom) - the physical wheel is what matters here, not that binding's
	-- flight-camera name.
	if action_id == hash("zoom_in") or action_id == hash("zoom_out") then
		local delta = (action_id == hash("zoom_in")) and -SCROLL_STEP or SCROLL_STEP
		if self.active_page == "fitting" then
			if hits(self.shop_panel_node, action) then
				self.scroll.shop = math.max(0, math.min(self.scroll.shop + delta, max_scroll_for(#shop_rows(self.type_filter))))
				refresh_module_cards(self)
			elseif hits(self.owned_panel_node, action) then
				self.scroll.owned = math.max(0, math.min(self.scroll.owned + delta, max_scroll_for(#owned_spare_rows(self.type_filter))))
				refresh_module_cards(self)
			end
		else
			if hits(self.forsale_panel_node, action) then
				-- Grid, not list, so it scrolls half a row (SCROLL_STEP_GRID)
				-- per wheel notch, not a full CARD_SPACING row - only moves
				-- the TARGET; update()'s own per-frame lerp eases the actual
				-- displayed position toward it (direct instruction: smooth
				-- animated scrolling instead of an instant snap/rebuild).
				local delta_grid = (action_id == hash("zoom_in")) and -SCROLL_STEP_GRID or SCROLL_STEP_GRID
				self.scroll.forsale = math.max(0, math.min(self.scroll.forsale + delta_grid, max_scroll_for_grid(#ship_forsale_rows(session.get_faction()))))
			elseif hits(self.ownedships_panel_node, action) then
				self.scroll.ownedships = math.max(0, math.min(self.scroll.ownedships + delta, max_scroll_for(#owned_ship_rows(session.get_faction(), session.get_ship_id()))))
				refresh_ship_cards(self)
			end
		end
		return true
	end

	if action_id ~= hash("touch") then
		return false
	end

	if action.pressed then
		if hits(self.tab_nodes.overview, action) then
			set_page(self, "overview")
			return true
		elseif hits(self.tab_nodes.fitting, action) then
			set_page(self, "fitting")
			return true
		elseif hits(self.tab_nodes.ships, action) then
			set_page(self, "ships")
			return true
		elseif hits(self.launch_node, action) then
			print("[outpost] Launch pressed -- flight mode not built yet")
			return true
		end

		if self.active_page == "overview" then
			-- Read-only: no clickable content of its own, just the shared
			-- tab bar to navigate away (no separate "Go to" links - removed
			-- per direct instruction as redundant with the tab bar).
			return false
		end

		if self.active_page == "ships" then
			-- Ships-For-Sale grid: press-and-drag-to-scroll (direct
			-- instruction), checked BEFORE the click-to-act loop below so a
			-- press anywhere in this one panel is never acted on immediately
			-- - it's resolved on release (on_input's action.released branch)
			-- as either a click (opens whichever card, if any, was under the
			-- initial press) or a drag-scroll, depending on how far the
			-- cursor moved in between (DRAG_CLICK_THRESHOLD). This is what
			-- lets the grid be scrolled by dragging its own content, not
			-- just the mouse wheel, without a drag ever accidentally
			-- opening a ship's detail modal mid-scroll. Owned Ships (the
			-- other list on this tab) is unaffected - still click-on-press,
			-- same as every other card list on this whole screen.
			if hits(self.forsale_panel_node, action) then
				local hit_item_key = nil
				for _, card in ipairs(self.ship_cards) do
					if card.source == "ship_forsale" and card.box and hits(card.box, action) then
						hit_item_key = card.item_key
						break
					end
				end
				self.forsale_press = { item_key = hit_item_key, start_y = action.y, last_y = action.y, dragged = false }
				return true
			end

			-- Click-to-act, no drag, for everything else on this tab.
			-- Clicking a card opens the ship detail modal (§2.8.9, per
			-- direct instruction) instead of going straight to a confirm
			-- dialog - that modal figures out its own Purchase/Select/
			-- just-Cancel state and performs the action immediately on its
			-- own button. Selling is unchanged: still the card's own inline
			-- Sell button + the plain confirm dialog (§2.8.7), checked
			-- first so it doesn't also open the detail modal for the same
			-- click.
			for _, card in ipairs(self.ship_cards) do
				local panel_node = panel_for_card(self, card)

				if card.sell_box and hits(card.sell_box, action) and hits(panel_node, action) then
					local name = ship_display_name(card.item_key, session.get_faction())
					local refund = session.get_ship_sell_refund()
					show_confirm(self, "Sell " .. name .. " for " .. refund .. " Scrip?", function()
						session.sell_ship(card.item_key)
						refresh_ship_cards(self)
						local faction = session.get_faction()
						local home_name, faction_label, ship_name = ship_overview_text(faction)
						gui.set_text(self.ship_node, faction_label .. "  --  " .. ship_name)
					end)
					return true
				end

				if card.box and hits(card.box, action) and hits(panel_node, action) then
					show_ship_detail(self, card.item_key)
					return true
				end
			end
			return false
		end

		-- Fitting tab: type-filter buttons (§2.8.8) - clicking a type narrows
		-- both Shop and Owned to that type; clicking the already-active one
		-- clears the filter back to showing everything. Checked before the
		-- marker/card hit-tests below since it's its own click target, not a
		-- drag source.
		for _, type_name in ipairs(FILTER_TYPE_ORDER) do
			if hits(self.filter_nodes[type_name], action) then
				-- NOTE: deliberately an if/else, not the usual "cond and a or
				-- b" idiom - that idiom breaks when the "true" branch value
				-- is itself nil/false (here, clearing the filter), since
				-- "cond and nil" is always nil, so the "or b" always wins
				-- regardless of cond. Caught by this feature's own test
				-- harness case (clicking an active filter again silently
				-- failed to clear it) before this ever reached a real build.
				if self.type_filter == type_name then
					self.type_filter = nil
				else
					self.type_filter = type_name
				end
				refresh_filter_buttons(self)
				refresh_module_cards(self)
				return true
			end
		end

		-- Fitting tab: start dragging an installed item off its slot marker
		for slot_id, marker in pairs(self.markers) do
			if hits(marker.box, action) then
				local loadout = session.get_loadout() or {}
				for _, entry in ipairs(loadout) do
					if entry.slot == slot_id then
						start_drag(self, "slot", entry.instance_id, slot_id, action)
						update_hover(self, action)
						return true
					end
				end
				return false -- empty slot, nothing to drag
			end
		end
		-- start dragging a module card from either list - a Shop card
		-- carries a catalog item_key (no instance exists until it's
		-- actually dropped, §4), an Owned card carries the specific
		-- instance_id being moved.
		for _, card in ipairs(self.cards) do
			local panel_node = panel_for_card(self, card)

			-- Sell button (Owned spares only, §2.8/§4) - checked before
			-- the card's own drag-start hit so the two don't fire
			-- together (the two nodes overlap on screen: sell_box sits
			-- inside card.box's own full-width footprint).
			if card.sell_box and hits(card.sell_box, action) and hits(panel_node, action) then
				local module = catalog.get(card.item_key)
				local name = module and module.name or card.item_key
				local instance_id = card.instance_id
				local refund = session.get_module_sell_refund()
				show_confirm(self, "Sell " .. name .. " for " .. refund .. " Scrip?", function()
					session.sell(instance_id)
					refresh_module_cards(self)
				end)
				return true
			end

			if card.box and hits(card.box, action) and hits(panel_node, action) then
				local ref = (card.source == "shop") and card.item_key or card.instance_id
				start_drag(self, card.source, ref, nil, action)
				update_hover(self, action)
				return true
			end
		end
		return false
	elseif action.released and self.dragging then
		local drag = self.dragging
		local dropped_on_slot = nil
		for slot_id, marker in pairs(self.markers) do
			if marker.type == drag.type and hits(marker.box, action) then
				dropped_on_slot = slot_id
				break
			end
		end
		if dropped_on_slot then
			-- Any PURCHASE (shop-sourced) or SWAP (displacing whatever's
			-- already installed in dropped_on_slot) needs a confirmation
			-- dialog before it actually happens, per direct instruction.
			-- Plain installs from an Owned/slot source into an EMPTY slot
			-- don't - nothing is being bought or replaced, so those still
			-- apply immediately below. Dropping an item back onto the
			-- exact slot it was just dragged off of doesn't count as a
			-- swap either - nothing would actually change.
			local is_purchase = drag.source == "shop"
			local existing_instance_id = nil
			for _, entry in ipairs(session.get_loadout() or {}) do
				if entry.slot == dropped_on_slot then
					existing_instance_id = entry.instance_id
				end
			end
			local is_swap = existing_instance_id ~= nil
				and not (drag.source == "slot" and drag.from_slot == dropped_on_slot)

			if is_purchase or is_swap then
				local module = catalog.get(drag.item_key)
				local module_name = module and module.name or drag.item_key
				local existing_name
				if is_swap then
					local existing = session.get_instance(existing_instance_id)
					local existing_module = existing and catalog.get(existing.item_key)
					existing_name = existing_module and existing_module.name or "the installed item"
				end
				local price = session.get_module_price()

				local pending_item_key = drag.item_key
				local pending_instance_id = drag.instance_id
				local pending_source = drag.source
				local pending_slot = dropped_on_slot
				end_drag(self) -- ends the drag visually either way; nothing installs until confirmed

				if is_purchase and session.get_scrip() < price then
					show_confirm(self, "Not enough Scrip to buy " .. module_name
						.. " (need " .. price .. ", have " .. session.get_scrip() .. ").", function() end)
					return true
				end

				local message
				if is_purchase and is_swap then
					message = "Buy " .. module_name .. " for " .. price .. " Scrip and swap it into " .. dropped_on_slot
						.. ", replacing " .. existing_name .. "?"
				elseif is_purchase then
					message = "Buy " .. module_name .. " for " .. price .. " Scrip and install it in " .. dropped_on_slot .. "?"
				else
					message = "Swap " .. module_name .. " into " .. dropped_on_slot
						.. ", replacing " .. existing_name .. "?"
				end

				show_confirm(self, message, function()
					local instance_id = pending_instance_id
					if pending_source == "shop" then
						instance_id = session.purchase(pending_item_key)
					end
					if instance_id then
						session.install(pending_slot, instance_id)
					end
					refresh_markers(self)
					refresh_module_cards(self)
				end)
				return true
			end

			session.install(dropped_on_slot, drag.instance_id)
		elseif drag.source == "slot" then
			session.uninstall(drag.from_slot)
		end
		-- otherwise (owned/shop card dropped somewhere invalid): no-op, cancel
		end_drag(self)
		refresh_markers(self)
		refresh_module_cards(self)
		return true
	elseif action.released and self.forsale_press then
		-- Resolves a Ships-For-Sale press (started above, in the "ships"
		-- active_page press handling) as a click only if the cursor never
		-- moved past DRAG_CLICK_THRESHOLD - a real drag-scroll (already
		-- applied live, per motion, in the action_id == nil branch above)
		-- never also opens the ship detail modal on release.
		local press = self.forsale_press
		self.forsale_press = nil
		if not press.dragged and press.item_key then
			show_ship_detail(self, press.item_key)
		end
		return true
	end
	return false
end
