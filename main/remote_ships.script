-- Lives on "network_hub" in main/main.collection. Connects to the local
-- Nakama server, joins the current system's realtime room, and
-- spawns/moves/removes a game object rendering every other connected
-- player's own ship model as their transform updates arrive - the "see
-- each other fly" half of the "Realtime presence only" slice
-- (AskUserQuestion), ported from
-- ~/Defold/SuperShips/main/remote_ships.script (§0).
--
-- Real-mesh rendering (per direct instruction: "allow all players to see
-- other players ships with the respective 3-D models") - main/network.lua's
-- send_transform() payload carries the sender's own main/data/ships.lua
-- chassis id (`ship_id`) and faction; REMOTE_SHIP_PROTOTYPE below maps every
-- (ship_id, faction) combo straight to the SAME .model file
-- main/data/ships.lua's own faction_skins[faction].model already points at
-- for that combo, each wrapped in its own tiny .go under
-- main/remote_ships/ (generated by tools/generate_remote_ship_prototypes.py -
-- re-run it after adding/renaming a ship - one per combo, 24 total, same
-- "one Defold factory per prototype, no runtime mesh-swap" constraint
-- main/main.collection's own 24 pre-embedded player-ship model components
-- work around, just via factories instead of enable/disable since these
-- are other players, not the local one). remote_ship_factory (no suffix,
-- main/remote_ship.go's unit-diameter placeholder sphere) is the fallback
-- for a sender whose ship_id doesn't resolve to a known combo - an older/
-- incompatible client, or a bad/missing ship_id.
--
-- Not ported from the source file: the screen-space faction nameplate over
-- each remote ship (its hud#gui "faction_label" messages, which need a
-- camera-projection lookup this file has no reason to duplicate) - out of
-- scope for this slice.
--
-- main/player_ship.script only broadcasts its transform at
-- NETWORK_SEND_INTERVAL (10Hz - see its own comment), well below the
-- render frame rate, so snapping straight to each new transform on arrival
-- would make remote ships visibly teleport/step between updates. Instead,
-- on_message just records the latest transform as a target, and update()
-- every frame lerps/slerps the rendered transform towards it (same
-- exponential-smoothing shape as player_ship.script's own chase-camera
-- lerp) - smooths out the stepping while still tracking the network data
-- closely. Ported technique from the source file (§0).

local network = require "main.network"
local remote_registry = require "main.remote_registry"
local ships = require "main.data.ships"
local skin_flight = require "main.skin_flight"
local profile = require "main.profile"

-- Same ambient-lighting boost every model this project renders during
-- flight gets (per direct instruction: "increase the general ambient light
-- in all the systems") - see main/player_ship.script's own AMBIENT_TINT for
-- the full explanation. Duplicated here rather than required from that
-- file since it's a plain numeric constant, not shared logic (same
-- precedent main/asteroid_hub.script's own copy already follows).
local AMBIENT_TINT = vmath.vector4(1.4, 1.4, 1.4, 1.0)
-- Same crude stand-in directional-light position main/player_ship.script
-- sets on the LOCAL player's own model component - see that file's own
-- comment on `light` being a world-space point-light position, not a
-- color, on model.material.
local LIGHT_POS = vmath.vector4(4000, 6000, 4000, 1.0)

-- factory.create() defaults to the prototype's unscaled (1,1,1) size
-- otherwise - fine for the 24 real-ship factories below (their .go files
-- point straight at the same .model files main/main.collection's own
-- per-ship components use, already at the right native scale), but
-- main/remote_ship.go's fallback is asteroid.model's unit-diameter sphere,
-- which needs an explicit scale to read as ship-sized at all. Placeholder
-- dimensions (not sourced from any real ship's stats), roughly
-- Patrol-Interceptor-class - only ever seen for a sender with an
-- unrecognized ship_id (see remote_factory_id()'s own comment).
local FALLBACK_SCALE = vmath.vector3(6, 3, 10)

local FACTIONS = { "accord", "swarm" }

local SELF_URL = "main:/network_hub#script"

local ships_by_user = {} -- user_id -> spawned instance id
local target_pos = {}    -- user_id -> latest network-reported position (vmath.vector3)
local target_rot = {}    -- user_id -> latest network-reported rotation (vmath.quat)
local render_pos = {}    -- user_id -> smoothed position actually applied this frame
local render_rot = {}    -- user_id -> smoothed rotation actually applied this frame
local factions = {}      -- user_id -> faction name string
local speeds = {}        -- user_id -> latest network-reported speed (number)
local stale_time = {}    -- user_id -> seconds since that ship's last update
-- Skins (main/skin_flight.lua). Unlike ship type, a skin can change between
-- one flight and the next without the ship leaving the room, so it's
-- re-checked on every update (cheap: only a changed value touches the ship).
local ship_ids = {}      -- user_id -> ship_id the ship was spawned as
local shown_skins = {}   -- user_id -> skin_id currently shown (false = default)
local skin_states = {}   -- user_id -> skin_flight state for that ship

-- Gives a spawned skin model the same material constants as the ship's own.
local function setup_skin_model(model)
	go.set(model, "tint", AMBIENT_TINT)
	go.set(model, "light", LIGHT_POS)
end

-- Dead reckoning (matches main/player_ship.script's NETWORK_* sender):
-- between updates each remote ship's target keeps moving along its reported
-- heading at its reported speed, since senders stay quiet while they fly
-- straight. Stops after EXTRAPOLATE_MAX_TIME without an update (keep-alives
-- arrive every second), so a stalled sender - e.g. a backgrounded browser
-- tab - doesn't coast off into space.
local SHIP_FORWARD = vmath.vector3(0, 0, 1) -- same axis as player_ship.script
local EXTRAPOLATE_MAX_TIME = 2.5

go.property("remote_smoothing_speed", 15.0)

-- "#remote_ship_factory_<ship_id>_<faction>" if that's a known
-- main/data/ships.lua chassis+faction combo (one of the 24 embedded on
-- main/network_hub.go - see this file's header comment), else the generic
-- placeholder fallback.
local function remote_factory_id(ship_id, faction)
	if ship_id and ships.SHIPS[ship_id] and (faction == "accord" or faction == "swarm") then
		return "#remote_ship_factory_" .. ship_id .. "_" .. faction, false
	end
	return "#remote_ship_factory", true
end

-- network.lua's callbacks run from socket events, in the context of
-- whichever script opened the socket - not necessarily this one - so they
-- only msg.post() to SELF_URL, and on_message below does the real work
-- (factory.create(), go.delete()) in this script's own context.
local function on_transform(user_id, t)
	msg.post(SELF_URL, "remote_transform", {
		user_id = user_id,
		x = t.x, y = t.y, z = t.z,
		qx = t.qx, qy = t.qy, qz = t.qz, qw = t.qw,
		faction = t.faction,
		speed = t.speed,
		ship_id = t.ship_id,
		skin_id = t.skin_id,
	})
end

local function on_leave(user_id)
	msg.post(SELF_URL, "remote_leave", { user_id = user_id })
end

function init(self)
	-- No connect() here: main/start_screen.gui_script connects once the player
	-- has logged in and verified their email, and main/player_ship.script
	-- enters each system's match as the player flies there.
	network.set_space_callbacks(on_transform, on_leave)
end

function on_message(self, message_id, message)
	if message_id == hash("remote_transform") then
		local pos = vmath.vector3(message.x, message.y, message.z)
		local rot = vmath.quat(message.qx, message.qy, message.qz, message.qw)

		target_pos[message.user_id] = pos
		target_rot[message.user_id] = rot
		factions[message.user_id] = message.faction or "?"
		speeds[message.user_id] = message.speed or 0
		stale_time[message.user_id] = 0

		if not ships_by_user[message.user_id] then
			-- nothing to smooth from yet - spawn (and start rendering)
			-- directly at the first known transform. Ship type/scale is
			-- spawn-time only, same as the rest of this project's
			-- ship-scaling - a player's ship doesn't change mid-flight, so
			-- there's no need to re-resolve this on every later transform
			-- update the way pos/rot are.
			local factory_id, is_fallback = remote_factory_id(message.ship_id, message.faction)
			local scale = is_fallback and FALLBACK_SCALE or nil
			local ship_go = factory.create(factory_id, pos, rot, nil, scale)
			ships_by_user[message.user_id] = ship_go
			render_pos[message.user_id] = pos
			render_rot[message.user_id] = rot
			go.set(msg.url(nil, ship_go, "model"), "tint", AMBIENT_TINT)
			go.set(msg.url(nil, ship_go, "model"), "light", LIGHT_POS)
			ship_ids[message.user_id] = message.ship_id
			skin_states[message.user_id] = skin_flight.new_state(ship_go, msg.url(nil, ship_go, "model"), setup_skin_model)
		end

		local skin_id = message.skin_id or false
		if shown_skins[message.user_id] ~= skin_id then
			shown_skins[message.user_id] = skin_id
			print("[remote_ships] " .. message.user_id .. " skin: " .. tostring(message.skin_id or "default"))
			skin_flight.show(skin_states[message.user_id], message.skin_id, ship_ids[message.user_id], message.faction)
		end
	elseif message_id == hash("remote_leave") then
		local ship_go = ships_by_user[message.user_id]
		if skin_states[message.user_id] then
			skin_flight.clear(skin_states[message.user_id]) -- a spawned skin model isn't deleted with its parent
		end
		if ship_go then
			go.delete(ship_go)
			ships_by_user[message.user_id] = nil
		end
		target_pos[message.user_id] = nil
		target_rot[message.user_id] = nil
		render_pos[message.user_id] = nil
		render_rot[message.user_id] = nil
		factions[message.user_id] = nil
		speeds[message.user_id] = nil
		stale_time[message.user_id] = nil
		ship_ids[message.user_id] = nil
		shown_skins[message.user_id] = nil
		skin_states[message.user_id] = nil
		remote_registry.ships[message.user_id] = nil
	end
end

function update(self, dt)
	profile.update(dt) -- sends queued progress changes to the server (see main/profile.lua)
	if next(ships_by_user) == nil then
		return
	end

	-- same exponential-smoothing shape as player_ship.script's own
	-- chase-camera lerp: resolution-independent (dt-scaled) and
	-- asymptotically approaches the target rather than overshooting
	local t = 1.0 - math.exp(-self.remote_smoothing_speed * dt)

	for user_id, ship_go in pairs(ships_by_user) do
		stale_time[user_id] = stale_time[user_id] + dt
		if stale_time[user_id] < EXTRAPOLATE_MAX_TIME and speeds[user_id] ~= 0 then
			target_pos[user_id] = target_pos[user_id]
				+ vmath.rotate(target_rot[user_id], SHIP_FORWARD) * speeds[user_id] * dt
		end

		local pos = vmath.lerp(t, render_pos[user_id], target_pos[user_id])
		local rot = vmath.slerp(t, render_rot[user_id], target_rot[user_id])
		go.set_position(pos, ship_go)
		go.set_rotation(rot, ship_go)
		render_pos[user_id] = pos
		render_rot[user_id] = rot

		-- keep the shared registry current for main/player_ship.script's
		-- radar broadcast (main/flight_hud.gui's "contacts") - published
		-- from the smoothed render_pos, not the raw network target, so a
		-- radar dot's tracked position matches what's actually drawn.
		remote_registry.ships[user_id] = { pos = pos, faction = factions[user_id], speed = speeds[user_id] }
	end
end
