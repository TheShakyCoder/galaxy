-- Spawns/despawns the current system's asteroid field
-- (main/data/asteroids.lua's static, deterministic-per-system data) as
-- real, visible world objects - reacts to the "spawn_field" message
-- main/player_ship.script's start_flight() sends. Same "one hub owns
-- spawning" pattern the other local reference project's own
-- main/asteroid_hub.script establishes (§0 - mechanics, not creative
-- expression, reuse is fine). Depletion remains server-authoritative.
--
-- Each asteroid owns a procedural, unit-diameter rock mesh seeded by its
-- system and index. Gameplay positions, radii and resources are unchanged.
--
-- Asteroid Analyser (main/data/modules/computer_modules.lua): the
-- "analyse" message from player_ship.script (P, with the module fitted)
-- scans every asteroid within range - they pulse for the scan time, then
-- turn the colour of what they're made of (main/data/asteroids.lua
-- M.RESOURCES). Only this player's game knows: nothing is sent to the
-- server or other players. What's been analysed is remembered per system
-- until the page is reloaded, so a field looks the same after jumping away
-- and back. SuperShips' Mineral Analysis Module scan block in
-- main/ship.script is the reference (one targeted rock there; everything in
-- range here, per direct instruction).

local asteroids = require("main.data.asteroids")
local asteroid_registry = require("main.asteroid_registry")
local network = require("main.network")
local asteroid_geometry = require("main.asteroid_geometry")
local audio = require("main.audio")

-- Same ambient-lighting boost applied to every model this project renders
-- during flight (per direct instruction: "increase the general ambient
-- light in all the systems") - see main/player_ship.script's own
-- AMBIENT_TINT for the full explanation of what this actually does to
-- model.material's shader and why `tint` is the only real lever.
-- Duplicated here rather than required from that file since it's a plain
-- numeric constant, not shared logic (same "small shared constant,
-- mirrored with a cross-reference comment" precedent DOCK_RANGE already
-- follows elsewhere in this project).
local AMBIENT_TINT = vmath.vector4(1.4, 1.4, 1.4, 1.0)

-- While being analysed, an asteroid pulses between its normal look and
-- this bright cyan, SCAN_PULSE_S per half-cycle.
local SCAN_TINT = vmath.vector4(0.5, 2.2, 2.6, 1.0)
local SCAN_PULSE_S = 0.25

-- How long the result stays on the HUD.
local RESULT_SHOWN_S = 6

-- Spawned asteroids of the current system: { id, pos, radius, resource,
-- index, analysed } (index = position in asteroids.field_for(system_id)).
-- Also published to main/asteroid_registry.lua for targeting.
local spawned = {}
local debris = {} -- visual-only objects, excluded from targeting immediately

-- Audio (this hub owns the two asteroid sounds - a rock breaking up and a
-- scan starting - see update()'s despawn and analyse() below). Both are
-- one-shot components on this game object (main/asteroid_hub.go). The weapon
-- firing sound and the visible tracer are NOT here: they live in their own
-- hub, main/shot_hub.script (on main/shot_hub.go), since cannon/projectile
-- code shouldn't sit alongside the asteroid field (per direct instruction).
--
-- Both sounds are positioned in the world through main/audio.lua (plan.md
-- §2.12): the breakup sound at the rock, the scan sound at the analyser's own
-- slot (the sender passes `origin`). The hub itself has no camera, so it reads
-- the listener main/player_ship.script publishes each frame - pan and gain
-- come out relative to whatever the player is looking through.
local current_system = nil

-- system_id -> { [index] = true } for asteroids this player has analysed.
local analysed = {}

-- The scan in progress, if any: { asteroids = {...}, timer = handle }.
local scan = nil

-- Bumped by every HUD message, so an older "clear the result" timer
-- doesn't hide a newer message.
local status_generation = 0

local function model_url(id)
	return msg.url(nil, id, "model")
end

local function resource_tint(resource_id)
	local c = asteroids.RESOURCE_BY_ID[resource_id].tint
	return vmath.vector4(c[1] * AMBIENT_TINT.x, c[2] * AMBIENT_TINT.y, c[3] * AMBIENT_TINT.z, 1.0)
end

-- Shows `text` on the flight HUD (nil hides it); with `for_s`, hides it
-- again after that long unless something newer was shown.
local function show_status(text, for_s)
	status_generation = status_generation + 1
	local generation = status_generation
	msg.post("flight_hud#gui", "scan_status", { text = text })
	if text and for_s then
		timer.delay(for_s, false, function()
			if generation == status_generation then
				msg.post("flight_hud#gui", "scan_status", { text = nil })
			end
		end)
	end
end

local function cancel_scan()
	if not scan then
		return
	end
	timer.cancel(scan.timer)
	-- Restore each rock that was mid-pulse to its proper colour (analysed
	-- rocks keep their resource tint, the rest go back to ambient) - the
	-- pulse is driven from update() below, so nothing else will.
	local known = analysed[current_system] or {}
	for _, a in ipairs(scan.asteroids) do
		if go.exists(a.id) then
			go.set(model_url(a.id), "tint", known[a.index] and resource_tint(a.resource) or AMBIENT_TINT)
		end
	end
	scan = nil
	show_status(nil)
end

local function despawn_all()
	cancel_scan()
	for _, a in ipairs(spawned) do
		go.delete(a.id)
	end
	spawned = {}
	for _,id in ipairs(debris) do
		if go.exists(id) then go.delete(id) end
	end
	debris = {}
	asteroid_registry.set({})
end

-- Spawns one rock (by its index in the current system's field): its own
-- model at the field's position/size, tinted by what's already been
-- analysed. Used when a field first appears and whenever the server says a
-- depleted asteroid has returned - see update().
local function spawn_rock(index)
	local a = asteroids.field_for(current_system)[index]
	local pos = vmath.vector3(a.x, a.y, a.z)
	local seed = asteroid_geometry.seed(current_system,index)
	local id = factory.create("#asteroid_factory", pos, nil, {seed=seed}, a.diameter_m)
	local known = analysed[current_system] or {}
	go.set(model_url(id), "tint", known[index] and resource_tint(a.resource) or AMBIENT_TINT)
	return { id = id, pos = pos, radius = a.diameter_m / 2, resource = a.resource, index = index, analysed = known[index] == true }
end

local function spawn_field(system_id)
	despawn_all()
	current_system = system_id
	for index = 1, #asteroids.field_for(system_id) do
		local st = network.asteroid_state(system_id,index)
		if not st or st.available then table.insert(spawned, spawn_rock(index)) end
	end
	asteroid_registry.set(spawned)
end

-- "ANALYSED 7 ASTEROIDS: 2 HYDROGEN, 1 IRON, 4 INERT"
local function result_text(found)
	local counts = {}
	for _, a in ipairs(found) do
		counts[a.resource] = (counts[a.resource] or 0) + 1
	end
	local parts = {}
	for _, resource in ipairs(asteroids.RESOURCES) do
		if counts[resource.id] then
			table.insert(parts, counts[resource.id] .. " " .. resource.name:upper())
		end
	end
	local noun = #found == 1 and "ASTEROID" or "ASTEROIDS"
	return string.format("ANALYSED %d %s: %s", #found, noun, table.concat(parts, ", "))
end

local function finish_scan()
	local found = scan.asteroids
	scan = nil
	local known = analysed[current_system] or {}
	analysed[current_system] = known
	for _, a in ipairs(found) do
		if go.exists(a.id) then
			go.set(model_url(a.id), "tint", resource_tint(a.resource))
		end
		known[a.index] = true
		a.analysed = true
	end
	show_status(result_text(found), RESULT_SHOWN_S)
end

-- Starts analysing every asteroid within `range` metres of `pos` (surface
-- distance, so a big rock counts as soon as its edge is in range).
local function do_analyse(pos, range, scan_time, origin)
	if scan then
		return -- one scan at a time; the analyser is busy until it finishes
	end
	local found = {}
	local nearest = nil -- nearest rock surface distance, for the "nothing in range" message
	for _, a in ipairs(spawned) do
		local surface = vmath.length(a.pos - pos) - a.radius
		if surface <= range then
			table.insert(found, a)
		end
		if not nearest or surface < nearest then
			nearest = surface
		end
	end
	if #found == 0 then
		local detail = nearest and string.format(" (nearest %.0f m)", nearest) or " (no asteroids in this system)"
		show_status(string.format("NO ASTEROIDS WITHIN %d m%s", range, detail), 3)
		return
	end
	-- The pulse itself is driven from update() below (one tint write per
	-- scanned rock per frame) rather than go.animate on the model's `tint`
	-- material constant - that call aborted the whole scan at runtime, which
	-- is why the slot showed the scan but no rock ever reacted.
	scan = { asteroids = found, elapsed = 0, timer = timer.delay(scan_time, false, finish_scan) }
	local noun = #found == 1 and "ASTEROID" or "ASTEROIDS"
	show_status(string.format("ANALYSING %d %s...", #found, noun))
	-- Played ONCE, here, not per rock and not looped - per direct instruction
	-- ("scanning audio should run one time only when the asteroid analyser is
	-- activated"). Last and best-effort: a problem playing the sound must
	-- never be able to cancel the scan itself, so it runs only after the scan
	-- is fully set up. Positioned at the analyser's own slot (`origin`, from
	-- player_ship.script) rather than the ship's centre.
	pcall(audio.play, "#scan_sound", origin)
end

-- Runs the scan, but never lets an error abort it silently: a failure is
-- shown on the HUD instead. (Silent aborts are exactly how this looked
-- "broken" before - a throw inside the scan left the slot running with no
-- result and no message anywhere.)
local function analyse(pos, range, scan_time, origin)
	if scan then
		return
	end
	local ok, err = pcall(do_analyse, pos, range, scan_time, origin)
	if not ok then
		show_status("SCAN ERROR: " .. tostring(err), 10)
	end
end

-- Keeps the standing field in step with the server's hull state (OP_ASTEROIDS,
-- main/network.lua asteroid_state): a depleted asteroid leaves the world and
-- the registry, a returned one is spawned again. Only asteroids the server has
-- reported (i.e. not at full hull) are affected - everything else is left as
-- spawned, and a fresh field assumes all present until told otherwise.
function update(self, dt)
	for i = #debris,1,-1 do
		if not go.exists(debris[i]) then table.remove(debris,i) end
	end
	if not current_system then
		return
	end
	local field = asteroids.field_for(current_system)
	local standing = {}
	for _, a in ipairs(spawned) do
		standing[a.index] = a
	end
	local next_spawned = {}
	local changed = false
	for index = 1, #field do
		local st = network.asteroid_state(current_system, index)
		local available = not (st and not st.available)
		local a = standing[index]
		if available then
			if a then
				table.insert(next_spawned, a)
			else
				table.insert(next_spawned, spawn_rock(index))
				changed = true
			end
		elseif a then
			-- The server says this rock is mined out (hp 0, destroyed_until
			-- set): the asteroid breaks up. Play the breakup sound where the
			-- rock was (sound.play() has no position of its own), then take it
			-- out of the world.
			-- Positioned at the rock's own position (per direct instruction: "the
			-- asteroid destruction sound should be localised to the location of
			-- the asteroid") - so a rock mined off to the player's right breaks
			-- up on the right, and one far away fades with distance.
			audio.play("#breakup_sound", a.pos)
			-- Cancel any scan that includes it first: cancel_scan() touches
			-- every rock it found, and this one is about to be deleted.
			cancel_scan()
			go.set(model_url(a.id), "tint", a.analysed and resource_tint(a.resource) or AMBIENT_TINT)
			msg.post(msg.url(nil,a.id,"script"), "disintegrate")
			table.insert(debris,a.id)
			changed = true
		end
	end
	spawned = next_spawned
	if changed then
		asteroid_registry.set(spawned)
	end
	-- Pulse every rock the running scan found: ping-pong between its ambient
	-- tint and the bright cyan SCAN_TINT, SCAN_PULSE_S per half-cycle. Done
	-- with a plain per-frame go.set (the same call spawn_rock uses) so it
	-- can't fail the way go.animate on a material constant did.
	if scan then
		scan.elapsed = scan.elapsed + dt
		local t = 0.5 * (1 + math.sin(scan.elapsed * math.pi / SCAN_PULSE_S))
		local tint = vmath.lerp(t, AMBIENT_TINT, SCAN_TINT)
		for _, a in ipairs(scan.asteroids) do
			if go.exists(a.id) then
				go.set(model_url(a.id), "tint", tint)
			end
		end
	end
end

function final(self)
	despawn_all()
end

function on_message(self, message_id, message)
	if message_id == hash("spawn_field") then
		spawn_field(message.system_id)
	elseif message_id == hash("analyse") then
		analyse(message.position, message.range, message.scan_time, message.origin)
	elseif message_id == hash("analyser_status") then
		-- player_ship.script's own messages (e.g. no analyser fitted)
		show_status(message.text, 3)
	end
end
