name: "asteroid_rock"
tags: "model"
vertex_program: "/assets/models/asteroids/rock.vp"
fragment_program: "/assets/models/asteroids/rock.fp"
vertex_space: VERTEX_SPACE_LOCAL
vertex_constants { name: "mtx_worldview" type: CONSTANT_TYPE_WORLDVIEW }
vertex_constants { name: "mtx_proj" type: CONSTANT_TYPE_PROJECTION }
vertex_constants { name: "mtx_normal" type: CONSTANT_TYPE_NORMAL }
vertex_constants {
  name: "breakup"
  type: CONSTANT_TYPE_USER
  value { x: 0.0 y: 0.0 z: 0.0 w: 0.0 }
}
fragment_constants {
  name: "tint"
  type: CONSTANT_TYPE_USER
  value { x: 1.4 y: 1.4 z: 1.4 w: 1.0 }
}

fragment_constants { name: "analysis" type: CONSTANT_TYPE_USER value { x: 0 y: 0 z: 0 w: 0 } }
samplers { name: "surface" wrap_u: WRAP_MODE_REPEAT wrap_v: WRAP_MODE_REPEAT filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR max_anisotropy: 1.0 }
