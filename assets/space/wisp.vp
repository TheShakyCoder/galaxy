#version 140
in highp vec3 position;
in mediump vec3 normal;
out mediump vec2 uv;
out mediump float visibility;
uniform vs_uniforms { highp mat4 mtx_worldview; highp mat4 mtx_proj; highp vec4 wisp_clock; };
void main() {
    vec4 center=mtx_worldview*vec4(position,1.0);
    float distance_to_eye=length(center.xyz);
    visibility=smoothstep(12.0,35.0,distance_to_eye)*(1.0-smoothstep(95.0,140.0,distance_to_eye));
    visibility*=smoothstep(0.0,1.5,wisp_clock.x-normal.z);
    uv=normal.xy;
    center.xy+=normal.xy*vec2(14.0,6.0);
    gl_Position=mtx_proj*center;
}
