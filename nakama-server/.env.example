# Copy this file to .env (untracked, see .gitignore) and fill in real
# values before deploying anywhere other than localhost.
#
# Postgres password, shared by both the postgres and nakama services (see
# docker-compose.yml's own comment on postgres) - defaults to "localdb"
# if left unset here, fine for local dev only. Postgres itself is never
# published to the host (no `ports:` mapping, only `expose:`), so this
# only really matters once you're deploying somewhere other than
# localhost - set it to something real there rather than relying on the
# default.
POSTGRES_PASSWORD=
