# Copy this file to .env (untracked, see .gitignore) and fill in real
# values before deploying anywhere other than localhost.
#
# Postgres password, shared by both the postgres and nakama services (see
# docker-compose.yml's own comment on postgres) - defaults to "localdb"
# if left unset here, fine for local dev only. Postgres itself is never
# published to the host (no `ports:` mapping, only `expose:`), so this
# only really matters once you're deploying somewhere other than
# localhost - set it to something real there rather than relying on the
# default.
POSTGRES_PASSWORD=

# Sign-in (modules/auth.lua): players sign in with play tokens from the
# website (Laravel). Locally these default to values matching
#   php artisan galaxy:server local --host=nakama.ddev.site --port=443 \
#     --secure --internal-url=http://nakama:7350 \
#     --http-key=local-dev-http-key --secret=local-dev-play-token-secret
# run in the website project. In production, use the secret printed by
# `php artisan galaxy:server <slug> ...` and that slug.
PLAY_TOKEN_SECRET=
SERVER_ID=
# Server-to-server key the website uses for player summaries and account
# deletion (modules/players.lua).
NAKAMA_HTTP_KEY=
